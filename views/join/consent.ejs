<%- include('../partials/header', { title: 'Consent — ' + study.name, user: null }) %>

<div class="max-w-md mx-auto">
  <div class="bg-white sm:rounded-2xl sm:border border-slate-200/70 sm:shadow-card p-6">
    <div class="flex items-center gap-2 text-xs text-slate-400 mb-4">
      <span class="font-semibold text-brand-600">Step 1 of 3</span>
      <span class="flex-1 h-1 rounded-full bg-slate-100 overflow-hidden"><span class="block h-full w-1/3 bg-brand-600"></span></span>
    </div>

    <h1 class="text-lg font-bold text-slate-900 mb-1 flex items-center gap-2">
      <%- icon('shield', 'w-5 h-5 text-brand-500') %> Before you start
    </h1>
    <p class="text-sm text-slate-500 mb-4">Please read this carefully. You'll need to agree before taking part.</p>

    <% if (error) { %>
      <div class="flex items-start gap-2 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl p-3 mb-4">
        <%- icon('warning', 'w-4 h-4 mt-0.5 shrink-0') %><span><%= error %></span>
      </div>
    <% } %>

    <div class="text-sm text-slate-600 bg-slate-50 border border-slate-200 rounded-xl p-4 mb-5 max-h-72 overflow-auto leading-relaxed whitespace-pre-line"><%= consent.body %></div>

    <form method="POST" action="/join/<%= code %>/consent">
      <label class="flex items-start gap-3 text-sm text-slate-700 mb-5 cursor-pointer">
        <input type="checkbox" name="agree" value="1" class="h-4 w-4 mt-0.5 rounded border-slate-300 text-brand-600 focus:ring-brand-400" />
        <span>I have read the above, I understand what taking part involves, and I agree to take part.</span>
      </label>
      <button class="w-full inline-flex items-center justify-center gap-1.5 bg-brand-700 text-white rounded-xl px-5 py-3 text-sm font-semibold hover:bg-brand-600 transition shadow-card">
        I agree — continue <%- icon('arrow-right', 'w-4 h-4') %>
      </button>
    </form>

    <p class="text-[11px] text-slate-400 text-center mt-4">Consent version <%= consent.version %></p>
  </div>
</div>

<%- include('../partials/footer') %>
