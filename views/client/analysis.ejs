<% const query = new URLSearchParams({study:study.id,from,to}).toString(); %><%- include('../partials/client_header',{query}) %>
<div class="report-heading"><div><div class="report-kicker"><%= study.name %></div><h1>Explore the study</h1><p class="report-lead">Compare consumer groups, review change over time and explore approved themes.</p></div></div>
<form class="report-toolbar" method="get"><input name="study" type="hidden" value="<%= study.id %>" /><label>From<input name="from" type="date" value="<%= from %>" /></label><label>To<input name="to" type="date" value="<%= to %>" /></label><label>Segment<select name="segment"><% segments.forEach(s=>{ %><option <%= segment===s?'selected':'' %>><%= s %></option><% }) %></select></label><label><input name="compare" value="1" type="checkbox" /> Compare previous period</label><label>Ask a study question<input name="ask" value="<%= ask %>" placeholder="Compare brands by age" /></label><button class="report-button">Explore</button></form>
<% if(ask){ %><div class="report-notice"><%= queryLabel %>. Answers use supported study calculations.</div><% } %>
<%- include('../partials/research_analytics',{report}) %>
<section class="report-panel"><h2>Brands by <%= segment %></h2><% if(suppress){ %><div class="report-empty">This table includes a group or answer with a small respondent base and cannot be released. Broaden the period or choose a different segment.</div><% }else{ %><div style="overflow:auto" tabindex="0" role="region" aria-label="Scrollable research results"><div tabindex="0" role="region" aria-label="Research table" style="max-width:100%;overflow-x:auto"><table class="report-table"><thead><tr><th>Group</th><th>Respondents</th><th>Answered occasions</th><th>Distribution</th></tr></thead><tbody><% tabs.forEach(c=>{ %><tr><td><%= c.group %></td><td><%= c.base %></td><td><%= c.answered %></td><td><%= c.values.map(v=>v.label+': '+v.n+' ('+v.pct+'%)').join('; ')||'No eligible answers' %></td></tr><% }) %></tbody></table></div></div><% } %><p>Percentages use answered occasions in each group; multiple responses may total over 100%.</p></section>
<% if(comparison){ %><section class="report-panel"><h2>Compared with <%= comparison.from %> – <%= comparison.to %></h2><div tabindex="0" role="region" aria-label="Research table" style="max-width:100%;overflow-x:auto"><table class="report-table"><thead><tr><th>Brand</th><th>Current incidence %</th><th>Previous incidence %</th><th>Change (percentage points)</th></tr></thead><tbody><% comparison.brands.forEach(b=>{ %><tr><td><%= b.brand %></td><td><%= b.current??'—' %></td><td><%= b.previous??'—' %></td><td><%= b.change??'—' %></td></tr><% }) %></tbody></table></div><p>Only brands meeting the minimum respondent base in both periods are shown. These are descriptive changes; no statistical significance is implied.</p></section><% } %>
<section class="report-panel"><h2>Observed brand transitions</h2><p>Consecutive single-brand occasions from the same respondent, within this period. Only transitions meeting the minimum respondent base are shown.</p><div tabindex="0" role="region" aria-label="Brand transitions" style="overflow-x:auto"><table class="report-table"><thead><tr><th>From</th><th>To</th><th>Transitions</th><th>Respondents</th></tr></thead><tbody><% report.analytics.transitions.forEach(t=>{ %><tr><td><%= t.from %></td><td><%= t.to %></td><td><%= t.n %></td><td><%= t.consumers %></td></tr><% }) %></tbody></table></div><% if(!report.analytics.transitions.length){ %><div class="report-empty">No transitions meet the reporting base.</div><% } %></section>
<section class="report-panel"><h2>Reviewed themes</h2><% themes.forEach(t=>{ %><p><%= t.name %> · <%= t.n %> coded occasions</p><% }) %><% if(!themes.length){ %><div class="report-empty">No approved themes meet the reporting base for this period.</div><% } %></section>
</main><footer class="client-footer">INICIO Diary · Research. Insights. Impact.</footer></body></html>
