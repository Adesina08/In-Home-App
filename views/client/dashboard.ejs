<% const query = new URLSearchParams({ study: study.id, from, to }).toString(); %>
<%- include('../partials/client_header', { query }) %>
<div class="report-heading"><div><div class="report-kicker"><%= study.name %></div><h1><%= insights ? 'Insights and media' : 'Study dashboard' %></h1><p class="report-lead"><%= insights ? 'Approved study results and eligible respondent evidence.' : 'A simple view of participation and brand results for the selected period.' %></p></div><% if(grant.exports){ %><a class="report-button secondary" href="/client/export?<%= query %>">Export report CSV</a><% } %></div>
<form class="report-toolbar" method="GET" action="<%= insights ? '/client/insights' : '/client' %>">
  <label>Study<select name="study"><% studies.forEach(s => { %><option value="<%= s.id %>" <%= s.id === study.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
  <label>From<input type="date" name="from" value="<%= from %>" /></label><label>To<input type="date" name="to" value="<%= to %>" /></label>
  <button type="submit" class="report-button">Apply filters</button><a class="report-button secondary" href="<%= insights ? '/client/insights' : '/client' %>?study=<%= study.id %>">Reset dates</a>
</form>
<dl class="report-stats"><% [['Submitted entries',report.submitted,'In the selected period'],['Contributors',report.contributors,'With submitted entries'],['Participation compliance',completionRate===null?'—':completionRate + '%','Completed / expected participation periods'],['Eligible entries',report.eligible,'No open entry-level QC flags']].forEach(([label,value,note]) => { %><div class="report-stat"><dt><%= label %></dt><dd><%= value??'—' %></dd><dd class="report-stat-note"><%= note %></dd></div><% }) %></dl>
<% if(report.suppressed){ %><div class="report-notice">Results are suppressed because fewer than <%= report.minimumBase %> eligible respondents contributed.</div><% } %>
<%- include('../partials/questionnaire_dashboard', { questionnaireDashboard }) %>
<%- include('../partials/report_objectives', { objectiveGroups }) %>
<%- include('../partials/report_dashboard_charts', { report }) %>
<%- include('../partials/report_brand_table', { report }) %>
<% if (!insights) { %>
  <% if (kpis.length) { %><section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Configured measures</div><h2>Study KPIs</h2><p>Calculated from eligible study data for this period.</p></div></div><div class="dashboard-table-scroll"><table class="report-table dashboard-table"><thead><tr><th scope="col">Measure</th><th scope="col">Value</th><th scope="col">Basis</th></tr></thead><tbody><% kpis.forEach(k => { %><tr><th scope="row"><%= k.label %></th><td><%= k.display %></td><td><%= k.basis || (k.kpi_key === 'brand_incidence' ? 'Distinct brand consumers / eligible enrolled respondents' : '—') %></td></tr><% }) %></tbody></table></div></section><% } %>
<% } %>
<section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">From the research team</div><h2>Study summary</h2><p>Saved narrative for the selected period.</p></div><% if (!insights) { %><a class="report-button secondary" href="/client/insights?<%= query %>">Explore insights & media</a><% } %></div>
<% if (insight) { %><span class="report-badge"><%= insight.used_ai_model ? 'AI-generated' : 'Rules-based draft · not AI-written' %></span><div class="report-narrative"><%= insight.narrative %></div><p class="report-muted" style="margin-top:18px">Generated <%= insight.generated_at %> from the reviewed study evidence. Live visuals may change as more data arrives or QC decisions are made.</p><% } else { %><div class="report-empty">The research team has not approved a summary for this date range yet.</div><% } %></section>
<% if (videoInsight) { %><section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">From the research team</div><h2>What respondents showed us on video</h2><p>Scope: <%= videoInsight.video_count %> eligible video<%= videoInsight.video_count === 1 ? '' : 's' %> from <%= videoInsight.respondent_count %> respondent<%= videoInsight.respondent_count === 1 ? '' : 's' %>.</p></div></div>
<% if (videoInsight.reel_ready && grant.media) { %><video controls playsinline preload="metadata" src="/client/video-summary/<%= videoInsight.id %>/reel?study=<%= study.id %>" style="width:100%;max-width:880px;border-radius:10px;background:#000;margin-bottom:16px" aria-label="Video summary highlight reel"></video><% } %>
<% if (videoInsight.coverage) { const c = videoInsight.coverage; %><p class="report-notice">Analysis coverage: <%= c.analysed %> of <%= c.eligible %> videos fully processed; <%= c.partial %> partial, <%= c.failed %> failed, <%= c.unavailable %> unavailable. Relevant evidence came from <%= c.with_evidence %> videos and <%= c.respondents %> respondents. Missing analysis is not a negative response.</p><% } %>
<span class="report-badge"><%= videoInsight.used_ai_model ? 'AI-generated · reviewed by the research team' : 'Reviewed by the research team' %></span><div class="report-narrative"><%= videoInsight.overview %></div>
<% if (videoInsight.points.length) { %><div class="dashboard-table-scroll" style="margin-top:20px"><table class="report-table dashboard-table"><thead><tr><th scope="col">Key point</th><th scope="col">Respondents</th><th scope="col">In their words</th></tr></thead><tbody><% videoInsight.points.forEach(p => { %><tr><th scope="row"><% if (p.question) { %><small class="report-muted"><%= p.question %></small><br /><% } %><%= p.point %></th><td><%= p.respondents %> of <%= p.respondent_base %><br /><small>with evidence for this question</small></td><td><%= p.quote ? '“' + p.quote + '”' : '—' %></td></tr><% }) %></tbody></table></div><% } %>
<% if (videoInsight.brands.length) { %><p class="report-muted" style="margin-top:14px">Brands seen on screen: <%= videoInsight.brands.map(b => b.brand + ' (' + b.respondents + ' respondent' + (b.respondents === 1 ? '' : 's') + ')').join(', ') %></p><% } %>
<p class="report-muted" style="margin-top:14px">Approved <%= videoInsight.approved_at %>.</p></section><% } %>
<% if (insights) { %><%- include('../partials/research_analytics', { report }) %><%- include('../partials/report_visuals', { report }) %><% } %>
<div class="report-notice"><strong>About the data.</strong> Practice entries are excluded. Answer charts, media and word frequencies exclude entries with open QC flags; unconfirmed AI answers are also excluded. <%= report.provenance.respondent ?? '—' %> respondent answers · <%= report.provenance.aiConfirmed ?? '—' %> confirmed AI answers · <%= report.provenance.excluded ?? '—' %> excluded answers in this period.</div>
</main><footer class="client-footer">INICIO Diary · <%= study.name %> · Research. Insights. Impact.</footer></body></html>
