<% const query = new URLSearchParams({ study: study.id, from, to }).toString(); %>
<%- include('../partials/client_header', { query }) %>
<div class="report-heading"><div><div class="report-kicker"><%= study.market || 'Study reporting' %> / <%= study.category || 'Consumption research' %></div><h1><%= insights ? 'Closer to everyday life.' : study.name %></h1><p class="report-lead"><%= insights ? 'Explore the study story through respondent language, photos and recordings.' : 'A clear view of participation, consumption and the moments behind your study.' %></p></div><a class="report-button secondary" href="/client/export?<%= query %>">Export report CSV</a></div>
<form class="report-toolbar" method="GET" action="<%= insights ? '/client/insights' : '/client' %>">
  <label>Study<select name="study"><% studies.forEach(s => { %><option value="<%= s.id %>" <%= s.id === study.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
  <label>From<input type="date" name="from" value="<%= from %>" /></label><label>To<input type="date" name="to" value="<%= to %>" /></label>
  <button type="submit" class="report-button">Apply filters</button><a class="report-button secondary" href="<%= insights ? '/client/insights' : '/client' %>?study=<%= study.id %>">Reset dates</a>
</form>
<dl class="report-stats"><% [['Submitted entries',report.submitted,'In the selected period'],['Contributors',report.contributors,'With submitted entries'],['Completion',completionRate + '%','Submitted / all period entries'],['Eligible entries',report.eligible,'No open entry-level QC flags']].forEach(([label,value,note]) => { %><div class="report-stat"><dt><%= label %></dt><dd><%= value %></dd><dd class="report-stat-note"><%= note %></dd></div><% }) %></dl>
<% if (!insights) { %>
  <% if (kpis.length) { %><section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Your research measures</div><h2>Study KPIs</h2><p>Questionnaire measures use eligible period entries. Active respondents reflect current enrollment. Weekly averages use the selected dates, or the first to last submission when dates are blank.</p></div></div><dl class="report-stats" style="margin-bottom:0"><% kpis.forEach(k => { %><div class="report-stat"><dt><%= k.label %></dt><dd><%= k.display %></dd><% if (k.basis) { %><dd class="report-stat-note"><%= k.basis %></dd><% } %><% if (k.kpi_key === 'brand_incidence') { %><dd class="report-stat-note">Distinct brand answers</dd><% } %></div><% }) %></dl></section><% } %>
  <div class="report-two"><section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Fieldwork pulse</div><h2>Entries over time</h2><p>Submitted entries by day in this period.</p></div><span class="report-badge"><%= active %> currently active</span></div>
  <% if(report.trend.length) { const max = Math.max(...report.trend.map(t => t.n)); %><div class="report-trend" aria-hidden="true"><% report.trend.forEach(t => { %><div title="<%= t.day %>: <%= t.n %> entries"><span style="height:<%= t.n / max * 100 %>%"></span></div><% }) %></div><div class="report-trend-label"><span><%= report.trend[0].day %></span><span><%= report.trend.at(-1).day %></span></div><details><summary>View daily counts</summary><table class="report-table"><thead><tr><th>Date</th><th>Submitted entries</th></tr></thead><tbody><% report.trend.forEach(t => { %><tr><td><%= t.day %></td><td><%= t.n %></td></tr><% }) %></tbody></table></details><% } else { %><div class="report-empty">No submitted entries in this period.</div><% } %>
  </section><section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Consumption patterns</div><h2>Brands mentioned</h2><p>Eligible answer counts, excluding unresolved QC flags and unconfirmed AI answers.</p></div></div><%- include('../partials/report_bars', { items: report.brands, empty: 'No eligible brand answers in this period.' }) %></section></div>
<% } %>
<section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">From the research team</div><h2>Study summary</h2><p>Saved narrative for the selected period.</p></div><% if (!insights) { %><a class="report-button secondary" href="/client/insights?<%= query %>">Explore insights & media</a><% } %></div>
<% if (insight) { %><span class="report-badge"><%= insight.used_ai_model ? 'AI-generated' : 'Rules-based draft · not AI-written' %></span><div class="report-narrative"><%= insight.narrative %></div><p class="report-muted" style="margin-top:18px">Generated <%= insight.generated_at %> from <%= insight.base_records %> submitted entries. Live visuals may change as more data arrives or QC decisions are made.</p><% } else { %><div class="report-empty">The research team has not generated a summary for this date range yet.</div><% } %></section>
<% if (insights) { %><%- include('../partials/report_visuals', { report }) %><% } %>
<div class="report-notice"><strong>About the data.</strong> Practice entries are excluded. Answer charts, media and word frequencies exclude entries with open QC flags; unconfirmed AI answers are also excluded. <%= report.provenance.respondent %> respondent answers · <%= report.provenance.aiConfirmed %> confirmed AI answers · <%= report.provenance.excluded %> excluded answers in this period.</div>
</main><footer class="client-footer">Inicio Diary · <%= study.name %> · Research. Insights. Impact.</footer></body></html>
