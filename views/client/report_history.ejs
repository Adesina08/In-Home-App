<% const query=new URLSearchParams({study:study.id,from,to}).toString(); %><%- include('../partials/client_header',{query}) %>
<div class="report-heading"><div><div class="report-kicker"><%= study.name %></div><h1>Approved reports</h1><p class="report-lead">Saved results reviewed by the research team. Each report keeps the calculation snapshot from its generation date.</p></div><% if(grant.exports){ %><button class="report-button secondary" onclick="window.print()">Print / save as PDF</button><% } %></div>
<% snapshots.forEach(s=>{ %><section class="report-panel"><div class="report-panel-head"><div><h2><%= s.period_start||'Study start' %> – <%= s.period_end||s.created_at.slice(0,10) %></h2><p>Generated <%= s.created_at %> · approved <%= s.approved_at %></p></div><span class="report-badge">Approved</span></div><%- include('../partials/research_analytics',{report:s.payload}) %></section><% }) %><% if(!snapshots.length){ %><div class="report-empty">No approved snapshots meet the client reporting base yet.</div><% } %>
</main><footer class="client-footer">INICIO Diary · Research. Insights. Impact.</footer><style>@media print{.client-top,.report-button,.client-footer{display:none}.client-main{padding:0}.report-panel{break-inside:avoid}}</style></body></html>
