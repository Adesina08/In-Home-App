<!DOCTYPE html>
<html lang="en" data-default-theme="<%= typeof defaultTheme !== 'undefined' ? defaultTheme : (typeof fieldMode !== 'undefined' && fieldMode ? 'dark' : 'light') %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= typeof title !== 'undefined' ? title : 'Inicio Diary' %></title>
  <link rel="stylesheet" href="/public/tailwind.css" />
  <link rel="icon" href="/public/icons/icon-192.png" />
  <meta name="theme-color" content="#1F3864" />
  <script>
    // Respondents now install the native Inicio Diary APK. Retire any old
    // browser-installed PWA/service-worker state left from earlier pilot builds
    // so public /join and /invite links stay in the browser onboarding flow.
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.getRegistrations()
          .then(function (regs) { return Promise.all(regs.map(function (reg) { return reg.unregister(); })); })
          .catch(function () {});
        if (window.caches && caches.keys) {
          caches.keys()
            .then(function (keys) { return Promise.all(keys.map(function (key) { return caches.delete(key); })); })
            .catch(function () {});
        }
      });
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script>
    // Applied before first paint, deliberately inline and render-blocking.
    // Loading this with the rest of the JS produces a white flash on a dark
    // screen every single time -- which on a diary opened daily for three
    // weeks is the most-seen bug in the product.
    (function () {
      try {
        var saved = localStorage.getItem('inicio-theme');
        var wantsDark = saved
          ? saved === 'dark'
          : (document.documentElement.dataset.defaultTheme === 'dark');
        if (wantsDark) document.documentElement.classList.add('dark');
      } catch (e) {}
    })();
  </script>
  <style>
    /* display=swap so a slow connection shows Segoe UI immediately rather than
       invisible text -- these screens are used on mobile data in the field. */
    /* Theme-aware, not a fixed colour. Hardcoding the paper background here is
       what made the dark theme apply to every element EXCEPT the page itself --
       white text on a white page. */
    body[data-field="1"] { background: #FAF9F7; color: #0F172A; }

    /* :where() gives the ".dark" trigger ZERO specificity, so this rule only
       supplies a DEFAULT background/text colour for the page -- it no longer
       outranks an explicit utility class the way a plain `html.dark body {...}`
       selector does (html + .dark + body = a higher specificity than a single
       class like `.text-slate-700`). That plain form is what made every label
       and option on pages with no dark: styling of their own -- the pre-survey
       and the About You dropdowns -- render near-white text on their still-white
       cards the moment dark mode was on anywhere in the app. */
    html:where(.dark) body { background: #0A1628; color: #F8FAFC; }

    /* Tailwind's preflight sets color:inherit on every form control so authors
       must style them explicitly. None of the light-styled forms in this app
       do (they only set border/background), so those controls were inheriting
       the dark page colour above regardless of the :where() fix -- the actual
       "typed text disappears" and "selected option text disappears" bug.
       Declared after the compiled Tailwind stylesheet, so for equal-specificity
       ties this simply wins; any page that DOES want its own colour on a
       control still overrides this with its own class as normal. */
    input, textarea, select { color: #0F172A; }
    body { font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif; }
    .badge-green { background:#E6F4EA; color:#1E7E34; }
    .badge-amber { background:#FFF4E5; color:#B8860B; }
    .badge-red { background:#FCE8E6; color:#C0392B; }
  </style>
</head>
<body data-field="<%= typeof fieldMode !== 'undefined' && fieldMode ? '1' : '' %>" class="bg-slate-50 min-h-screen text-slate-800 antialiased">
<%# One floating, theme-neutral toggle for pages that don't have their own
    top-right control (onboarding, mobile sign-in) -- gated behind a flag
    rather than shown everywhere, so it never doubles up with the in-flow
    toggles already built into the respondent app's Diary/Activity/Profile
    tabs. Both icons render; CSS shows the one matching the current theme, so
    there is nothing for JS to keep in sync. %>
<% if (typeof showThemeToggle !== 'undefined' && showThemeToggle) { %>
  <button type="button" data-theme-toggle aria-pressed="false" aria-label="Toggle dark mode"
    style="position:fixed;top:calc(env(safe-area-inset-top,0px) + 14px);right:14px;z-index:60;width:40px;height:40px;border-radius:9999px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(15,23,42,.12);background:rgba(255,255,255,.92);box-shadow:0 1px 4px rgba(15,23,42,.15)">
    <span class="fab-sun" style="color:#1D4ED8;display:flex"><%- icon('sun', 'w-5 h-5') %></span>
    <span class="fab-moon" style="color:#1D4ED8;display:none"><%- icon('moon', 'w-5 h-5') %></span>
  </button>
  <style>
    html.dark .fab-sun { display: none !important; }
    html.dark .fab-moon { display: flex !important; }
  </style>
<% } %>

<% if (typeof user !== 'undefined' && user) {
  const adminLinks = [ ['/admin','Dashboard','home'], ['/admin/studies','Studies','clipboard'], ['/admin/panel','Respondent Panel','users'], ['/admin/qc','QC Worklist','shield'], ['/admin/ai-summary','AI Summary','trend'], ['/admin/whatsapp-outbox','Message Log','chat'], ['/admin/users','Users','users'] ];
  const navFor = {
    superadmin: [ ['/admin/superadmin','Control Center','shield'], ['/admin/system-settings','System Settings','settings'], ...adminLinks ],
    admin: adminLinks,
    interviewer: [ ['/interviewer','My Respondents','users'], ['/interviewer/register','Register','plus'] ],
    client: [ ['/client','Client Dashboard','chart-bar'] ],
  };
  const links = navFor[user.role] || [];
  const path = typeof currentPath !== 'undefined' ? currentPath : '';
  const initials = (user.name || '?').split(' ').map(w => w[0]).slice(0,2).join('').toUpperCase();
%>
<div class="flex min-h-screen">
  <%# Fixed dark nav rail -- not tied to the light/dark toggle. Every W_* comp
      keeps this sidebar the same near-black regardless of the rest of the
      page, so it is a permanent brand surface, not a `dark:` variant. %>
  <aside class="w-56 shrink-0 bg-[#0B1220] text-[#8291A6] flex flex-col p-3">
    <div class="flex items-center gap-2.5 px-2 pb-5 pt-0.5">
      <div class="w-[26px] h-[26px] rounded-lg bg-signal text-white flex items-center justify-center shrink-0"><%- icon('book', 'w-[15px] h-[15px]') %></div>
      <div class="font-display font-bold text-[14.5px] text-white tracking-tight leading-none">Inicio Diary</div>
    </div>
    <nav class="flex flex-col gap-0.5">
      <% links.forEach(([href, label, ic]) => {
        const active = path === href || (href !== '/admin' && href !== '/interviewer' && href !== '/client' && path.startsWith(href));
      %>
        <a href="<%= href %>" class="flex items-center gap-2.5 px-3 py-2.5 rounded-[9px] text-[13px] font-semibold transition <%= active ? 'bg-white/[0.08] text-white shadow-[inset_3px_0_0_0_#3B82F6]' : 'text-[#8291A6] hover:bg-white/5 hover:text-white' %>">
          <%- icon(ic, 'w-[18px] h-[18px]') %><%= label %>
        </a>
      <% }) %>
    </nav>
    <a href="/help" class="mt-auto flex items-center gap-2.5 px-3 py-2.5 rounded-[9px] text-[13px] font-semibold transition <%= path === '/help' ? 'bg-white/[0.08] text-white shadow-[inset_3px_0_0_0_#3B82F6]' : 'text-[#8291A6] hover:bg-white/5 hover:text-white' %>">
      <%- icon('help', 'w-[18px] h-[18px]') %>Help
    </a>
  </aside>

  <div class="flex-1 min-w-0 flex flex-col">
    <div class="h-[58px] shrink-0 bg-white border-b border-slate-200 flex items-center justify-between px-6 gap-4">
      <div class="min-w-0">
        <% if (typeof studyPicker !== 'undefined' && studyPicker) { %>
          <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-[10px] pl-3 pr-2 py-[7px] text-[13px] font-semibold text-slate-700 relative">
            <select onchange="window.location='<%= studyPicker.action %>'+this.value" class="appearance-none bg-transparent pr-5 outline-none cursor-pointer max-w-[280px] truncate">
              <% studyPicker.studies.forEach(function (s) { %>
                <option value="<%= s.id %>" <%= s.id === studyPicker.current ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
            <span class="pointer-events-none absolute right-3 text-slate-400"><%- icon('chevron-down', 'w-3.5 h-3.5') %></span>
          </div>
        <% } %>
      </div>
      <div class="flex items-center gap-3.5 shrink-0">
        <div class="w-[30px] h-[30px] rounded-full bg-violet-100 text-violet-700 flex items-center justify-center text-[11.5px] font-bold shrink-0"><%= initials %></div>
        <div class="leading-tight hidden sm:block">
          <div class="text-[12.5px] font-bold text-slate-900"><%= user.name %></div>
          <span class="inline-block bg-slate-100 text-slate-500 text-[10px] font-bold uppercase tracking-wide px-2 py-[1px] rounded-full mt-0.5"><%= user.role %></span>
        </div>
        <a href="/logout" title="Log out" class="w-8 h-8 rounded-[9px] border border-slate-200 flex items-center justify-center text-slate-500 hover:bg-slate-50 shrink-0">
          <%- icon('logout', 'w-4 h-4') %>
        </a>
      </div>
    </div>
    <main class="flex-1 min-h-0 overflow-y-auto px-7 py-[22px] flex flex-col gap-3.5">
<% } else { %>
<main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
<% } %>
