<%
/*
  Shared page header for every console page: eyebrow + title + subtitle on
  the left, action buttons on the right. Locals:
    eyebrow   - small uppercase label above the title (e.g. "Admin")
    title     - page title
    subtitle  - one-line description under the title (optional)
    actions   - pre-rendered HTML string for buttons on the right (optional)
  Kept as one partial so every page's header stays visually identical
  without copy-pasting the markup two dozen times.
*/
%>
<div class="console-page-header flex items-start justify-between gap-4 flex-wrap shrink-0">
  <div class="min-w-0">
    <% if (typeof eyebrow !== 'undefined' && eyebrow) { %>
      <div class="text-[11px] font-bold text-signal uppercase tracking-wide mb-0.5"><%= eyebrow %></div>
    <% } %>
    <h1 class="font-display text-[23px] font-extrabold text-slate-900 m-0 tracking-tight"><%= title %></h1>
    <% if (typeof subtitle !== 'undefined' && subtitle) { %>
      <p class="text-slate-500 text-[13px] mt-[3px]"><%= subtitle %></p>
    <% } %>
  </div>
  <% if (typeof actions !== 'undefined' && actions) { %>
    <div class="flex gap-2 shrink-0"><%- actions %></div>
  <% } %>
</div>
