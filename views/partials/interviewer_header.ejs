<% const fieldPath = typeof currentPath !== 'undefined' ? currentPath : '/interviewer'; const registering = fieldPath.includes('/register'); const inviting = fieldPath.includes('/bulk-invite'); %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#35549c" /><title><%= title %> — Inicio Diary</title><link rel="icon" href="/public/icons/icon-192.png" /><link rel="stylesheet" href="/public/tailwind.css" /><link rel="stylesheet" href="/public/reports.css" /><link rel="stylesheet" href="/public/interviewer.css" /><script src="/public/js/interviewer.js" defer></script></head>
<body class="interviewer-page"><a class="field-skip" href="#field-main">Skip to content</a>
<header class="field-top"><a class="field-brand" href="/interviewer"><img src="/public/icons/logo-header.png" alt="" /><span>Inicio Diary<small>Interviewer portal</small></span></a><div class="field-user"><span><%= user.name || user.email %></span><a href="/logout">Sign out</a></div></header>
<div class="field-layout"><aside class="field-sidebar"><div class="field-nav-label">Fieldwork</div><nav aria-label="Interviewer navigation"><a href="/interviewer" <%- !registering && !inviting ? 'aria-current="page"' : '' %>><%- icon('users','w-5 h-5') %> My respondents</a><a href="/interviewer/register" <%- registering ? 'aria-current="page"' : '' %>><%- icon('plus','w-5 h-5') %> Register respondent</a><a href="/interviewer#invite-groups" <%- inviting ? 'aria-current="page"' : '' %>><%- icon('upload','w-5 h-5') %> Group invitations</a></nav><div class="field-sidebar-note"><span>Every introduction matters.</span><p>Explain the study, capture consent and help each respondent get started on their own phone.</p></div></aside>
<main id="field-main" class="field-main report-page">
