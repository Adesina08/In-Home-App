<link rel="stylesheet" href="/public/reports.css"><link rel="stylesheet" href="/public/analysis.css">
<% const a=analysis; const analysisQuery=new URLSearchParams({study:study.id,from:a.from,to:a.to,question:a.question,segment:a.segment}).toString(); const chartData={distribution:a.distribution.slice(0,12),trend:a.trend,modes:a.modes}; %>
<section id="analysis" class="report-page analysis-page mt-8">
  <div class="report-heading"><div><div class="report-kicker">Fieldwork & Analysis</div><h1>Turn occasions into understanding.</h1><p class="report-lead">Operational performance, response patterns and the people behind them in one workspace.</p></div><span class="report-badge">Staff analysis</span></div>
  <form class="report-toolbar analysis-filters" action="/admin#analysis" method="get"><label>Study<select name="study"><% studies.forEach(item=>{ %><option value="<%= item.id %>" <%= item.id===study.id?'selected':'' %>><%= item.name %></option><% }) %></select></label><label>From<input type="date" name="from" value="<%= a.from %>"></label><label>To<input type="date" name="to" value="<%= a.to %>"></label><label class="analysis-question">Question<select name="question"><option value="">Automatic question</option><% a.questions.forEach(q=>{ %><option value="<%= q.code %>" <%= q.code===a.question?'selected':'' %>><%= q.text %></option><% }) %></select></label><label>Compare by<select name="segment"><% Object.entries(a.segments).forEach(([key,label])=>{ %><option value="<%= key %>" <%= key===a.segment?'selected':'' %>><%= label %></option><% }) %></select></label><button class="report-button">Apply</button></form>
  <dl class="report-stats"><% [['Eligible occasions',a.report.eligible],['Enrolled respondents',a.report.respondents.length],['Answered occasions',a.answered],['Answering respondents',a.answerContributors]].forEach(([label,value])=>{ %><div class="report-stat"><dt><%= label %></dt><dd><%= value %></dd></div><% }) %></dl>
  <div class="report-two analysis-charts"><section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Response distribution</div><h2><%= a.questionLabel %></h2></div></div><% if(a.distribution.length){ %><div class="analysis-canvas"><canvas id="response-chart"></canvas></div><% }else{ %><div class="report-empty">No eligible answers for this selection.</div><% } %></section><section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Diary rhythm</div><h2>Occasions over time</h2></div></div><% if(a.trend.length){ %><div class="analysis-canvas"><canvas id="trend-chart"></canvas></div><% }else{ %><div class="report-empty">No eligible diary occasions in this period.</div><% } %></section></div>
  <section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Compare consumer groups</div><h2>Crosstab · <%= a.segments[a.segment] %></h2><p><%= a.questionLabel %></p></div><a class="report-button secondary" href="/admin/analysis/export?<%= analysisQuery %>">Download CSV</a></div><% if(a.distribution.length){ %><div class="analysis-scroll"><table class="report-table analysis-matrix"><thead><tr><th><%= a.segments[a.segment] %></th><th>People</th><th>Occasions</th><% a.distribution.forEach(d=>{ %><th><%= d.label %></th><% }) %></tr></thead><tbody><% a.crosstab.forEach(group=>{ %><tr><th><%= group.label %><% if(group.lowBase){ %><small class="analysis-low-base">Low base</small><% } %></th><td><%= group.respondents %></td><td><%= group.answered %></td><% group.cells.forEach(cell=>{ %><td style="background:rgba(75,144,204,<%= cell.pct===null?0:0.04+cell.pct/100*.25 %>)"><%= cell.pct===null?'—':cell.pct+'%' %></td><% }) %></tr><% }) %></tbody></table></div><% }else{ %><div class="report-empty">No values have been estimated.</div><% } %></section>
  <div class="report-two"><section class="report-panel"><div class="report-kicker">Ways of recording</div><h2>Entry methods</h2><% if(a.modes.length){ %><div class="analysis-canvas analysis-donut"><canvas id="mode-chart"></canvas></div><% }else{ %><div class="report-empty">No eligible entry methods to show.</div><% } %></section><section class="report-panel"><div class="report-kicker">Continue the review</div><h2>Evidence and narrative</h2><div class="analysis-links"><a href="/admin/ai-summary?study=<%= study.id %>&from=<%= a.from %>&to=<%= a.to %>"><strong>Azure AI Summary & media →</strong><span>Review the generated story, word cloud and respondent recordings.</span></a><a href="/admin/qc?study=<%= study.id %>"><strong>Quality control →</strong><span>Review excluded and flagged entries.</span></a></div></section></div>
  <%- include('research_analytics',{report:a.report}) %>
  <div class="report-two">
    <section class="report-panel"><div class="report-kicker">Qualitative coding</div><h2>Reviewed themes</h2><form method="post" action="/admin/studies/<%= study.id %>/research/theme" class="report-toolbar"><label>Theme name<input name="name" required placeholder="e.g. Convenience" /></label><button class="report-button">Create theme</button></form><form method="post" action="/admin/studies/<%= study.id %>/research/code-theme" class="report-toolbar"><label>Record ID<input name="record_id" type="number" required /></label><label>Theme<select name="theme_id" required><option value="">Choose…</option><% operations.themeCodes.forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></label><button class="report-button secondary">Approve coding</button></form><% if(!operations.themeCodes.length){ %><div class="report-empty">No themes created yet.</div><% } %></section>
    <section class="report-panel"><div class="report-kicker">Reproducible reporting</div><h2>Snapshots & schedules</h2><form method="post" action="/admin/studies/<%= study.id %>/research/snapshot" class="report-toolbar"><label>From<input name="from" type="date" /></label><label>To<input name="to" type="date" /></label><button class="report-button">Save snapshot</button></form><details><summary>Schedule recurring reports</summary><form method="post" action="/admin/studies/<%= study.id %>/research/schedule" class="report-toolbar mt-3"><label>First run<input name="next_run" type="date" required /></label><label>Every days<input name="interval_days" type="number" min="1" required /></label><label>Look back days<input name="lookback_days" type="number" min="1" required /></label><label>Alert below %<input name="compliance_below" type="number" min="0" max="100" required /></label><button class="report-button">Create</button></form></details><p class="mt-3 text-xs text-slate-500"><%= operations.reportSnapshots.length %> snapshots · <%= operations.reportSchedules.filter(function(s){return s.enabled;}).length %> active schedules</p><form method="post" action="/admin/studies/<%= study.id %>/research/run-jobs"><button class="report-button secondary">Run due reports</button></form></section>
  </div>
</section>
<script id="analysis-data" type="application/json"><%- JSON.stringify(chartData).replace(/</g,'\\u003c') %></script><script src="/public/vendor/chart.umd.js" defer></script><script src="/public/js/analysis.js" defer></script>
