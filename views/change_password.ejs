<%- include('partials/header', { title: 'Set your password — Inicio Diary', user: null }) %>

<%# Reached only with must_change_password set, i.e. straight after signing in
    with a temporary password an admin generated. There is no way past it: a
    credential two people know is not a password. %>

<div class="min-h-[70vh] flex items-center justify-center">
  <div class="w-full max-w-md bg-white rounded-3xl border border-slate-200/70 shadow-pop p-8 sm:p-9">
    <img src="/public/icons/logo-header.png" alt="Inicio Diary" class="h-9 w-auto mb-7" />

    <h1 class="font-display text-[22px] font-bold text-slate-900 tracking-tight mb-2">Set your own password</h1>
    <p class="text-sm text-slate-600 leading-relaxed mb-6">
      You signed in with a temporary password. Pick your own now &mdash; the temporary
      one stops working as soon as you do.
    </p>

    <% if (error) { %>
      <div class="flex items-start gap-2 bg-red-50 text-red-700 text-sm rounded-xl p-3 mb-4 border border-red-100">
        <%- icon('warning', 'w-4 h-4 mt-0.5 shrink-0') %><span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/change-password" class="space-y-4">
      <div>
        <label for="pw" class="block text-sm font-medium text-slate-600 mb-1.5">New password</label>
        <div class="relative">
          <input id="pw" name="password" type="password" required minlength="8" autofocus autocomplete="new-password"
            class="w-full border border-slate-300 rounded-xl px-3.5 py-3 pr-16 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition" />
          <button type="button" id="pwToggle" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-medium text-slate-500 hover:text-slate-700">Show</button>
        </div>
        <%# Stated up front, not after a rejected attempt. %>
        <p class="text-xs text-slate-400 mt-1.5">At least 8 characters.</p>
      </div>
      <div>
        <label for="pw2" class="block text-sm font-medium text-slate-600 mb-1.5">Type it again</label>
        <input id="pw2" name="confirm" type="password" required minlength="8" autocomplete="new-password"
          class="w-full border border-slate-300 rounded-xl px-3.5 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition" />
      </div>
      <button type="submit"
        class="w-full inline-flex items-center justify-center gap-2 bg-brand-700 text-white rounded-xl py-3 font-semibold text-sm hover:bg-brand-600 transition shadow-card">
        Save and continue <%- icon('arrow-right', 'w-4 h-4') %>
      </button>
    </form>
  </div>
</div>

<script>
  (function () {
    var t = document.getElementById('pwToggle'), p = document.getElementById('pw');
    if (!t || !p) return;
    t.addEventListener('click', function () {
      var show = p.type === 'password';
      p.type = show ? 'text' : 'password';
      t.textContent = show ? 'Hide' : 'Show';
    });
  })();
</script>

<%- include('partials/footer') %>
