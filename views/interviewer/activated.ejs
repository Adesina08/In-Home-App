<%- include('../partials/interviewer_header', { title: 'Respondent registered', currentPath: '/interviewer/register' }) %>
<div class="field-result"><a class="field-back" href="/interviewer">← Back to my respondents</a><section class="report-panel"><div class="field-result-mark"><%- icon('check-circle','w-7 h-7') %></div><div class="report-kicker">Registration saved</div><h1>Ready for the handover.</h1><p class="report-lead">Respondent <strong><%= code %></strong> is activated. Help them continue on their own phone using the personal link below.</p>
<div class="field-handover"><div class="field-qr"><% if(qr) { %><img src="<%= qr %>" alt="QR code for the respondent’s personal link" width="240" height="240" /><% } else { %><p>QR code unavailable. Copy the personal link instead.</p><% } %><p>Scan with the respondent’s phone.</p></div><div><h2>Their personal link</h2><div class="field-link" id="diary-link"><%= diaryUrl %></div><button type="button" class="report-button secondary" data-copy-link="diary-link">Copy link</button><p class="field-copy-status" data-copy-status role="status"></p><p class="report-muted">They can complete any remaining setup after opening the link. No invitation message was sent by this registration.</p></div></div>
<div class="field-submit" style="margin-top:26px"><a class="report-button" href="/interviewer/respondents/<%= respondentId %>">Handover details</a><a class="report-button secondary" href="/interviewer/register">Register another respondent</a></div></section></div>
<%- include('../partials/interviewer_footer') %>
