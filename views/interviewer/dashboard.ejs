<%- include('../partials/header', { title: 'My Respondents — INICIO', user }) %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <div class="text-xs font-semibold text-brand-500 uppercase tracking-wide mb-0.5">Fieldwork</div>
    <h1 class="text-2xl font-bold text-slate-900">My Respondents (F2F)</h1>
    <p class="text-slate-500 text-sm mt-1">Respondents you've screened, consented and registered in the field.</p>
  </div>
  <div class="flex gap-2">
    <a href="/interviewer/register" class="inline-flex items-center gap-1.5 bg-brand-700 text-white rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-brand-600 transition shadow-card">
      <%- icon('plus', 'w-4 h-4') %> Register Respondent
    </a>
  </div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card hover:shadow-card-hover transition">
    <div class="flex items-center gap-2 text-slate-500 text-xs uppercase tracking-wide font-semibold">
      <span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center"><%- icon('users', 'w-4 h-4') %></span>
      Registered
    </div>
    <div class="text-3xl font-bold text-slate-900 mt-3"><%= mine.length %></div>
  </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card">
  <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2"><%- icon('clipboard', 'w-4 h-4 text-brand-500') %> Respondent Roster</div>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="text-left text-slate-400 text-xs uppercase tracking-wide"><th class="pb-2">Code</th><th class="pb-2">Name</th><th class="pb-2">Study</th><th class="pb-2">Status</th><th class="pb-2">Diary Link</th></tr></thead>
    <tbody>
    <% mine.forEach(r => { %>
      <tr class="border-t border-slate-100 hover:bg-slate-50/70">
        <td class="py-2.5 font-mono text-xs text-slate-500"><%= r.respondent_code %></td>
        <td class="py-2.5 font-medium text-slate-700"><%= r.name %></td>
        <td class="py-2.5 text-slate-500 text-xs"><%= r.study_name %></td>
        <td class="py-2.5">
          <span class="text-xs px-2.5 py-1 rounded-full font-medium capitalize <%= ['active','activated','completed'].includes(r.activation_status) ? 'badge-green' : ['invited','screened','registered'].includes(r.activation_status) ? 'badge-amber' : 'bg-slate-100 text-slate-600' %>"><%= r.activation_status %></span>
        </td>
        <td class="py-2.5"><a class="inline-flex items-center gap-1 text-brand-600 hover:underline text-xs font-medium" href="/r/<%= r.unique_token %>" target="_blank"><%- icon('eye', 'w-3.5 h-3.5') %> Open</a></td>
      </tr>
    <% }) %>
    <% if (!mine.length) { %><tr><td colspan="5" class="py-8 text-center text-slate-400">You haven't registered any respondents yet.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/footer') %>
