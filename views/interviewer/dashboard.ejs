<%- include('../partials/header', { title: 'My Respondents — INICIO', user }) %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <div class="text-xs font-semibold text-brand-500 uppercase tracking-wide mb-0.5">Fieldwork</div>
    <h1 class="text-2xl font-bold text-slate-900">My Respondents (F2F)</h1>
    <p class="text-slate-500 text-sm mt-1">Respondents you've screened, consented and registered in the field.</p>
  </div>
  <div class="flex gap-2">
    <a href="/interviewer/register" class="inline-flex items-center gap-1.5 bg-brand-700 text-white rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-brand-600 transition shadow-card">
      <%- icon('plus', 'w-4 h-4') %> Register Respondent
    </a>
  </div>
</div>

<!-- Registering in person and texting a list are different jobs, so the bulk
     route gets its own card rather than a second button that looks like the
     first. It needs a study, and an interviewer may work on several, so each
     is a link rather than a picker. -->
<% if (studies.length) { %>
  <div class="bg-white rounded-2xl border border-slate-200/70 shadow-card p-5 mb-6">
    <div class="flex items-center gap-2 mb-1">
      <%- icon('upload', 'w-4 h-4 text-brand-500') %>
      <span class="font-semibold text-slate-800 text-sm">Invite a group of people</span>
    </div>
    <p class="text-xs text-slate-500 mb-3 leading-relaxed">
      Have a list of names and numbers? Upload it and text everyone an invitation. You'll see what the app made of each row before anything is sent.
    </p>
    <div class="flex flex-wrap gap-2">
      <% studies.forEach(s => { %>
        <a href="/interviewer/studies/<%= s.id %>/bulk-invite"
           class="inline-flex items-center gap-1.5 bg-white border border-slate-300 rounded-xl px-3.5 py-2 text-sm font-medium hover:bg-slate-50 hover:border-slate-400 transition">
          <%- icon('arrow-right', 'w-3.5 h-3.5 text-brand-600') %> <%= s.name %>
        </a>
      <% }) %>
    </div>
  </div>
<% } %>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card hover:shadow-card-hover transition">
    <div class="flex items-center gap-2 text-slate-500 text-xs uppercase tracking-wide font-semibold">
      <span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center"><%- icon('users', 'w-4 h-4') %></span>
      Registered
    </div>
    <div class="text-3xl font-bold text-slate-900 mt-3"><%= mine.length %></div>
  </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card">
  <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2"><%- icon('clipboard', 'w-4 h-4 text-brand-500') %> Respondent Roster</div>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="text-left text-slate-400 text-xs uppercase tracking-wide"><th class="pb-2">Code</th><th class="pb-2">Name</th><th class="pb-2">Study</th><th class="pb-2">Status</th><th class="pb-2">Hand over</th></tr></thead>
    <tbody>
    <% mine.forEach(r => { %>
      <tr class="border-t border-slate-100 hover:bg-slate-50/70">
        <td class="py-2.5 font-mono text-xs text-slate-500"><%= r.respondent_code %></td>
        <td class="py-2.5 font-medium text-slate-700"><%= r.name %></td>
        <td class="py-2.5 text-slate-500 text-xs"><%= r.study_name %></td>
        <td class="py-2.5">
          <span class="text-xs px-2.5 py-1 rounded-full font-medium capitalize <%= ['active','activated','completed'].includes(r.activation_status) ? 'badge-green' : ['invited','screened','registered'].includes(r.activation_status) ? 'badge-amber' : 'bg-slate-100 text-slate-600' %>"><%= r.activation_status %></span>
        </td>
        <td class="py-2.5"><a class="inline-flex items-center gap-1 text-brand-600 hover:underline text-xs font-medium" href="/interviewer/respondents/<%= r.id %>"><%- icon('qrcode', 'w-3.5 h-3.5') %> Show link</a></td>
      </tr>
    <% }) %>
    <% if (!mine.length) { %><tr><td colspan="5" class="py-8 text-center text-slate-400">You haven't registered any respondents yet.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>

<%# ---- Field recruitment layout (approved comps) ---- %>
<div class="grid grid-cols-1 lg:grid-cols-[260px_minmax(0,1fr)] gap-5 mt-5">
  <div class="bg-white dark:bg-night-raised rounded-2xl border border-slate-200/70 dark:border-night-line shadow-card p-5">
    <div class="font-display font-bold text-slate-900 dark:text-night-ink mb-1">F2F onboarding steps</div>
    <p class="text-xs text-slate-500 dark:text-night-muted mb-4">The order to work through with someone.</p>
    <% steps.forEach(function (st, i) { %>
      <div class="relative flex gap-3 pb-4 last:pb-0">
        <% if (i < steps.length - 1) { %>
          <span class="absolute left-[15px] top-8 bottom-0 w-px bg-slate-200 dark:bg-night-line"></span>
        <% } %>
        <span class="w-8 h-8 rounded-full bg-signal text-white text-sm font-semibold flex items-center justify-center shrink-0 relative z-10"><%= st.n %></span>
        <span class="min-w-0">
          <span class="block text-sm font-semibold text-slate-900 dark:text-night-ink"><%= st.title %></span>
          <span class="block text-xs text-slate-500 dark:text-night-muted leading-snug"><%= st.detail %></span>
        </span>
      </div>
    <% }) %>
    <div class="mt-5 pt-4 border-t border-slate-100 dark:border-night-line">
      <div class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500 dark:text-night-muted mb-2.5">Today</div>
      <% var rows = [['Registered', counts.registered, 'bg-signal'], ['Activated', counts.activated, 'bg-verified'], ['Pending', counts.pending, 'bg-unverified']]; %>
      <% rows.forEach(function (r) { %>
        <div class="flex items-center gap-2.5 text-sm py-1">
          <span class="w-1 h-4 rounded-full <%= r[2] %> shrink-0"></span>
          <span class="flex-1 text-slate-600 dark:text-night-muted"><%= r[0] %></span>
          <span class="font-mono text-slate-900 dark:text-night-ink"><%= r[1] %></span>
        </div>
      <% }) %>
      <a href="/interviewer/register" class="mt-4 flex items-center justify-center gap-2 w-full h-12 rounded-xl bg-signal text-white font-semibold text-sm">
        Register respondent
      </a>
    </div>
  </div>

  <div class="bg-white dark:bg-night-raised rounded-2xl border border-slate-200/70 dark:border-night-line shadow-card overflow-hidden">
    <div class="px-5 pt-5 pb-3">
      <div class="font-display font-bold text-slate-900 dark:text-night-ink">My respondents</div>
      <p class="text-xs text-slate-500 dark:text-night-muted mt-0.5">Everyone you have recruited, newest first.</p>
    </div>
    <% if (!mine.length) { %>
      <p class="px-5 pb-6 text-sm text-slate-500 dark:text-night-muted">You have not recruited anyone yet.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left">
              <th class="px-5 py-2.5 font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500 dark:text-night-muted font-medium border-b border-slate-200 dark:border-night-line">Respondent</th>
              <th class="py-2.5 font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500 dark:text-night-muted font-medium border-b border-slate-200 dark:border-night-line">Status</th>
              <th class="py-2.5 pr-5 font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500 dark:text-night-muted font-medium border-b border-slate-200 dark:border-night-line text-right">Handover</th>
            </tr>
          </thead>
          <tbody>
            <% mine.forEach(function (r) { %>
              <% var live = ['active','activated'].indexOf(r.activation_status) > -1; %>
              <tr class="border-b border-slate-100 dark:border-night-line last:border-0">
                <td class="px-5 py-3">
                  <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-full bg-slate-100 dark:bg-night-sunken text-slate-600 dark:text-night-muted text-xs font-semibold flex items-center justify-center shrink-0">
                      <%= (r.name || '?').split(' ').map(function(w){return w[0]}).slice(0,2).join('').toUpperCase() %>
                    </span>
                    <span class="min-w-0">
                      <span class="block font-medium text-slate-900 dark:text-night-ink truncate"><%= r.name || 'Unnamed' %></span>
                      <span class="block font-mono text-xs text-slate-500 dark:text-night-muted"><%= r.contact || r.respondent_code %></span>
                    </span>
                  </div>
                </td>
                <td class="py-3">
                  <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full
                    <%= live ? 'bg-verified-soft dark:bg-verified/15 text-verified' : 'bg-signal-soft dark:bg-signal/15 text-signal' %>">
                    <%= r.activation_status %>
                  </span>
                </td>
                <td class="py-3 pr-5 text-right">
                  <%# The action that matters: someone registered but never handed
                      over has a diary they cannot open, and only the interviewer
                      standing next to them can fix it. %>
                  <% if (!live) { %>
                    <a href="/interviewer/respondents/<%= r.id %>" class="text-sm font-medium text-signal">Hand over →</a>
                  <% } else { %>
                    <span class="text-xs text-slate-400 dark:text-night-muted">Done</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
