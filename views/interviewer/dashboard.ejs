<%- include('../partials/interviewer_header', { title: 'My respondents', currentPath: '/interviewer' }) %>
<div class="report-heading"><div><div class="report-kicker">Your fieldwork workspace</div><h1>Good research starts with people.</h1><p class="report-lead">Manage your recruits, pick up unfinished setup and make every handover clear.</p></div></div>
<div class="field-welcome"><div><h2>Ready for your next conversation?</h2><p>Walk through eligibility, consent and registration together. Then share the personal link with the respondent.</p></div><a class="report-button" href="/interviewer/register"><%- icon('plus','w-4 h-4') %> Register respondent</a></div>
<dl class="report-stats">
<% [['My respondents',mine.length,'All registrations, including practice'],['Registered today',counts.registered,'Registrations today (UTC)'],['Currently active',counts.activated,'Active or activated status'],['Setup pending',counts.pending,'Invited, screened or registered']].forEach(([label,value,note]) => { %>
<div class="report-stat"><dt><%= label %></dt><dd><%= value %></dd><dd class="report-stat-note"><%= note %></dd></div>
<% }) %>
</dl>
<section id="roster" class="report-panel" data-field-roster>
  <div class="report-panel-head"><div><div class="report-kicker">Your people</div><h2>My respondents</h2><p>Newest first. Status shows recruitment progress; it does not confirm that a link was delivered.</p></div><span class="report-badge"><%= mine.length %> registered</span></div>
  <div class="field-roster-tools">
    <label>Find a respondent<input type="search" data-roster-search placeholder="Name, code or contact" /></label>
    <label>Study<select data-roster-study><option value="">All my studies</option><% [...new Map(mine.map(r => [r.study_id,r.study_name]))].forEach(([id,name]) => { %><option value="<%= id %>"><%= name %></option><% }) %></select></label>
    <label>Status<select data-roster-status><option value="">All statuses</option><% [...new Set(mine.map(r=>r.recruitment_hold ? 'review' : r.activation_status))].sort().forEach(status=> { %><option value="<%= status %>"><%= status === 'review' ? 'Review needed' : status %></option><% }) %></select></label>
  </div>
  <div class="field-roster-head" aria-hidden="true"><span>Respondent</span><span>Study</span><span>Status</span><span>Next action</span></div>
  <ul aria-label="My respondents">
  <% mine.forEach(r => { const active=['active','activated','completed'].includes(r.activation_status); %>
    <li class="field-person" data-roster-row data-study="<%= r.study_id %>" data-status="<%= r.recruitment_hold ? 'review' : r.activation_status %>" data-search="<%= [r.name,r.respondent_code,r.contact].join(' ').toLowerCase() %>">
      <div class="field-person-name"><span class="field-avatar" aria-hidden="true"><%= (r.name||'?').split(' ').filter(Boolean).slice(0,2).map(w=>w[0]).join('').toUpperCase() %></span><div><strong><%= r.name || 'Unnamed respondent' %></strong><small><%= r.respondent_code %> · <%= r.contact || 'No contact recorded' %></small><% if(r.is_practice) { %><small>Practice respondent</small><% } %></div></div>
      <div class="field-study-name"><%= r.study_name %></div>
      <div><span class="field-status <%= r.recruitment_hold ? 'review' : active ? 'active' : r.activation_status === 'disqualified' ? 'stopped' : '' %>"><%= r.recruitment_hold ? 'Review needed' : r.activation_status || 'Unknown' %></span></div>
      <a class="report-button secondary" href="/interviewer/respondents/<%= r.id %>" aria-label="Handover details for <%= r.name || r.respondent_code %>"><%= r.recruitment_hold ? 'View review' : 'Handover' %> <span aria-hidden="true">→</span></a>
    </li>
  <% }) %>
  </ul>
  <div class="report-empty" data-roster-empty <%= mine.length ? 'hidden' : '' %>><%= mine.length ? 'No respondents match these filters.' : 'Your first respondent will appear here after registration.' %></div>
  <div class="field-roster-count" role="status" data-roster-count><%= mine.length %> respondents shown</div>
</section>
<section id="invite-groups" class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Recruit from a list</div><h2>Group invitations</h2><p>Choose a study, upload your list and review each row before sending invitations.</p></div></div>
<% if(studies.length) { %><div class="field-study-grid"><% studies.forEach(s=> { %><article class="field-study-card"><span class="report-badge"><%= s.status %></span><h3><%= s.name %></h3><p><%= [s.market,s.category].filter(Boolean).join(' · ') %></p><a class="report-button secondary" href="/interviewer/studies/<%= s.id %>/bulk-invite">Prepare invitations <span aria-hidden="true">→</span></a></article><% }) %></div><% } else { %><div class="report-empty">No open studies are available for recruitment.</div><% } %>
</section>
<%- include('../partials/interviewer_footer') %>
