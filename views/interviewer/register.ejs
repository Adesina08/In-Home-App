<%- include('../partials/interviewer_header', { title: 'Register respondent', currentPath: '/interviewer/register' }) %>
<a class="field-back" href="/interviewer">← Back to my respondents</a>
<div class="report-heading"><div><div class="report-kicker">Face-to-face recruitment</div><h1>A clear start for every respondent.</h1><p class="report-lead">Complete these checks together, then prepare their personal handover link.</p></div></div>
<% const v = typeof values !== 'undefined' ? values : {}; %>
<% if (typeof error !== 'undefined' && error) { %><div class="report-notice error" role="alert"><%= error %></div><% } %>
<% if (!studies.length) { %><div class="report-empty">There are no open studies available. Contact the research team to arrange recruitment.</div><% } else { %>
<form class="report-toolbar" action="/interviewer/register" method="GET"><label>Recruiting for<select name="study"><% studies.forEach(s=> { %><option value="<%= s.id %>" <%= study && study.id===s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label><button class="report-button secondary" type="submit">Choose study</button></form>
<% if (study) { %>
<div class="field-form-layout">
<form method="POST" action="/interviewer/register" class="field-form" data-registration-form>
<input type="hidden" name="study_id" value="<%= study.id %>" />
<section id="screen-consent" class="report-panel"><div class="field-section-title"><span class="field-step">1</span><h2>Eligibility & consent</h2></div>
<p class="report-muted" style="margin-bottom:16px">Confirm the respondent meets this study’s recruitment criteria before continuing.</p>
<% if(!(study.screener_questions||[]).length){ %><div class="report-notice">The research team must configure the study eligibility questions.</div><% } %>
<% (study.screener_questions||[]).forEach(q=>{ %><label class="field-input"><%= q.text %><select name="screener[<%= q.code %>]" required><option value="">Choose an answer</option><% q.options.forEach(o=>{ %><option <%= v.screener?.[q.code]===o?'selected':'' %>><%= o %></option><% }) %></select></label><% }) %>
<% if (consent) { %><input type="hidden" name="consent_version" value="<%= consent.version %>" /><div class="report-panel-head" style="margin-top:24px;margin-bottom:10px"><h3 style="font-size:13px;font-weight:600">Read or show the study consent</h3><span class="report-badge">Version <%= consent.version %></span></div><div class="field-consent" tabindex="0" role="region" aria-label="Study consent wording"><%= consent.body %></div>
<label class="field-check"><input type="checkbox" name="consent_given" value="1" <%= v.consent_given ? 'checked' : '' %> required /><span><strong>The respondent agrees to take part</strong>I have read or shown the consent wording and recorded their agreement.</span></label>
<% } else { %><div class="report-notice" style="margin-top:20px">Approved consent wording is not available. Ask the research team to approve it before registering respondents.</div><% } %>
<label class="field-check"><input name="media_consent" type="checkbox" value="1" /><span><strong>Optional media sharing consent</strong>The respondent agrees that study photos, video and audio may be shown to authorised client researchers.</span></label>
</section>
<section id="respondent-details" class="report-panel"><div class="field-section-title"><span class="field-step">2</span><h2>Respondent details</h2></div>
<div class="field-input-grid"><label class="field-input">Full name<input name="name" autocomplete="name" value="<%= v.name || '' %>" required /></label><label class="field-input">Phone number or email<input name="contact" autocomplete="tel" value="<%= v.contact || '' %>" required /><small>Confirm the contact details with the respondent.</small></label></div>
<label class="field-check"><input type="checkbox" name="practice" value="1" <%= v.practice ? 'checked' : '' %> /><span><strong>Practice respondent</strong>Mark this registration as practice, separate from the research sample.</span></label>
</section>
<section id="prepare-handover" class="report-panel"><div class="field-section-title"><span class="field-step">3</span><h2>Prepare the handover</h2></div>
<label class="field-input">Preferred diary channel<select name="preferred_channel"><option value="app" <%= v.preferred_channel !== 'whatsapp' ? 'selected' : '' %>>INICIO Diary app</option><option value="whatsapp" <%= v.preferred_channel === 'whatsapp' ? 'selected' : '' %>>WhatsApp</option></select><small>This records a preference. Registration does not send a message.</small></label>
<p class="report-muted">The app checks for recruitment holds when you save. If a review is needed, you’ll see the reason before handing over.</p>
<div class="field-submit"><p>Help the respondent open their personal link on their own phone.</p><button type="submit" class="report-button" <%= consent ? '' : 'disabled' %>>Register & continue <span aria-hidden="true">→</span></button></div>
</section>
</form>
<aside class="field-form-aside"><h2>Your registration guide</h2><ol><li><a href="#screen-consent"><span class="field-step">1</span> Eligibility & consent</a></li><li><a href="#respondent-details"><span class="field-step">2</span> Respondent details</a></li><li><a href="#prepare-handover"><span class="field-step">3</span> Prepare handover</a></li></ol><p style="margin-top:22px;border-top:1px solid #d5dfef;padding-top:18px">Work through each section with the respondent. Only save after they understand the study and agree to take part.</p></aside>
</div>
<% } else { %><div class="report-empty">Choose an available study to begin registration.</div><% } %>
<% } %>
<%- include('../partials/interviewer_footer') %>
