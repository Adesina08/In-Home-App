<%- include('../partials/interviewer_header', { title: 'Registration under review', currentPath: '/interviewer/register' }) %>
<div class="field-result"><a class="field-back" href="/interviewer">← Back to my respondents</a><section class="report-panel"><div class="field-result-mark review"><%- icon('warning','w-7 h-7') %></div><div class="report-kicker">Registration saved / <%= code %></div><h1>The research team needs to review this.</h1><p class="report-lead"><strong><%= name || 'This respondent' %></strong> has been registered. Activation is on hold until the research team reviews the following:</p>
<% holds.forEach(h=> { %><div class="report-notice"><strong><%= h.flagType === 'duplicate_identity' ? 'Possible duplicate contact' : 'Consent not recorded' %></strong><p><%= h.reason %></p></div><% }) %>
<h2>What to do next</h2><p class="report-lead">Explain the situation to the research team and quote <strong><%= code %></strong>. They can review the registration and release the hold when appropriate.</p><div class="field-submit"><a class="report-button" href="/interviewer">Return to my respondents</a><a class="report-button secondary" href="/interviewer/register">Register another</a></div></section></div>
<%- include('../partials/interviewer_footer') %>
