<%- include('../partials/interviewer_header', { title: 'Respondent handover', currentPath: '/interviewer' }) %>
<a class="field-back" href="/interviewer">← Back to my respondents</a>
<div class="report-heading"><div><div class="report-kicker">Respondent handover / <%= respondent.respondent_code %></div><h1><%= respondent.name || 'Share their personal link' %></h1><p class="report-lead"><%= respondent.study_name %></p></div><span class="field-status"><%= respondent.activation_status %></span></div>
<% if(sent) { %><div class="report-notice" role="status"><%= sent %></div><% } %>
<% if(sendError) { %><div class="report-notice error" role="alert"><%= sendError %></div><% } %>
<% if (respondent.recruitmentHolds.length) { %>
<section class="report-panel"><div class="report-kicker">Activation on hold</div><h2>Research review is needed before handover.</h2><p class="report-lead">The registration is saved. Contact the research team with respondent code <strong><%= respondent.respondent_code %></strong>.</p><% respondent.recruitmentHolds.forEach(hold=> { %><div class="report-notice" style="margin-top:18px"><%= hold.reason %></div><% }) %></section>
<% } else { %>
<section class="report-panel"><div class="report-panel-head"><div><h2>Help them get started</h2><p>Share the link with the respondent so they can continue on their own phone.</p></div></div>
<div class="field-handover"><div class="field-qr"><img src="/interviewer/respondents/<%= respondent.id %>/qr.png" alt="QR code for this respondent’s personal link" width="240" height="240" /><p>Ask the respondent to scan with their phone’s camera.</p></div>
<div><div class="report-kicker">Their personal link</div><h3 style="font-size:16px;font-weight:600">Copy and share</h3><div class="field-link" id="diary-link"><%= diaryUrl %></div><button class="report-button secondary" type="button" data-copy-link="diary-link"><%- icon('clipboard','w-4 h-4') %> Copy link</button><p class="field-copy-status" data-copy-status role="status"></p>
<div style="border-top:1px solid #dfe7f2;padding-top:22px;margin-top:10px"><h3 style="font-size:16px;font-weight:600">Send to their contact</h3><p class="report-muted" style="margin:10px 0 15px"><%= respondent.contact || 'No contact is recorded for this respondent.' %></p>
<% if (respondent.contact && messagingLive) { %><form method="POST" action="/interviewer/respondents/<%= respondent.id %>/send-link"><button class="report-button" type="submit">Send personal link</button></form><% } else { %><div class="report-notice"><%= respondent.contact ? 'Messaging is not connected. Use the QR code or copy the link to share it.' : 'Use the QR code or copy the link to share it.' %></div><% } %>
</div></div></div>
</section>
<div class="report-notice">The respondent should complete setup on their own phone. Registration status alone does not confirm that they received the link or finished setup.</div>
<% } %>
<%- include('../partials/interviewer_footer') %>
