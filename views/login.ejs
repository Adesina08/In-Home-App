<%- include('partials/header', { title: 'Sign in — INICIO Diary', user: null }) %>

<script>document.documentElement.classList.add('login-js');</script>
<link rel="stylesheet" href="/public/login-diary.css" />

<div class="login-page">
  <div class="login-stage<%= error ? ' is-open' : '' %>" id="loginStage">
    <section class="login-brand" aria-label="About INICIO Diary">
      <div class="login-brand-top">
        <img src="/public/icons/logo-header.png" alt="" class="login-logo" />
        <span>INICIO Diary</span>
      </div>

      <div class="login-brand-main">
        <p class="login-eyebrow">Research operations</p>
        <h2>Every study,<br />in motion.</h2>
        <p class="login-brand-description">One clear path from study setup to the insights that matter.</p>

        <ol class="login-workflow" aria-label="Study workflow">
          <li><span class="login-step-number">01</span><span>Study</span></li>
          <li><span class="login-step-number">02</span><span>Diary</span></li>
          <li><span class="login-step-number">03</span><span>Review</span></li>
          <li><span class="login-step-number">04</span><span>Report</span></li>
        </ol>

        <button class="login-proceed" id="loginProceed" type="button" aria-controls="loginFormPanel" aria-expanded="false">
          Proceed to login <%- icon('arrow-right', 'w-5 h-5') %>
        </button>
      </div>

      <div class="login-brand-bottom">Research. Insights. Impact.</div>
    </section>

    <section class="login-form-panel" id="loginFormPanel" aria-label="Sign in">
      <div class="login-form-inner">
        <div class="login-mobile-brand">
          <img src="/public/icons/logo-header.png" alt="" class="login-logo" />
          <span>INICIO Diary</span>
        </div>

        <p class="login-form-eyebrow">INICIO Diary / Sign in</p>
        <h1>Welcome back</h1>
        <p class="login-form-description">Sign in to your staff or client account.</p>

        <% if (error) { %>
          <div class="login-error" role="alert">
            <%- icon('warning', 'w-4 h-4 shrink-0') %>
            <span><%= error %></span>
          </div>
        <% } %>

        <form method="POST" action="/login" class="login-form">
          <div class="login-field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" required autocomplete="username" placeholder="you@example.com" />
          </div>
          <div class="login-field">
            <div class="login-label-row">
              <label for="password">Password</label>
              <a href="/forgot-password">Forgot password?</a>
            </div>
            <div class="login-password-wrap">
              <input id="password" name="password" type="password" required autocomplete="current-password" />
              <button type="button" id="pwToggle" aria-controls="password" aria-pressed="false">Show</button>
            </div>
          </div>
          <button type="submit" class="login-submit">Sign in <%- icon('arrow-right', 'w-4 h-4') %></button>
        </form>

        <p class="login-help">Need access? Contact your research manager.</p>

        <% if (typeof showDemoAccounts !== 'undefined' && showDemoAccounts) { %>
          <details class="login-demo">
            <summary>Development demo accounts</summary>
            <div class="login-demo-grid">
              <% var demos = [['Superadmin','superadmin@inicio.demo'],['Admin','admin@inicio.demo'],['Interviewer','interviewer@inicio.demo'],['Client','client@inicio.demo']]; %>
              <% demos.forEach(function (d) { %>
                <div><strong><%= d[0] %></strong><span><%= d[1] %></span></div>
              <% }) %>
            </div>
            <p>Password for all: <strong>Demo1234!</strong></p>
          </details>
        <% } %>
      </div>
    </section>
  </div>
</div>

<script>
  (function () {
    var stage = document.getElementById('loginStage');
    var proceed = document.getElementById('loginProceed');
    var email = document.getElementById('email');
    var toggle = document.getElementById('pwToggle');
    var password = document.getElementById('password');

    if (proceed && stage) {
      proceed.addEventListener('click', function () {
        stage.classList.add('is-open');
        proceed.setAttribute('aria-expanded', 'true');
        window.setTimeout(function () { if (email) email.focus(); }, 520);
      });
    }
    if (toggle && password) {
      toggle.addEventListener('click', function () {
        var show = password.type === 'password';
        password.type = show ? 'text' : 'password';
        toggle.textContent = show ? 'Hide' : 'Show';
        toggle.setAttribute('aria-pressed', String(show));
      });
    }
  })();
</script>

<%- include('partials/footer', { hidePublicFooter: true }) %>
