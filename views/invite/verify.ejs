<%- include('../partials/onboarding_header', { phase: 2, title: 'Verify your contact — ' + study.name, user: null }) %>

<div class="max-w-md mx-auto">
  <div class="bg-white sm:rounded-2xl sm:border border-slate-200/70 sm:shadow-card p-6">
    <h1 class="text-2xl font-bold text-slate-900">Verify your contact</h1>
    <p class="text-sm text-slate-600 mt-2">We’ll send a 6-digit code to <strong><%= respondent.contact %></strong>. The code expires in <%= ttlMinutes %> minutes.</p>
    <% if (error) { %><div role="alert" class="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700"><%= error %></div><% } %>
    <% if (sent) { %><p class="mt-4 text-sm text-emerald-700">Your code was sent. Enter it below to continue.</p><% } %>
    <form method="POST" action="/invite/<%= respondent.unique_token %>/verify/send" class="mt-5">
      <button class="w-full rounded-xl bg-brand-700 text-white font-semibold py-3.5"><%= sent ? 'Send a new code' : 'Send verification code' %></button>
    </form>
    <form method="POST" action="/invite/<%= respondent.unique_token %>/verify" class="mt-5 space-y-3">
      <label for="verification-code" class="block text-sm font-semibold text-slate-800">Verification code</label>
      <input id="verification-code" name="code" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="000000" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-center text-2xl tracking-widest" />
      <button class="w-full rounded-xl bg-brand-700 text-white font-semibold py-3.5">Verify and continue</button>
    </form>
    <p class="mt-5 text-xs text-slate-500">Wrong email or phone number? <a class="text-brand-600 underline" href="/invite/<%= respondent.unique_token %>/presurvey?edit=1">Go back and correct it</a>.</p>
  </div>
</div>

<%- include('../partials/onboarding_footer') %>
