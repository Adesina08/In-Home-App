<%- include('../partials/header', { title: "You're invited — " + study.name, user: null }) %>

<div class="max-w-md mx-auto">
  <div class="bg-white sm:rounded-2xl sm:border border-slate-200/70 sm:shadow-card p-6">
    <div class="text-center mb-6">
      <img src="/public/icons/logo-header.png" alt="INICIO" class="h-9 w-auto mx-auto mb-4" />
      <div class="text-xs font-semibold uppercase tracking-wide text-brand-600 mb-1">You're invited to take part</div>
      <h1 class="text-xl font-bold text-slate-900"><%= study.name %></h1>
      <% if (study.market || study.category) { %>
        <p class="text-xs text-slate-400 mt-1"><%= [study.market, formatCategories(study.category)].filter(Boolean).join(' · ') %></p>
      <% } %>
    </div>

    <% if (declined) { %>
      <div class="bg-slate-50 border border-slate-200 text-slate-600 text-sm rounded-xl p-4 mb-5 leading-relaxed">
        You previously declined this study, so we've stopped contacting you about it. If that was a mistake, you can choose a participation option below.
      </div>
    <% } %>

    <div class="bg-brand-50 border border-brand-100 rounded-xl p-4 mb-4">
      <div class="text-sm font-semibold text-slate-800 mb-1">What this study is about</div>
      <p class="text-sm text-slate-600 leading-relaxed whitespace-pre-line"><%= study.invite_brief && study.invite_brief.trim()
        ? study.invite_brief.trim()
        : 'We\'re researching how people use products like these at home. You\'ll keep a short diary and answer a few questions about each consumption occasion.' %></p>
    </div>

    <div class="grid grid-cols-2 gap-3 mb-6">
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5">
        <div class="flex items-center gap-2 text-slate-800 text-sm font-semibold mb-0.5"><%- icon('calendar', 'w-4 h-4 text-brand-600') %> How often</div>
        <div class="text-xs text-slate-500 leading-relaxed">You'd fill in your diary <%= cadence %>.</div>
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5">
        <div class="flex items-center gap-2 text-slate-800 text-sm font-semibold mb-0.5"><%- icon('shield', 'w-4 h-4 text-brand-600') %> Your choice</div>
        <div class="text-xs text-slate-500 leading-relaxed">Taking part is voluntary, and each study has its own consent.</div>
      </div>
    </div>

    <div class="text-sm font-semibold text-slate-800 mb-1">How would you like to take part?</div>
    <p class="text-xs text-slate-500 mb-4 leading-relaxed">Your one-time INICIO profile is shared across studies, whichever channel you choose. You won't have to answer the same background questions again on a future study.</p>

    <div class="space-y-3">
      <form method="POST" action="/invite/<%= respondent.unique_token %>/choose">
        <input type="hidden" name="mode" value="app" />
        <button class="w-full text-left bg-white border-2 border-brand-600 rounded-xl p-4 hover:bg-brand-50 transition flex items-start gap-3">
          <span class="w-10 h-10 rounded-xl bg-brand-700 text-white flex items-center justify-center shrink-0"><%- icon('smartphone', 'w-5 h-5') %></span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold text-slate-900">Use the INICIO App</span>
            <span class="block text-xs text-slate-500 leading-relaxed mt-0.5"><%= apkUrl ? 'Install or open the Android app, then continue this same invitation.' : 'The Android build is not published on this deployment yet, so we will use the secure phone version as a temporary fallback.' %></span>
            <span class="inline-flex mt-2 text-[10px] font-bold uppercase tracking-wide rounded-full px-2 py-1 bg-brand-50 text-brand-700"><%= apkUrl ? 'Recommended' : 'App build pending' %></span>
          </span>
          <%- icon('arrow-right', 'w-4 h-4 text-brand-600 mt-1 shrink-0') %>
        </button>
      </form>

      <% if (whatsappNumber) { %>
        <form method="POST" action="/invite/<%= respondent.unique_token %>/choose">
          <input type="hidden" name="mode" value="whatsapp" />
          <button class="w-full text-left bg-white border border-slate-300 rounded-xl p-4 hover:border-emerald-300 hover:bg-emerald-50 transition flex items-start gap-3">
            <span class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0"><%- icon('chat', 'w-5 h-5') %></span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-semibold text-slate-900">Use WhatsApp</span>
              <span class="block text-xs text-slate-500 leading-relaxed mt-0.5">Open a chat with INICIO. First-time profile questions and this study's consent happen in the conversation.</span>
            </span>
            <%- icon('arrow-right', 'w-4 h-4 text-emerald-600 mt-1 shrink-0') %>
          </button>
        </form>
      <% } else { %>
        <div class="w-full text-left bg-slate-50 border border-dashed border-slate-300 rounded-xl p-4 flex items-start gap-3">
          <span class="w-10 h-10 rounded-xl bg-white text-slate-400 flex items-center justify-center shrink-0"><%- icon('chat', 'w-5 h-5') %></span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold text-slate-500">Use WhatsApp <span class="ml-1 text-[10px] uppercase tracking-wide bg-slate-200 text-slate-500 rounded px-1.5 py-0.5 align-middle">Not configured</span></span>
            <span class="block text-xs text-slate-400 leading-relaxed mt-0.5">The study's WhatsApp sender has not been configured yet.</span>
          </span>
        </div>
      <% } %>
    </div>

    <% if (!declined) { %>
      <form method="POST" action="/invite/<%= respondent.unique_token %>/decline" class="mt-6 pt-5 border-t border-slate-100 text-center">
        <button class="text-xs font-medium text-slate-500 hover:text-slate-800 transition">No thanks — I'd rather not take part</button>
        <p class="text-[11px] text-slate-400 mt-1.5">One tap, and we won't contact you about this study again.</p>
      </form>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
