<%- include('../partials/onboarding_header', { phase: 3, title: 'Reset your password — INICIO Diary', user: null, study, showThemeToggle: true }) %>

<div class="max-w-md mx-auto">
  <div class="bg-white sm:rounded-2xl sm:border border-slate-200/70 sm:shadow-card p-6">

    <% if (error) { %>
      <div class="flex items-start gap-2 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl p-3 mb-4">
        <%- icon('warning', 'w-4 h-4 mt-0.5 shrink-0') %><span><%= error %></span>
      </div>
    <% } %>
    <% if (notice) { %>
      <div class="flex items-start gap-2 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-xl p-3 mb-4">
        <%- icon('check-circle', 'w-4 h-4 mt-0.5 shrink-0') %><span><%= notice %></span>
      </div>
    <% } %>

    <% if (step === 'request') { %>
      <h1 class="text-2xl font-bold text-slate-900 mt-1">Reset your password</h1>
      <p class="text-sm text-slate-500 mt-2 leading-relaxed">To confirm it's you, we'll send a verification code to <strong class="text-slate-700"><%= maskedContact %></strong> — the contact on file for your INICIO Diary account.</p>
      <form method="POST" action="/invite/<%= respondent.unique_token %>/reset-password" class="mt-6">
        <button class="w-full rounded-xl bg-brand-700 text-white font-semibold py-3.5 hover:bg-brand-800 transition">Send verification code</button>
      </form>

    <% } else if (step === 'verify') { %>
      <h1 class="text-2xl font-bold text-slate-900 mt-1 flex items-center gap-2"><%- icon('shield', 'w-5 h-5 text-brand-500') %> Enter your code</h1>
      <p class="text-sm text-slate-500 mt-2 leading-relaxed">A 6-digit code was sent to <strong class="text-slate-700"><%= maskedContact %></strong>. It expires in <%= ttlMinutes %> minutes.</p>
      <% if (typeof simulated !== 'undefined' && simulated) { %>
        <div class="flex items-start gap-2 bg-amber-50 border border-amber-200 text-amber-800 text-sm rounded-xl p-3 mt-4">
          <%- icon('warning', 'w-4 h-4 mt-0.5 shrink-0') %>
          <span>Text messaging isn't switched on yet, so no code was actually sent. Ask the research team to look up your code in Admin &gt; Message Log.</span>
        </div>
      <% } %>
      <form method="POST" action="/invite/<%= respondent.unique_token %>/reset-password/verify" class="space-y-4 mt-6">
        <input name="code" required inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code"
               autofocus placeholder="000000"
               class="w-full border border-slate-300 rounded-xl px-3.5 py-3 text-center text-2xl font-mono tracking-[0.4em] focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition" />
        <button class="w-full rounded-xl bg-brand-700 text-white font-semibold py-3.5 hover:bg-brand-800 transition">Verify code</button>
      </form>
      <form method="POST" action="/invite/<%= respondent.unique_token %>/reset-password/resend" class="mt-4 text-center">
        <button class="text-xs font-medium text-slate-500 hover:text-brand-700 transition">Didn't get it? Send a new code</button>
      </form>

    <% } else { %>
      <h1 class="text-2xl font-bold text-slate-900 mt-1">Set a new password</h1>
      <p class="text-sm text-slate-500 mt-2 leading-relaxed">Choose a new password for your INICIO Diary account. You'll use it the next time you sign in.</p>
      <form method="POST" action="/invite/<%= respondent.unique_token %>/reset-password/new" class="space-y-5 mt-6">
        <div>
          <label class="block text-sm font-semibold text-slate-800 mb-1.5">New password</label>
          <input type="password" name="password" autocomplete="new-password" minlength="8" required class="w-full rounded-xl border border-slate-300 px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-800 mb-1.5">Confirm new password</label>
          <input type="password" name="confirm_password" autocomplete="new-password" minlength="8" required class="w-full rounded-xl border border-slate-300 px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <button class="w-full rounded-xl bg-brand-700 text-white font-semibold py-3.5 hover:bg-brand-800 transition">Save new password</button>
      </form>
    <% } %>

    <div class="mt-5 pt-4 border-t border-slate-100 text-center">
      <a href="/invite/<%= respondent.unique_token %>/account" class="text-xs font-medium text-brand-600 hover:underline">Back to account</a>
    </div>
  </div>
</div>

<%- include('../partials/onboarding_footer') %>
