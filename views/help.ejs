<%- include('partials/header', { title: content.title + ' — INICIO', user }) %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <div class="text-xs font-semibold text-brand-500 uppercase tracking-wide mb-0.5">Help</div>
    <h1 class="text-2xl font-bold text-slate-900"><%= content.title %></h1>
    <p class="text-slate-500 text-sm mt-1 max-w-2xl"><%= content.intro %></p>
  </div>
  <a href="/public/docs/INICIO-User-Guide.docx" download class="inline-flex items-center gap-1.5 bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-medium hover:bg-slate-50 hover:border-slate-400 transition shadow-card shrink-0">
    <%- icon('download', 'w-4 h-4') %> Download the full guide (Word)
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
  <nav class="hidden lg:block lg:col-span-1">
    <div class="bg-white rounded-2xl border border-slate-200/70 shadow-card p-3 sticky top-20">
      <div class="text-xs font-semibold text-slate-400 uppercase tracking-wide px-2 mb-1.5">On this page</div>
      <% content.sections.forEach((s, i) => { %>
        <a href="#section-<%= i %>" class="block px-2 py-1.5 rounded-lg text-sm text-slate-600 hover:bg-slate-50 hover:text-brand-700 transition"><%= s.heading %></a>
      <% }) %>
    </div>
  </nav>

  <div class="lg:col-span-3 space-y-5">
    <% content.sections.forEach((s, i) => { %>
      <div id="section-<%= i %>" class="bg-white rounded-2xl border border-slate-200/70 shadow-card p-6 scroll-mt-20">
        <div class="font-semibold text-slate-800 text-lg mb-0.5"><%= s.heading %></div>
        <% if (s.path) { %><div class="text-xs text-brand-600 font-medium mb-3 flex items-center gap-1.5"><%- icon('arrow-right', 'w-3 h-3') %> <%= s.path %></div><% } %>
        <div class="space-y-2.5 text-sm text-slate-600 leading-relaxed">
          <% s.body.forEach(p => { %><p><%= p %></p><% }) %>
        </div>
        <% if (s.tips && s.tips.length) { %>
          <div class="mt-4 pt-4 border-t border-slate-100 space-y-2">
            <% s.tips.forEach(t => { %>
              <div class="flex items-start gap-2 text-xs text-slate-500 bg-slate-50 rounded-xl p-2.5">
                <%- icon('check-circle', 'w-3.5 h-3.5 mt-0.5 text-brand-500 shrink-0') %>
                <span><%= t %></span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>
