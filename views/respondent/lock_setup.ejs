<%- include('../partials/header', { title: 'Set Up Your Lock — INICIO', user: null }) %>

<div class="max-w-md mx-auto">
  <div class="bg-white sm:rounded-2xl sm:border border-slate-200/70 sm:shadow-card p-6 text-center">
    <div class="w-16 h-16 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center mx-auto mb-4">
      <%- icon('shield', 'w-8 h-8') %>
    </div>
    <h1 class="text-lg font-bold text-slate-900 mb-1.5">Set up your device lock</h1>
    <p class="text-sm text-slate-500 mb-6 leading-relaxed">
      To keep your diary private, this study requires locking it behind your phone's own
      fingerprint, Face ID, or screen lock. Nothing changes about your diary link — this just
      makes sure only you can open it on this device.
    </p>

    <div id="lockSetupIdle">
      <button type="button" id="setupBtn" class="w-full inline-flex items-center justify-center gap-2 bg-brand-700 text-white rounded-xl py-3.5 font-semibold text-sm hover:bg-brand-600 transition shadow-card">
        <%- icon('shield', 'w-4 h-4') %> Set up now
      </button>
    </div>

    <div id="lockSetupChecking" class="text-sm text-slate-400">Checking your device…</div>

    <div id="lockSetupError" class="hidden mt-4 flex items-start gap-2 bg-red-50 text-red-700 text-sm rounded-xl p-3 border border-red-100 text-left">
      <%- icon('warning', 'w-4 h-4 mt-0.5 shrink-0') %>
      <span id="lockSetupErrorText">Something went wrong. Please try again.</span>
    </div>

    <div id="lockSetupUnsupported" class="hidden text-sm text-slate-400">This device doesn't support a fingerprint/Face ID lock — continuing without it…</div>

    <a href="/r/<%= respondent.unique_token %>/help" class="inline-flex items-center gap-1 text-xs font-medium text-slate-400 hover:text-brand-700 transition mt-5">
      <%- icon('help', 'w-3.5 h-3.5') %> Need help?
    </a>
  </div>
</div>

<script src="/public/js/simplewebauthn-browser.js"></script>
<script>
  (function () {
    var idleEl = document.getElementById('lockSetupIdle');
    var checkingEl = document.getElementById('lockSetupChecking');
    var errorEl = document.getElementById('lockSetupError');
    var errorTextEl = document.getElementById('lockSetupErrorText');
    var unsupportedEl = document.getElementById('lockSetupUnsupported');
    var setupBtn = document.getElementById('setupBtn');
    var next = <%- JSON.stringify(next) %>;
    var base = <%- JSON.stringify('/r/' + respondent.unique_token + '/lock') %>;

    function showError(msg) {
      idleEl.classList.add('hidden');
      checkingEl.classList.add('hidden');
      errorTextEl.textContent = msg;
      errorEl.classList.remove('hidden');
    }

    async function markExemptAndContinue() {
      try { await fetch(base + '/exempt', { method: 'POST' }); } catch (e) {}
      window.location.href = next;
    }

    async function init() {
      idleEl.classList.add('hidden');
      if (!window.SimpleWebAuthnBrowser || !window.SimpleWebAuthnBrowser.browserSupportsWebAuthn || !window.SimpleWebAuthnBrowser.browserSupportsWebAuthn()) {
        checkingEl.classList.add('hidden');
        unsupportedEl.classList.remove('hidden');
        return markExemptAndContinue();
      }
      var available = false;
      try { available = await window.SimpleWebAuthnBrowser.platformAuthenticatorIsAvailable(); } catch (e) {}
      checkingEl.classList.add('hidden');
      if (!available) {
        unsupportedEl.classList.remove('hidden');
        return markExemptAndContinue();
      }
      idleEl.classList.remove('hidden');
    }

    setupBtn.addEventListener('click', async function () {
      errorEl.classList.add('hidden');
      setupBtn.disabled = true;
      setupBtn.textContent = 'Waiting for your fingerprint/Face ID…';
      try {
        var optRes = await fetch(base + '/registration-options', { method: 'POST' });
        if (!optRes.ok) throw new Error('start-failed');
        var optionsJSON = await optRes.json();
        var attResp = await window.SimpleWebAuthnBrowser.startRegistration({ optionsJSON: optionsJSON });
        var verifyRes = await fetch(base + '/registration-verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(attResp),
        });
        var verifyJSON = await verifyRes.json();
        if (!verifyRes.ok || !verifyJSON.verified) throw new Error('verify-failed');
        window.location.href = next;
      } catch (e) {
        setupBtn.disabled = false;
        setupBtn.textContent = 'Try again';
        if (e && e.name === 'NotAllowedError') {
          showError('Cancelled or timed out. Tap "Set up now" and follow your device\'s fingerprint/Face ID prompt.');
        } else {
          showError('Could not set up your device lock. Please try again.');
        }
        idleEl.classList.remove('hidden');
      }
    });

    init();
  })();
</script>

<%- include('../partials/footer') %>
