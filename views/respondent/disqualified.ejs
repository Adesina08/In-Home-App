<%- include('../partials/header', { title: 'Study Ended — INICIO', user: null }) %>

<div class="max-w-md mx-auto">
  <div class="bg-white sm:rounded-2xl sm:border border-slate-200/70 sm:shadow-card p-6 text-center">
    <div class="w-16 h-16 rounded-2xl bg-slate-100 text-slate-500 flex items-center justify-center mx-auto mb-4">
      <%- icon('stop', 'w-8 h-8') %>
    </div>
    <h1 class="text-lg font-bold text-slate-900 mb-1.5">Your participation has ended</h1>
    <p class="text-sm text-slate-500 mb-1 leading-relaxed">
      Thanks for your time, <strong><%= respondent.name %></strong> — based on one of your answers, this study doesn't need anything further from you.
    </p>
    <p class="text-sm text-slate-500 mb-6 leading-relaxed">
      Your respondent code is <span class="font-mono text-slate-600"><%= respondent.respondent_code %></span>. If you think this is a mistake, please contact your interviewer.
    </p>

    <a href="/r/<%= respondent.unique_token %>/help" class="inline-flex items-center gap-1 text-xs font-medium text-slate-400 hover:text-brand-700 transition">
      <%- icon('help', 'w-3.5 h-3.5') %> Need help?
    </a>
  </div>
</div>

<%- include('../partials/footer') %>
