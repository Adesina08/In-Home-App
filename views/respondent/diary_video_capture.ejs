<%- include('../partials/header', { title: 'Record Video — INICIO', user: null, manifestUrl: '/r/' + respondent.unique_token + '/manifest.json' }) %>

<div class="max-w-2xl mx-auto pb-10">
  <div class="flex items-center justify-between mb-5 px-1">
    <div>
      <div class="text-brand-700 font-bold">INICIO</div>
      <div class="text-slate-500 text-sm"><%= study.name %></div>
    </div>
    <a href="/r/<%= respondent.unique_token %>/diary/new<%= practice ? '?practice=1' : '' %>" class="text-sm text-slate-400 hover:text-slate-600 shrink-0">← Change method</a>
  </div>

  <div class="bg-white sm:rounded-2xl sm:border border-slate-200/70 sm:shadow-card p-4 sm:p-6">
    <div class="w-12 h-12 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center mb-4"><%- icon('video', 'w-6 h-6') %></div>
    <h1 class="text-lg font-bold text-slate-900 mb-1.5">Record one video</h1>
    <p class="text-sm text-slate-500 mb-5 leading-relaxed">Show the product/brand and how much you're having. We'll review it and try to fill in what we can — you'll get a chance to check and complete everything before submitting.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flex items-start gap-2 bg-red-50 text-red-700 text-sm rounded-xl p-3 mb-4 border border-red-100">
        <%- icon('warning', 'w-4 h-4 mt-0.5') %>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/r/<%= respondent.unique_token %>/diary/analyze-video" enctype="multipart/form-data">
      <input type="hidden" name="practice" value="<%= practice ? '1' : '0' %>" />
      <label class="flex flex-col items-center gap-2 justify-center text-sm text-slate-500 border-2 border-dashed border-slate-300 rounded-xl px-4 py-10 hover:border-brand-300 hover:bg-slate-50 active:bg-slate-50 cursor-pointer transition mb-5">
        <%- icon('video', 'w-8 h-8 text-slate-400') %>
        <span id="videoFileLabel">Tap to record / choose a video</span>
        <input type="file" name="video" accept="video/*" capture="environment" required class="hidden" onchange="document.getElementById('videoFileLabel').textContent = this.files[0]?.name || 'Tap to record / choose a video'" />
      </label>
      <button type="submit" class="w-full inline-flex items-center justify-center gap-1.5 bg-brand-700 text-white rounded-xl py-3 font-semibold text-sm hover:bg-brand-600 transition shadow-card">
        <%- icon('arrow-right', 'w-4 h-4') %> Analyze Video &amp; Continue
      </button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
