<%- include('../partials/header', { title: 'Data Management — INICIO', user, currentPath: '/admin/data-management' }) %>
<%- include('../partials/page_header', { eyebrow:'Superadmin', title:'Data Management', subtitle:'Manage retention and permanently remove selected study data with an explicit audit trail.' }) %>
<% if (result) { %><div class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800"><%= result %></div><% } %>
<div class="grid grid-cols-1 xl:grid-cols-[280px_minmax(0,1fr)] gap-6">
  <aside class="console-panel h-fit"><div class="console-panel-heading"><h2>Studies</h2></div><div class="p-3 space-y-2"><% studies.forEach(item => { %><a class="block rounded-xl border p-3 <%= study&&item.id===study.id?'border-signal bg-signal-soft':'border-slate-200' %>" href="/admin/data-management?study=<%= item.id %>"><strong class="text-sm"><%= item.name %></strong><p class="text-xs text-slate-500"><%= item.market||'Market not set' %></p></a><% }) %></div></aside>
  <main class="space-y-6"><% if (study) { %>
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Respondents · <%= study.name %></h2><p>Search, filter and delete several enrolments in one controlled action.</p></div></div>
      <form method="get" class="console-toolbar"><input type="hidden" name="study" value="<%= study.id %>"><label class="console-search"><%- icon('search','w-4 h-4') %><input name="search" value="<%= search %>" placeholder="Name, contact or code"></label><select name="status" class="border rounded-xl px-3 py-2 text-sm"><option value="">All statuses</option><% ['invited','registered','training','active','activated','completed','withdrawn','disqualified'].forEach(value=>{ %><option <%= status===value?'selected':'' %>><%= value %></option><% }) %></select><button class="console-button">Apply</button></form>
      <form method="post" action="/admin/data-management/respondents/delete" id="bulkDelete"><input type="hidden" name="study_id" value="<%= study.id %>"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr><th class="px-5 py-3 text-left"><input type="checkbox" id="selectAll" aria-label="Select all filtered respondents"></th><th class="text-left">Respondent</th><th class="text-left">Contact</th><th class="text-left">Status</th><th class="pr-5 text-right">Privacy</th></tr></thead><tbody><% respondents.forEach(r=>{ %><tr class="border-t"><td class="px-5 py-3"><input type="checkbox" name="respondent_ids" value="<%= r.id %>" data-row-select></td><td><strong><%= r.name||'(no name)' %></strong><small class="block font-mono text-slate-400"><%= r.respondent_code %></small></td><td><%= r.contact||'—' %></td><td><span class="console-status"><%= r.activation_status %></span></td><td class="pr-5 text-right"><% if(!r.withdrawn_at){ %><button formmethod="post" formaction="/admin/data-management/respondents/<%= r.id %>/withdraw" class="text-xs text-signal">Withdraw</button><% } %></td></tr><% }) %><% if(!respondents.length){ %><tr><td colspan="5" class="p-8 text-center text-slate-400">No respondents match these filters.</td></tr><% } %></tbody></table></div>
        <div class="border-t p-4 flex flex-wrap items-center gap-3 bg-red-50"><strong id="selectionCount" class="text-sm text-red-800">0 selected</strong><input name="confirm" placeholder="Type DELETE" class="border border-red-300 rounded-xl px-3 py-2 text-sm"><button class="bg-red-600 text-white rounded-xl px-4 py-2 text-sm font-semibold" onclick="return confirm('Permanently delete every selected respondent and their linked data?')">Delete selected respondents</button></div>
      </form>
    </section>
    <section class="console-panel border-red-200"><div class="console-panel-heading"><div><h2>Delete study permanently</h2><p>Deletes the study, questionnaire, respondents, entries, evidence, consent and reporting configuration.</p></div></div><form method="post" action="/admin/superadmin/studies/<%= study.id %>/delete" class="p-5 flex gap-3"><input name="confirm" required placeholder="Type DELETE" class="flex-1 border border-red-300 rounded-xl px-3 py-2"><button class="bg-red-600 text-white rounded-xl px-4 py-2 font-semibold" onclick="return confirm('Permanently delete this study and all linked data?')">Delete entire study</button></form></section>
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Retention deletion due</h2><p>Only respondents due under this study’s configured retention period appear here.</p></div></div><div class="p-5 space-y-3"><% retention.forEach(r=>{ %><form method="post" action="/admin/data-management/respondents/<%= r.id %>/erase" class="flex gap-3 items-center"><span class="flex-1 text-sm"><strong><%= r.respondent_code %></strong> · <%= r.name||'Identity withheld' %></span><input name="confirm" placeholder="Type <%= r.respondent_code %>" class="border rounded-lg px-3 py-2 text-sm"><button class="console-button">Erase due participation</button></form><% }) %><% if(!retention.length){ %><p class="text-sm text-slate-500">No participation records are due.</p><% } %></div></section>
    <details class="console-panel"><summary class="p-5 font-semibold">Recent research audit events</summary><div class="p-5 pt-0 space-y-2"><% audit.forEach(event=>{ %><p class="text-xs"><%= event.created_at %> · <%= event.actor %> · <%= event.action %></p><% }) %></div></details>
  <% } else { %><div class="console-empty">No studies are available.</div><% } %></main>
</div>
<script>(function(){var all=document.getElementById('selectAll'), boxes=Array.from(document.querySelectorAll('[data-row-select]')), count=document.getElementById('selectionCount');function update(){var n=boxes.filter(function(box){return box.checked;}).length;count.textContent=n+' selected';if(all){all.checked=n===boxes.length&&n>0;all.indeterminate=n>0&&n<boxes.length;}}if(all)all.addEventListener('change',function(){boxes.forEach(function(box){box.checked=all.checked;});update();});boxes.forEach(function(box){box.addEventListener('change',update);});update();})();</script>
<%- include('../partials/footer') %>
