<%- include('../partials/header', { title: 'AI Summary — INICIO', user }) %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <div class="text-xs font-semibold text-brand-500 uppercase tracking-wide mb-0.5">Reporting</div>
    <h1 class="text-2xl font-bold text-slate-900">AI Summary</h1>
    <p class="text-slate-500 text-sm mt-1">A short written summary of validated diary data for a chosen period.</p>
  </div>
  <select onchange="window.location='/admin/ai-summary?study='+this.value"
          class="border border-slate-300 rounded-xl px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-400">
    <% studies.forEach(s => { %><option value="<%= s.id %>" <%= s.id===study.id?'selected':'' %>><%= s.name %></option><% }) %>
  </select>
</div>

<!-- Honest provider banner, matching Media Review's: never imply a model wrote
     something a template did. -->
<% if (aiConfigured) { %>
  <div class="flex items-start gap-2 bg-violet-50 border border-violet-200 text-violet-800 text-sm rounded-xl p-3.5 mb-5">
    <%- icon('check-circle', 'w-4 h-4 mt-0.5 shrink-0') %>
    <span>A real AI model is configured. Summaries below marked <strong>AI-generated</strong> were written by that model from the figures shown — always review before sharing.</span>
  </div>
<% } else { %>
  <div class="flex items-start gap-2 bg-amber-50 border border-amber-200 text-amber-800 text-sm rounded-xl p-3.5 mb-5">
    <%- icon('warning', 'w-4 h-4 mt-0.5 shrink-0') %>
    <span>
      No AI model is connected yet, so summaries are written from a <strong>fixed template</strong> using the same validated figures.
      They're accurate and safe to read, but they are not AI-written and are labelled accordingly.
      Set <code class="font-mono text-xs">AI_SUMMARY_PROVIDER=azure_openai</code> plus the Azure OpenAI credentials to switch on real narrative generation.
    </span>
  </div>
<% } %>

<% if (error) { %>
  <div class="flex items-start gap-2 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl p-3.5 mb-5">
    <%- icon('warning', 'w-4 h-4 mt-0.5 shrink-0') %><span><%= error %></span>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
  <!-- Generate -->
  <div class="bg-white rounded-2xl border border-slate-200/70 shadow-card p-5 h-fit">
    <div class="font-semibold text-slate-800 mb-1 flex items-center gap-2"><%- icon('plus', 'w-4 h-4 text-brand-500') %> New summary</div>
    <p class="text-xs text-slate-500 mb-4 leading-relaxed">Leave the dates blank to cover everything collected so far.</p>
    <form method="POST" action="/admin/ai-summary/generate" class="space-y-3.5 text-sm">
      <input type="hidden" name="study_id" value="<%= study.id %>" />
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">From</label>
        <input type="date" name="from" value="<%= from %>" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">To</label>
        <input type="date" name="to" value="<%= to %>" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition" />
      </div>
      <button class="w-full inline-flex items-center justify-center gap-1.5 bg-brand-700 text-white rounded-xl py-2.5 font-semibold text-sm hover:bg-brand-600 transition shadow-card">
        <%- icon('trend', 'w-4 h-4') %> Generate summary
      </button>
    </form>
    <div class="mt-4 pt-4 border-t border-slate-100 text-[11px] text-slate-400 leading-relaxed">
      Only <strong>submitted, non-practice</strong> entries are counted. Every figure is calculated by the app, not by the model —
      up to <%= openTextSampleSize %> open-text answers are included for context and stored with the summary.
    </div>
  </div>

  <!-- History -->
  <div class="lg:col-span-2 space-y-4">
    <% if (!summaries.length) { %>
      <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-10 text-center">
        <div class="flex flex-col items-center gap-2 text-slate-400">
          <%- icon('trend', 'w-7 h-7 text-slate-300') %>
          <span class="text-sm">No summaries yet for this study — generate the first one on the left.</span>
        </div>
      </div>
    <% } %>

    <% summaries.forEach(s => {
         const m = s.metrics_json ? JSON.parse(s.metrics_json) : null;
         const openText = s.open_text_json ? JSON.parse(s.open_text_json) : [];
         const isNew = String(s.id) === String(generated);
    %>
      <div class="bg-white rounded-2xl border <%= isNew ? 'border-brand-300 ring-2 ring-brand-100' : 'border-slate-200/70' %> shadow-card p-5">
        <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <% if (s.used_ai_model) { %>
                <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full bg-violet-100 text-violet-700">AI-generated</span>
              <% } else { %>
                <span class="text-[10px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">Rules-based draft — not AI</span>
              <% } %>
              <span class="text-[11px] text-slate-400 font-mono"><%= s.provider %><%= s.model ? ' · ' + s.model : '' %></span>
            </div>
            <div class="text-sm font-semibold text-slate-800">
              <%= s.period_start || s.period_end ? ((s.period_start || 'start') + ' → ' + (s.period_end || 'today')) : 'All data so far' %>
            </div>
            <div class="text-xs text-slate-500 mt-0.5">
              Base: <strong><%= s.base_records %></strong> submitted <%= s.base_records === 1 ? 'entry' : 'entries' %>
              from <strong><%= s.base_respondents %></strong> <%= s.base_respondents === 1 ? 'respondent' : 'respondents' %>
              · generated <%= s.generated_at %> by <%= s.generated_by %>
            </div>
          </div>
        </div>

        <div class="text-sm text-slate-700 leading-relaxed whitespace-pre-line bg-slate-50 border border-slate-200 rounded-xl p-4 mb-3"><%= s.narrative %></div>

        <details class="group">
          <summary class="text-xs font-semibold text-brand-600 cursor-pointer hover:underline list-none flex items-center gap-1.5">
            <%- icon('eye', 'w-3.5 h-3.5') %> Show the exact figures this was written from
          </summary>
          <div class="mt-3 space-y-3">
            <% if (m) { %>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                <% [
                     ['Submitted', m.base.submitted_records],
                     ['Contributors', m.base.contributing_respondents],
                     ['Completion', m.fieldwork.completion_rate_pct + '%'],
                     ['QC flag rate', m.quality.qc_flag_rate_pct + '%'],
                     ['Screened out', m.fieldwork.screened_out_records],
                     ['Green', m.quality.risk_green],
                     ['Amber', m.quality.risk_amber],
                     ['Red', m.quality.risk_red],
                   ].forEach(([label, value]) => { %>
                  <div class="bg-white border border-slate-200 rounded-lg px-3 py-2">
                    <div class="text-[10px] uppercase tracking-wide text-slate-400 font-semibold"><%= label %></div>
                    <div class="text-sm font-bold text-slate-800"><%= value %></div>
                  </div>
                <% }) %>
              </div>
              <% if (m.brands && m.brands.length) { %>
                <div class="text-xs text-slate-600"><span class="font-semibold">Top brands:</span> <%= m.brands.map(b => b.label + ' (' + b.n + ')').join(', ') %></div>
              <% } %>
              <% if (m.occasions && m.occasions.length) { %>
                <div class="text-xs text-slate-600"><span class="font-semibold">Top occasions:</span> <%= m.occasions.map(o => o.label + ' (' + o.n + ')').join(', ') %></div>
              <% } %>
              <div class="text-[11px] text-slate-400">Questionnaire version at generation: v<%= m.study.version || 1 %></div>
            <% } %>
            <% if (openText.length) { %>
              <div>
                <div class="text-xs font-semibold text-slate-600 mb-1.5"><%= openText.length %> open-text response<%= openText.length === 1 ? '' : 's' %> in the base</div>
                <div class="max-h-48 overflow-auto space-y-1.5">
                  <% openText.forEach(o => { %>
                    <div class="text-xs bg-white border border-slate-200 rounded-lg px-3 py-2">
                      <span class="text-slate-400"><%= o.question %>:</span> <span class="text-slate-700"><%= o.answer %></span>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>
        </details>
      </div>
    <% }) %>
  </div>
</div>

<%- include('../partials/footer') %>
