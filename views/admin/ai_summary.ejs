<%- include('../partials/header', { title: 'AI Summary — INICIO', user, currentPath: '/admin/ai-summary', studyPicker: { studies, current: study.id, action: '/admin/ai-summary?study=' } }) %>
<link rel="stylesheet" href="/public/reports.css" />
<link rel="stylesheet" href="/public/analysis.css" />
<script src="/public/js/reports.js" defer></script>
<div class="report-page">
  <div class="report-heading"><div><div class="report-kicker"><%= study.name %></div><h1>AI Summary</h1><p class="report-lead">Executive summary, key charts, respondent language and media in one clear view.</p></div><span class="report-badge"><%= aiConfigured ? aiProviderLabel + ' connected' : 'AI setup required' %></span></div>
  <% if (error) { %><div class="report-notice error" role="alert"><%= error %></div><% } %>
  <form class="report-toolbar" method="GET" action="/admin/ai-summary">
    <input type="hidden" name="study" value="<%= study.id %>" />
    <label>From<input type="date" name="from" value="<%= from %>" /></label><label>To<input type="date" name="to" value="<%= to %>" /></label>
    <button class="report-button secondary" type="submit">Apply period</button><a class="report-button secondary" href="/admin/ai-summary?study=<%= study.id %>">All dates</a>
    <span class="report-muted">Blank dates include all available data.</span>
  </form>
  <dl class="report-stats"><% [['Submitted entries',report.submitted,'Within this period'],['Contributors',report.contributors,'With submitted entries'],['Eligible media',report.media.length,'Photos, videos and voice notes'],['Written answers',report.openText.length,'Eligible for word frequency']].forEach(([label,value,note]) => { %><div class="report-stat"><dt><%= label %></dt><dd><%= value %></dd><dd class="report-stat-note"><%= note %></dd></div><% }) %></dl>
  <section class="report-panel">
    <div class="report-panel-head"><div><div class="report-kicker">Research story</div><h2>Executive summary</h2><p><%= from || 'Beginning of study' %> → <%= to || 'Latest available data' %></p></div>
      <form method="POST" action="/admin/ai-summary/generate" data-generate-summary><input type="hidden" name="study_id" value="<%= study.id %>" /><input type="hidden" name="from" value="<%= from %>" /><input type="hidden" name="to" value="<%= to %>" /><input type="hidden" name="force" value="1" /><button type="submit" class="report-button"><%= selected ? 'Generate updated summary' : 'Generate summary' %></button></form>
    </div>
    <% if (selected) { %>
      <span class="report-badge"><%= stale ? 'Update available' : 'Current ' + aiProviderLabel + ' draft · review before sharing' %></span>
      <div class="report-narrative"><%= selected.narrative %></div>
      <p class="report-muted" style="margin-top:20px">Saved <%= selected.generated_at %> · <%= selected.base_records %> submitted entries · <%= selected.base_respondents %> contributors.</p>
      <details><summary>View the saved figures and sampled answers</summary>
        <% let snapshot = null, sample = []; try { snapshot = JSON.parse(selected.metrics_json); sample = JSON.parse(selected.open_text_json || '[]'); } catch (_) {} %>
        <% if (snapshot && snapshot.base) { %><pre style="white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px"><%= JSON.stringify(snapshot, null, 2) %></pre><% } else { %><p class="report-muted">The saved metric snapshot is unavailable.</p><% } %>
        <% if (Array.isArray(sample)) sample.forEach(a => { %><blockquote style="margin-top:14px;font-size:13px"><strong><%= a.question %></strong><p><%= a.answer %></p></blockquote><% }) %>
      </details>
    <% } else { %><div class="report-empty">No saved summary for this period yet. Generate one from the study’s figures and up to <%= openTextSampleSize %> eligible written and transcribed responses.</div><% } %>
    <% if (!aiConfigured) { %><p class="report-muted" style="margin-top:16px">Connect Azure OpenAI or Gemini (AI_SUMMARY_PROVIDER) to generate summaries. The latest successful summary remains visible if the provider is unavailable.</p><% } %>
  </section>
  <%- include('../partials/questionnaire_dashboard', { questionnaireDashboard }) %>
  <%- include('../partials/report_dashboard_charts', { report }) %>
  <%- include('../partials/report_visuals', { report }) %>
  <details class="report-panel dashboard-extra ai-summary-more">
    <summary>More analysis and history</summary>
    <p class="report-muted">Study objectives, detailed brand results, themes, sentiment, demographic crosstabs and saved summary versions.</p>

  <div class="report-two">
    <section class="report-panel">
      <div class="report-panel-head"><div><div class="report-kicker">What respondents are saying</div><h2>Thematic analysis</h2><p>AI-read themes from the same written and transcribed sample as the summary.</p></div></div>
      <% if (selected && themes.length) { %>
        <div class="dashboard-table-scroll"><table class="report-table dashboard-table"><thead><tr><th scope="col">Theme</th><th scope="col">Mentions</th><th scope="col">Tone</th><th scope="col">Example</th></tr></thead><tbody>
          <% themes.forEach(t => { %><tr><th scope="row"><%= t.name %></th><td><%= t.mentions %> mention<%= t.mentions === 1 ? '' : 's' %> in the sample</td><td><span class="sentiment-badge <%= t.sentiment %>"><%= t.sentiment %></span></td><td><%= t.example || '—' %></td></tr><% }) %>
        </tbody></table></div>
      <% } else if (selected) { %><div class="report-empty">No themes were read from this period's response sample.</div>
      <% } else { %><div class="report-empty">Generate a summary to read thematic analysis from its open-text sample.</div><% } %>
      <p class="report-muted" style="margin-top:18px">Read from up to <%= openTextSampleSize %> sampled answers, not the full base. AI-generated — review before sharing.</p>
    </section>
    <section class="report-panel">
      <div class="report-panel-head"><div><div class="report-kicker">Tone of the sample</div><h2>Sentiment analysis</h2></div></div>
      <% if (selected && sentiment) { %>
        <%- include('../partials/report_bars', { items: [['positive','Positive'],['neutral','Neutral'],['negative','Negative']].map(([key,label]) => ({ label, n: sentiment[key] || 0 })), empty: 'No sentiment read for this period.' }) %>
        <p class="report-muted" style="margin-top:18px">Share of the sampled answers, not a statistical measure of the whole base. AI-generated — review before sharing.</p>
      <% } else if (selected) { %><div class="report-empty">No sentiment was read from this period's written sample.</div>
      <% } else { %><div class="report-empty">Generate a summary to read sentiment from its open-text sample.</div><% } %>
    </section>
  </div>
    <%- include('../partials/report_objectives', { objectiveGroups, configureUrl: '/admin/studies/' + study.id + '/kpis' }) %>
    <%- include('../partials/report_brand_table', { report }) %>
  <details class="report-panel dashboard-extra"><summary>View demographic crosstabs</summary>
    <div class="report-panel-head"><div><div class="report-kicker">Compare consumer groups</div><h2>Crosstab · <%= banners.questionLabel %></h2><p>Location, Gender and Age banners for one questionnaire question.</p></div></div>
    <form class="report-toolbar" method="GET" action="/admin/ai-summary" style="margin-bottom:6px">
      <input type="hidden" name="study" value="<%= study.id %>" /><input type="hidden" name="from" value="<%= from %>" /><input type="hidden" name="to" value="<%= to %>" />
      <label>Question<select name="question"><option value="">Automatic question</option><% banners.questions.forEach(q => { %><option value="<%= q.code %>" <%= q.code === banners.question ? 'selected' : '' %>><%= q.text %></option><% }) %></select></label>
      <button class="report-button secondary" type="submit">Apply</button>
    </form>
    <% Object.entries(bannerLabels).forEach(([key, label]) => { const b = banners.banners[key]; %>
      <h3 style="font-size:13px;font-weight:650;margin:24px 0 10px"><%= label %></h3>
      <% if (b.distribution.length) { %>
        <div class="analysis-scroll"><table class="report-table analysis-matrix">
          <thead><tr><th><%= label %></th><th>People</th><th>Occasions</th><% b.distribution.forEach(d => { %><th><%= d.label %></th><% }) %></tr></thead>
          <tbody><% b.crosstab.forEach(group => { %><tr><th><%= group.label %><% if (group.lowBase) { %><small class="analysis-low-base">Low base</small><% } %></th><td><%= group.respondents %></td><td><%= group.answered %></td><% group.cells.forEach(cell => { %><td><%= cell.pct === null ? '—' : cell.pct + '%' %></td><% }) %></tr><% }) %></tbody>
        </table></div>
      <% } else { %><div class="report-empty">No eligible answers for this selection.</div><% } %>
    <% }) %>
    <p class="report-muted" style="margin-top:16px">Percentages use answered occasions in each row; multi-select answers can total over 100%.</p>
  </details>
  <section class="report-panel"><div class="report-panel-head"><div><h2>Summary history</h2><p>Select a saved summary to view its period and narrative.</p></div></div>
    <% if (summaries.length) { %><div class="dashboard-table-scroll"><table class="report-table dashboard-table"><thead><tr><th scope="col">Period</th><th scope="col">Saved</th><th scope="col">Entries</th><th scope="col">Source</th><th scope="col">View</th></tr></thead><tbody><% summaries.forEach(s => { %><tr><td><%= s.period_start || 'Start' %> → <%= s.period_end || 'All data' %></td><td><%= s.generated_at %></td><td><%= s.base_records %></td><td><%= s.used_ai_model ? 'AI-generated' : 'Rules-based' %></td><td><a href="/admin/ai-summary?study=<%= study.id %>&summary=<%= s.id %>" <%- !!selected && selected.id === s.id ? 'aria-current="page"' : '' %>>View summary</a></td></tr><% }) %></tbody></table></div><% } else { %><p class="report-muted">Generated summaries will be saved here.</p><% } %>
  </section>
  </details>
</div>
<% if (stale && aiConfigured && !error) { %><script>
document.addEventListener('DOMContentLoaded', async function () {
  const form = document.querySelector('[data-generate-summary]'); if (!form) return;
  const button = form.querySelector('button'); button.disabled = true; button.textContent = 'Generating with <%= aiProviderLabel %>…';
  const body = new URLSearchParams(new FormData(form)); body.set('force', '0');
  try { const response = await fetch(form.action, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'}, body }); const data = await response.json(); if (!response.ok) throw new Error(data.error); location.href = '/admin/ai-summary?study=<%= study.id %>&from=<%= encodeURIComponent(from) %>&to=<%= encodeURIComponent(to) %>&generated=' + data.id; }
  catch (error) { button.disabled = false; button.textContent = 'Retry <%= aiProviderLabel %> summary'; const notice = document.createElement('div'); notice.className='report-notice error'; notice.textContent=error.message || '<%= aiProviderLabel %> could not generate the summary.'; form.closest('.report-panel').prepend(notice); }
});
</script><% } %>
<%- include('../partials/footer') %>
