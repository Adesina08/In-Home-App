<%- include('../partials/header', { title: 'Questionnaire — INICIO Diary', user: user, currentPath: '/admin/studies' }) %>
<%- include('../partials/study_tabs', { study: study, tab: 'questionnaire' }) %>
<% const hasDraft = ![0, false, '0', null, undefined].includes(study.questionnaire_dirty); %>

<%#
  Questionnaire builder — rebuilt.

  The screen it replaces was 1,021 lines doing three jobs at once: listing and
  ordering questions, editing one question, and defining logic across
  questions. Everything lived in one scrolling column of expandable cards, so
  editing question 40 meant scrolling past 39 others, and the logic rules were
  scattered across the cards they happened to attach to — impossible to audit
  as a set.

  Split into three panes with one job each:
    left   — the questionnaire as an ordered list. Reorder, jump, add.
    centre — exactly one question, always fully expanded. No accordion.
    right  — logic, as sentences, for the whole study in one place.

  Every endpoint, payload and field name is unchanged. This is a structural and
  visual rebuild, not a behavioural one.
%>

<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
  <div>
    <h1 class="font-display text-2xl font-bold text-slate-900 tracking-tight">Questionnaire</h1>
    <div class="font-mono text-xs text-slate-500 mt-1">
      <span id="qCount"><%= questions.length %></span> questions ·
      <span id="rCount"><%= rules.length %></span> logic rules ·
      Published v<%= study.version || 1 %>
      <span id="draftState" class="text-unverified font-semibold <%= hasDraft ? '' : 'hidden' %>">· Draft changes saved</span>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <a href="/admin/studies/<%= study.id %>/questionnaire/template.xlsx" class="inline-flex items-center gap-1.5 bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-medium hover:bg-slate-50 transition">Download template</a>
    <a href="/admin/studies/<%= study.id %>/questionnaire/upload"
       class="inline-flex items-center gap-1.5 bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-medium hover:bg-slate-50 transition"><%- icon('upload', 'w-4 h-4') %> Import</a>
    <button type="button" id="openPreview" class="inline-flex items-center gap-1.5 bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-medium hover:bg-slate-50 transition"><%- icon('eye', 'w-4 h-4') %>Preview draft</button>
    <form id="publishForm" method="POST" action="/admin/studies/<%= study.id %>/questionnaire/publish" class="<%= hasDraft ? '' : 'hidden' %>">
      <button class="inline-flex items-center gap-1.5 bg-signal text-white rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-signal-bright transition"><%- icon('check', 'w-4 h-4') %> Publish v<%= (study.version || 1) + 1 %></button>
    </form>
  </div>
</div>

<%# Draft edits are autosaved but isolated from the immutable published
    snapshot until Publish is pressed. Keep that state visible rather than
    making the researcher infer it from a transient toast. %>
<div id="draftBanner" class="<%= hasDraft ? 'flex' : 'hidden' %> items-start gap-2.5 bg-unverified-soft border border-unverified/30 rounded-xl px-4 py-3 mb-4 text-sm text-unverified">
  <%- icon('warning', 'w-4 h-4 shrink-0 mt-0.5') %>
  <div><strong>Draft changes are saved.</strong> Respondents are still answering published <strong>v<%= study.version || 1 %></strong>. Use Preview draft to test these changes, then publish when ready.</div>
</div>
<% if (published && published !== 'none') { %>
  <div class="flex items-start gap-2.5 bg-verified-soft border border-verified/30 rounded-xl px-4 py-3 mb-4 text-sm text-verified">
    <span class="font-semibold">✓</span>
    <div>Questionnaire <strong>v<%= published %></strong> is now published. The previous version remains preserved in version history.</div>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)] gap-4 items-start console-questionnaire-v2">

  <!-- ============ LEFT: the questionnaire as a list ============ -->
  <div class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow overflow-hidden">
    <div class="px-4 pt-4 pb-2 font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Questions</div>
    <div id="qList" class="pb-2 max-h-[70vh] overflow-y-auto"></div>
    <div class="px-3 pb-3 pt-1 border-t border-slate-100">
      <button id="addQuestion" class="w-full text-left px-2.5 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50 transition inline-flex items-center gap-1.5"><%- icon('plus', 'w-4 h-4') %> Add question</button>
      <button id="addSection" class="w-full text-left px-2.5 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50 transition inline-flex items-center gap-1.5"><%- icon('plus', 'w-4 h-4') %> Add section</button>
    </div>
  </div>

  <!-- ============ CENTRE: one question, fully expanded ============ -->
  <div id="editor" class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow p-5 min-h-[420px]"></div>

</div>

<details class="console-panel mt-5"><summary class="console-panel-heading cursor-pointer"><div><h2>Repeated questions, screener & close-out</h2><p>Configure instrument-wide behavior without leaving the questionnaire.</p></div></summary><div class="grid grid-cols-1 xl:grid-cols-2 gap-5 p-5"><form method="post" action="/admin/studies/<%= study.id %>/research/loop" class="space-y-3"><h3 class="font-semibold">Repeat a question</h3><label class="block text-xs text-slate-500">Question<select name="question_id" required class="mt-1 w-full border rounded-xl p-2 bg-white"><% activeQuestions.filter(function(q){return !q.loop_source_id;}).forEach(function(q){ %><option value="<%= q.id %>"><%= q.code || ('q'+q.id) %> · <%= q.text %></option><% }) %></select></label><label class="block text-xs text-slate-500">Repeat for<select name="kind" class="mt-1 w-full border rounded-xl p-2 bg-white"><option value="product">Products</option><option value="member">Household members</option></select></label><label class="block text-xs text-slate-500">Items, one per line<textarea name="items" rows="5" required class="mt-1 w-full border rounded-xl p-2"></textarea></label><button class="console-button is-primary">Create repeated questions</button></form><form method="post" action="/admin/studies/<%= study.id %>/research/instrument" class="space-y-3"><h3 class="font-semibold">Eligibility and completion</h3><label class="block text-xs text-slate-500">Screener JSON<textarea name="screener_questions" rows="7" class="mt-1 w-full font-mono text-xs border rounded-xl p-2"><%= JSON.stringify(study.screener_questions || [], null, 2) %></textarea></label><label class="block text-xs text-slate-500">Close-out JSON<textarea name="close_out_questions" rows="5" class="mt-1 w-full font-mono text-xs border rounded-xl p-2"><%= JSON.stringify(study.close_out_questions || [], null, 2) %></textarea></label><button class="console-button is-primary">Save screener and close-out</button></form></div></details>

<dialog id="respondentPreview" class="w-[min(1100px,96vw)] h-[92vh] rounded-2xl p-0 backdrop:bg-slate-900/60">
  <div class="h-full flex flex-col"><div class="flex items-center justify-between gap-3 p-4 border-b bg-white"><div><strong>Respondent preview</strong><p class="text-xs text-slate-500">Switch size without leaving the questionnaire.</p></div><div class="flex gap-2"><button type="button" data-preview-width="390" class="console-button">Mobile</button><button type="button" data-preview-width="desktop" class="console-button">Desktop</button><button type="button" id="closePreview" class="console-button">Close</button></div></div><div class="flex-1 overflow-auto bg-slate-100 p-4 flex justify-center"><iframe id="previewFrame" title="Respondent questionnaire preview" class="h-full bg-white border-0 rounded-xl shadow-xl transition-all" style="width:390px" data-src="/admin/studies/<%= study.id %>/questionnaire/live-preview?embed=1"></iframe></div></div>
</dialog>

<div id="saveToast" class="fixed bottom-5 right-5 bg-slate-900 text-white text-xs font-medium px-3.5 py-2 rounded-lg opacity-0 transition-opacity pointer-events-none">Saved</div>

<script src="/public/js/skip-logic.js"></script>
<script>
(function () {
  var STUDY_ID = <%= study.id %>;
  var questions = <%- JSON.stringify(questions) %>;
  var rules = <%- JSON.stringify(rules) %>;
  var selectedId = questions.length ? questions[0].id : null;

  // Which question types the video extractor can pre-fill. Mirrors
  // lib/videoPrompts.js exactly: single and multi select WITH options. Shown in
  // the editor because an admin writing a questionnaire for video mode
  // otherwise has no way to know which of their questions the teleprompter
  // will put on screen.
  var AI_FILLABLE = ['single', 'multi'];

  var TYPES = [
    ['single', 'Single select'], ['multi', 'Multi select'], ['numeric', 'Number'],
    ['text', 'Short text'], ['longtext', 'Long text'], ['date', 'Date'],
    ['time', 'Time'], ['photo', 'Photo'], ['video', 'Video'], ['audio', 'Audio'],
  ];
  var OPS = { equals: 'is', not_equals: 'is not', in: 'is one of', not_in: 'is none of', includes: 'includes', gt: 'is greater than', gte: 'is at least', lt: 'is less than', lte: 'is at most' };
  // The logic types, named as QuestionPro names them.
  var LOGIC_TABS = [['skip', 'Skip Logic'], ['compound', 'Compound Branching'], ['showhide', 'Show/Hide Question'], ['scoring', 'Scoring'], ['custom', 'JavaScript Logic (expressions)'], ['variables', 'Update Variables']];
  var logicTab = 'skip';

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  async function api(method, url, body) {
    var res = await fetch(url, {
      method: method,
      headers: Object.assign({ 'X-Requested-With': 'XMLHttpRequest' }, body !== undefined ? { 'Content-Type': 'application/json' } : {}),
      body: body !== undefined ? JSON.stringify(body) : undefined,
    });
    var data = await res.json().catch(function () { return {}; });
    if (!res.ok) throw new Error(data.error || 'Something went wrong saving that.');
    return data;
  }

  var toast = document.getElementById('saveToast');
  function markDraftVisible() {
    var state = document.getElementById('draftState');
    var banner = document.getElementById('draftBanner');
    var publish = document.getElementById('publishForm');
    if (state) state.classList.remove('hidden');
    if (banner) { banner.classList.remove('hidden'); banner.classList.add('flex'); }
    if (publish) publish.classList.remove('hidden');
  }
  function saved(msg) {
    markDraftVisible();
    toast.textContent = msg || 'Saved';
    toast.classList.remove('opacity-0');
    clearTimeout(toast._t);
    toast._t = setTimeout(function () { toast.classList.add('opacity-0'); }, 1400);
  }
  function fail(e) { toast.textContent = e.message; toast.classList.remove('opacity-0'); }

  function optionsOf(q) {
    var raw = q.options_json !== undefined ? q.options_json : q.options;
    if (Array.isArray(raw)) return raw;
    try { var p = JSON.parse(raw || '[]'); return Array.isArray(p) ? p : []; } catch (e) { return []; }
  }
  function specifyOptions(q) { try { var p=JSON.parse(q.other_specify_options_json||'[]'); return Array.isArray(p)?p:[]; } catch(e){ return []; } }
  function exclusiveOptions(q) { if (q.type !== 'multi') return []; try { var p=JSON.parse(q.exclusive_options_json||'[]'); return Array.isArray(p)?p:[]; } catch(e){ return []; } }
  // One dropdown carries both flags: terminate (ends participation) and
  // exclusive (multi-select only -- ticking it clears every other option).
  function behaviourSelect(q, o) {
    var term = terminationFor(q.id, o), excl = exclusiveOptions(q).indexOf(o) > -1;
    var value = excl ? (term ? 'exclusive_study' : 'exclusive') : (term ? 'study' : '');
    var choices = [['', 'Continue'], ['study', 'Terminate']];
    if (q.type === 'multi') choices.push(['exclusive', 'Exclusive'], ['exclusive_study', 'Exclusive + Terminate']);
    return '<select class="opt-terminate border border-slate-300 rounded-lg px-2 py-1.5 text-xs" data-option="'+esc(o)+'" title="Exclusive: picking this option clears every other selected option">' +
      choices.map(function(c){ return '<option value="'+c[0]+'"'+(c[0]===value?' selected':'')+'>'+c[1]+'</option>'; }).join('') + '</select>';
  }
  function terminationFor(qid, option) { return rules.some(function(r){ return r.action==='terminate' && Number(r.condition_question_id)===Number(qid) && r.operator==='equals' && r.value===option; }); }
  function canAiFill(q) { return AI_FILLABLE.indexOf(q.type) > -1 && optionsOf(q).length > 0; }

  // ---------- left pane ----------
  function renderList() {
    var wrap = document.getElementById('qList');
    var lastSection = null;
    var html = '';
    questions.forEach(function (q, i) {
      if (q.section !== lastSection) {
        lastSection = q.section;
        html += '<div class="px-4 pt-3 pb-1 font-mono text-[10px] uppercase tracking-[0.09em] text-slate-400">' + esc(q.section || 'No section') + '</div>';
      }
      html += '<button class="q-item w-full text-left flex items-baseline gap-2.5 px-4 py-2 hover:bg-slate-50 transition ' +
        (q.id === selectedId ? 'bg-brand-50 shadow-[inset_2px_0_0_var(--tw-color-brand,#1F3864)]' : '') + '" data-id="' + q.id + '" draggable="true">' +
        '<span class="font-mono text-[10px] text-slate-400 tabular-nums">' + String(i + 1).padStart(2, '0') + '</span>' +
        '<span class="text-[13px] leading-snug ' + (q.id === selectedId ? 'font-semibold text-slate-900' : 'text-slate-600') + ' truncate">' +
        esc(q.text || '(untitled)') + '</span></button>';
    });
    wrap.innerHTML = html || '<div class="px-4 py-6 text-sm text-slate-400">No questions yet.</div>';
    document.getElementById('qCount').textContent = questions.length;
  }

  // ---------- centre pane ----------
  function renderEditor() {
    var el = document.getElementById('editor');
    var q = questions.filter(function (x) { return x.id === selectedId; })[0];
    if (!q) {
      el.innerHTML = '<div class="text-center py-16"><div class="font-display text-lg font-bold text-slate-800">No question selected</div>' +
        '<div class="text-sm text-slate-500 mt-1">Add your first question to start building.</div></div>';
      return;
    }
    var opts = optionsOf(q);
    var typeOpts = TYPES.map(function (t) {
      return '<option value="' + t[0] + '"' + (q.type === t[0] ? ' selected' : '') + '>' + t[1] + '</option>';
    }).join('');

    el.innerHTML =
      '<div class="flex items-start justify-between gap-3 mb-4">' +
        '<div class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Editing question</div>' +
        '<button id="delQ" class="text-xs text-red-600 hover:underline">Delete</button>' +
      '</div>' +
      '<textarea id="fText" rows="2" class="w-full font-display text-xl font-bold tracking-tight text-slate-900 border-0 border-b-2 border-slate-200 focus:border-signal focus:ring-0 px-0 pb-2 resize-none" placeholder="Ask a question…">' + esc(q.text || '') + '</textarea>' +
      '<div class="grid grid-cols-2 gap-3 mt-4">' +
        '<label class="block"><span class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Type</span>' +
          '<select id="fType" class="mt-1 w-full border border-slate-300 rounded-lg px-2.5 py-2 text-sm bg-white">' + typeOpts + '</select></label>' +
        '<label class="block"><span class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Section</span>' +
          '<input id="fSection" value="' + esc(q.section || '') + '" class="mt-1 w-full border border-slate-300 rounded-lg px-2.5 py-2 text-sm" placeholder="e.g. Screening" /></label>' +
      '</div>' +
      '<div class="grid grid-cols-2 gap-3 mt-3">' +
        '<label class="block"><span class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Code</span>' +
          '<input id="fCode" value="' + esc(q.code || '') + '" class="mt-1 w-full font-mono border border-slate-300 rounded-lg px-2.5 py-2 text-sm" /></label>' +
        '<label class="flex items-center gap-2 mt-6"><input type="checkbox" id="fRequired" ' + (q.required ? 'checked' : '') + ' class="h-4 w-4 rounded border-slate-300 accent-signal" />' +
          '<span class="text-sm text-slate-700">Required</span></label>' +
      '</div>' +
      (q.type === 'multi' ?
        '<div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-3">' +
          '<label class="block"><span class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Maximum selections</span>' +
          '<input id="fMaxSelections" type="number" min="1" max="100" step="1" value="' + esc(q.max_selections || '') + '" class="mt-1 w-36 border border-slate-300 rounded-lg px-2.5 py-2 text-sm bg-white" placeholder="No limit" /></label>' +
          '<p class="text-xs text-slate-500 mt-1.5">Leave blank for no limit. Set 4 to show and enforce “Select up to 4”.</p>' +
        '</div>' : '') +
      (q.type === 'numeric' ?
        '<div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-3">' +
          '<div class="grid grid-cols-3 gap-3">' +
            '<label class="block"><span class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Minimum</span>' +
            '<input id="fMin" type="number" step="any" value="' + esc(q.min_value ?? '') + '" class="mt-1 w-full border border-slate-300 rounded-lg px-2.5 py-2 text-sm bg-white" placeholder="No minimum" /></label>' +
            '<label class="block"><span class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Maximum</span>' +
            '<input id="fMax" type="number" step="any" value="' + esc(q.max_value ?? '') + '" class="mt-1 w-full border border-slate-300 rounded-lg px-2.5 py-2 text-sm bg-white" placeholder="No maximum" /></label>' +
            '<label class="block"><span class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Round to</span>' +
            '<input id="fStep" type="number" step="any" min="0" value="' + esc(q.step_value ?? '') + '" class="mt-1 w-full border border-slate-300 rounded-lg px-2.5 py-2 text-sm bg-white" placeholder="Any value" /></label>' +
          '</div>' +
          '<p class="text-xs text-slate-500 mt-1.5">“Round to” rejects anything not a multiple of it — set 10 so a price question refuses 761 but accepts 760.</p>' +
        '</div>' : '') +
      (AI_FILLABLE.indexOf(q.type) > -1 ?
        '<div class="mt-5"><div class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500 mb-2">Options</div>' +
        '<div id="optList" class="space-y-1.5"></div>' +
        '<button type="button" id="addOpt" class="mt-2 text-xs text-signal font-medium hover:underline">+ Add option</button></div>' : '') +
      '<div class="mt-5 pt-4 border-t border-slate-100">' +
        '<div class="flex items-center justify-between gap-3 mb-2"><div class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500">Logic</div>' +
        '<select id="logicTab" class="border border-slate-300 rounded-lg px-2 py-1.5 text-xs bg-white">' + LOGIC_TABS.map(function (t) { return '<option value="' + t[0] + '"' + (t[0] === logicTab ? ' selected' : '') + '>' + t[1] + '</option>'; }).join('') + '</select></div>' +
        '<div id="logicBody" class="text-xs space-y-2"></div>' +
        '<div class="font-mono text-[10px] uppercase tracking-[0.09em] text-slate-500 mt-4 mb-2">Rules on this question</div><div id="ruleList" class="space-y-2"></div></div>' +
      '<div class="mt-5 pt-4 border-t border-slate-100">' +
        (canAiFill(q)
          ? '<div class="flex items-start gap-2 text-xs font-medium text-verified bg-verified-soft rounded-lg px-3 py-2.5">' +
            '<span>✓</span><span>Video AI can fill this. It appears on the teleprompter during recording, and answers arrive marked unconfirmed for a researcher to check.</span></div>'
          : '<div class="flex items-start gap-2 text-xs text-slate-500 bg-slate-50 rounded-lg px-3 py-2.5">' +
            '<span>—</span><span>Video AI cannot fill this ' + (AI_FILLABLE.indexOf(q.type) > -1 ? 'until it has options' : 'question type') + ', so it is left off the teleprompter and asked on the form instead.</span></div>') +
      '</div>';

    if (AI_FILLABLE.indexOf(q.type) > -1) renderOptions(q, opts);
    wireEditor(q);
    renderRules(q);
  }

  function renderOptions(q, opts) {
    var host = document.getElementById('optList');
    if (!host) return;
    var specify = specifyOptions(q);
    host.innerHTML = opts.map(function (o, i) {
      return '<div class="grid grid-cols-[20px_20px_minmax(140px,1fr)_170px_auto_auto] items-center gap-2">' +
        '<span class="font-mono text-[10px] text-slate-400 w-4 text-right tabular-nums">' + (i + 1) + '</span>' +
        '<div class="flex flex-col leading-none">' +
          '<button type="button" class="opt-up text-slate-400 hover:text-slate-700 disabled:opacity-25 disabled:hover:text-slate-400 text-[10px] px-0.5" data-i="' + i + '" ' + (i === 0 ? 'disabled' : '') + ' title="Move up">&#9650;</button>' +
          '<button type="button" class="opt-down text-slate-400 hover:text-slate-700 disabled:opacity-25 disabled:hover:text-slate-400 text-[10px] px-0.5" data-i="' + i + '" ' + (i === opts.length - 1 ? 'disabled' : '') + ' title="Move down">&#9660;</button>' +
        '</div>' +
        '<input class="opt-in flex-1 border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm" value="' + esc(o) + '" data-i="' + i + '" />' +
        behaviourSelect(q, o)+
        '<label class="text-[11px] text-slate-600 whitespace-nowrap"><input type="checkbox" class="opt-specify" data-option="'+esc(o)+'" '+(specify.indexOf(o)>-1?'checked':'')+' /> Other text</label>'+
        '<button type="button" class="opt-del text-slate-400 hover:text-red-600 text-sm px-1" data-i="' + i + '">&times;</button></div>';
    }).join('') || '<div class="text-xs text-slate-400">No options yet — this question cannot be answered until it has some.</div>';

    host.querySelectorAll('.opt-in').forEach(function (inp) {
      inp.addEventListener('change', function () {
        var next = optionsOf(q).slice();
        next[Number(inp.dataset.i)] = inp.value;
        patch(q.id, { options: next });
      });
    });
    host.querySelectorAll('.opt-del').forEach(function (b) {
      b.addEventListener('click', function () {
        var next = optionsOf(q).slice();
        next.splice(Number(b.dataset.i), 1);
        patch(q.id, { options: next });
      });
    });
    function moveOption(i, delta) {
      var next = optionsOf(q).slice();
      var j = i + delta;
      if (j < 0 || j >= next.length) return;
      var tmp = next[i]; next[i] = next[j]; next[j] = tmp;
      patch(q.id, { options: next });
    }
    host.querySelectorAll('.opt-up').forEach(function (b) {
      b.addEventListener('click', function () { moveOption(Number(b.dataset.i), -1); });
    });
    host.querySelectorAll('.opt-down').forEach(function (b) {
      b.addEventListener('click', function () { moveOption(Number(b.dataset.i), 1); });
    });
    function saveBehaviour(option) { var term=host.querySelector('.opt-terminate[data-option="'+CSS.escape(option)+'"]'); var specifyBox=host.querySelector('.opt-specify[data-option="'+CSS.escape(option)+'"]'); api('POST','/admin/studies/'+STUDY_ID+'/questions/'+q.id+'/option-behaviour',{option:option,terminate_scope:term&&/study$/.test(term.value)?'study':'',exclusive:!!(term&&/^exclusive/.test(term.value)),allows_specify:!!(specifyBox&&specifyBox.checked)}).then(function(data){ q.other_specify_options_json=data.question.other_specify_options_json; q.exclusive_options_json=data.question.exclusive_options_json; rules=rules.filter(function(r){return !(r.action==='terminate'&&Number(r.condition_question_id)===Number(q.id)&&r.operator==='equals'&&r.value===option);}); if(data.rule) rules.push(data.rule); renderEditor(); saved('Option behaviour saved'); }).catch(fail); }
    host.querySelectorAll('.opt-terminate').forEach(function(el){el.addEventListener('change',function(){saveBehaviour(el.dataset.option);});});
    host.querySelectorAll('.opt-specify').forEach(function(el){el.addEventListener('change',function(){saveBehaviour(el.dataset.option);});});
    var add = document.getElementById('addOpt');
    if (add) add.onclick = function () { patch(q.id, { options: optionsOf(q).concat(['New option']) }); };
  }

  function wireEditor(q) {
    function on(id, ev, fn) { var e = document.getElementById(id); if (e) e.addEventListener(ev, fn); }
    on('fText', 'change', function (e) { patch(q.id, { text: e.target.value }); });
    on('fType', 'change', function (e) { patch(q.id, { type: e.target.value }); });
    on('fSection', 'change', function (e) { patch(q.id, { section: e.target.value }); });
    on('fCode', 'change', function (e) { patch(q.id, { code: e.target.value }); });
    on('fRequired', 'change', function (e) { patch(q.id, { required: e.target.checked ? 1 : 0 }); });
    on('fMaxSelections', 'change', function (e) { patch(q.id, { max_selections: e.target.value === '' ? null : Number(e.target.value) }); });
    on('fMin', 'change', function (e) { patch(q.id, { min_value: e.target.value === '' ? null : Number(e.target.value) }); });
    on('fMax', 'change', function (e) { patch(q.id, { max_value: e.target.value === '' ? null : Number(e.target.value) }); });
    on('fStep', 'change', function (e) { patch(q.id, { step_value: e.target.value === '' ? null : Number(e.target.value) }); });
    on('delQ', 'click', async function () {
      if (!confirm('Delete this question? Answers already collected against it are kept.')) return;
      try {
        await api('POST', '/admin/studies/' + STUDY_ID + '/questionnaire/' + q.id + '/delete');
        questions = questions.filter(function (x) { return x.id !== q.id; });
        selectedId = questions.length ? questions[0].id : null;
        renderList(); renderEditor(); saved('Question deleted');
      } catch (e) { fail(e); }
    });
  }

  async function patch(id, body) {
    try {
      var updated = await api('PATCH', '/admin/studies/' + STUDY_ID + '/questions/' + id, body);
      // The API returns the canonical stored question. Use it so option edits
      // update options_json (the field optionsOf() renders) instead of merging
      // the request's differently named `options` field and redrawing stale
      // options immediately after a successful save.
      var savedQuestion = updated.question || updated;
      questions = questions.map(function (q) {
        return q.id === id ? Object.assign({}, q, savedQuestion) : q;
      });
      renderList(); renderEditor(); saved();
    } catch (e) { fail(e); }
  }

  // ---------- logic panel ----------
  function questionLabel(qid) {
    var idx = questions.findIndex(function (q) { return Number(q.id) === Number(qid); });
    if (idx < 0) return '(deleted question)';
    return 'Q' + (idx + 1) + ' ' + (questions[idx].text || '(untitled)');
  }
  function variableNames() {
    var names = {};
    rules.forEach(function (r) { if (r.action === 'set_variable' && r.variable_name) names[r.variable_name] = true; });
    return Object.keys(names).sort();
  }
  function isChoice(q) { return q.type === 'single' || q.type === 'multi'; }
  function laterQuestions(q) {
    var idx = questions.findIndex(function (x) { return x.id === q.id; });
    return questions.slice(idx + 1);
  }
  function jumpSelect(cls, q, selected, blankLabel, attrs) {
    return '<select class="' + cls + ' w-full border border-slate-300 rounded-lg px-2 py-1.5 bg-white" ' + (attrs || '') + '>' +
      '<option value="">' + blankLabel + '</option>' +
      laterQuestions(q).map(function (x) { return '<option value="' + x.id + '"' + (String(selected) === String(x.id) ? ' selected' : '') + '>Jump to ' + esc(questionLabel(x.id)) + '</option>'; }).join('') +
      '<option value="end"' + (selected === 'end' ? ' selected' : '') + '>End of survey</option></select>';
  }
  function isOptionRule(r, q) { return Number(r.source_question_id) === Number(q.id) && !r.conditions_json && (r.action === 'skip_to' || r.action === 'set_variable'); }
  function scoresOf(q) { try { var m = JSON.parse(q.option_scores_json || '{}'); return m && typeof m === 'object' ? m : {}; } catch (e) { return {}; } }

  // The per-option table state, read from the saved rules so each tab posts
  // the whole table and never wipes another tab's settings.
  function optionLogic(q) {
    var state = { jumps: {}, default_jump: '', variables: {}, scores: scoresOf(q) };
    rules.forEach(function (r) {
      if (!isOptionRule(r, q)) return;
      var dest = r.skip_to_end ? 'end' : String(r.target_question_id || '');
      if (r.action === 'skip_to' && r.is_default) state.default_jump = dest;
      else if (r.action === 'skip_to') state.jumps[r.value] = dest;
      else state.variables[r.value] = { name: r.variable_name, value: r.variable_value === r.value ? '' : r.variable_value };
    });
    return state;
  }
  async function saveOptionLogic(q, state, message) {
    try {
      var data = await api('POST', '/admin/studies/' + STUDY_ID + '/questions/' + q.id + '/option-logic', state);
      q.option_scores_json = data.question.option_scores_json;
      rules = data.rules;
      renderEditor(); saved(message);
    } catch (e) { fail(e); }
  }

  function renderRules(currentQuestion) {
    var host = document.getElementById('ruleList');
    if (!host || !currentQuestion) return;
    var q = currentQuestion;
    var visible = rules.filter(function (r) {
      if (r.action === 'terminate') return Number(r.condition_question_id) === Number(q.id);
      if (r.action === 'skip_to' || r.action === 'set_variable') return Number(r.source_question_id) === Number(q.id);
      return Number(r.target_question_id) === Number(q.id);
    });
    host.innerHTML = visible.map(function (r) {
      var described = SkipLogic.describeConditions(r, questionLabel, OPS);
      var conditionsHtml = described.parts.map(function (p) {
        return '<strong>' + esc(p.question) + '</strong> ' + esc(p.operator) + ' <strong>' + esc(p.value) + '</strong>';
      }).join(' <span class="font-mono text-[10px] uppercase text-signal">' + described.joiner + '</span> ');
      var outcome = r.action === 'terminate' ? (r.terminate_scope === 'study' ? 'end participation' : 'end this entry')
        : r.action === 'show' ? 'show this question'
        : r.action === 'hide' ? 'hide this question'
        : r.action === 'skip_to' ? (r.skip_to_end ? 'jump to the end of the survey' : 'jump to <strong>' + esc(questionLabel(r.target_question_id)) + '</strong>')
        : 'set <strong>' + esc(r.variable_name) + '</strong> = <strong>' + esc(r.variable_value) + '</strong>';
      var lead = r.is_default ? 'Otherwise (default branch), ' : 'If ' + conditionsHtml + ', ';
      return '<div class="group border-l-2 border-signal bg-brand-50/50 pl-2.5 pr-1.5 py-1.5 rounded-r text-[12px] leading-snug text-slate-700">' +
        lead + outcome + '.' +
        '<button class="rule-del float-right text-slate-300 group-hover:text-red-600" data-id="' + r.id + '">&times;</button></div>';
    }).join('') || '<div class="px-1 py-3 text-xs text-slate-400">No logic is attached to this question yet.</div>';
    document.getElementById('rCount').textContent = rules.length;
    host.querySelectorAll('.rule-del').forEach(function (b) {
      b.addEventListener('click', async function () {
        try {
          await api('POST', '/admin/studies/' + STUDY_ID + '/skip-logic/' + b.dataset.id + '/delete');
          rules = rules.filter(function (r) { return String(r.id) !== String(b.dataset.id); });
          renderEditor(); saved('Rule removed');
        } catch (e) { fail(e); }
      });
    });

    var tabSel = document.getElementById('logicTab');
    tabSel.onchange = function () { logicTab = tabSel.value; renderLogicBody(q); };
    renderLogicBody(q);
  }

  function renderLogicBody(q) {
    var body = document.getElementById('logicBody');
    var opts = optionsOf(q);
    var choiceOnly = '<p class="text-slate-500 bg-slate-50 rounded-lg px-3 py-2.5">' +
      'This logic is set per answer option, so it needs a single- or multi-select question with options. Use Compound Branching for other questions.</p>';
    var saveBtn = '<button type="button" id="lSave" class="w-full bg-signal text-white rounded-lg py-2 font-semibold">Save logic</button>';

    if (logicTab === 'skip') {
      if (!isChoice(q) || !opts.length) { body.innerHTML = choiceOnly; return; }
      var st = optionLogic(q);
      body.innerHTML = '<p class="text-slate-500">If an option is selected, jump to a later question or the end of the survey. Questions in between are skipped.' + (q.type === 'multi' ? ' On a multi-select with several selected options, the highest one in this list that has a jump wins.' : '') + '</p>' +
        opts.map(function (o) {
          return '<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] gap-2 items-center"><span class="truncate text-slate-700">' + esc(o) + '</span>' + jumpSelect('l-jump', q, st.jumps[o] || '', 'Next question (no jump)', 'data-option="' + esc(o) + '"') + '</div>';
        }).join('') +
        '<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] gap-2 items-center pt-1 border-t border-slate-100"><span class="text-slate-500">Default branch</span>' + jumpSelect('l-default', q, st.default_jump, 'None') + '</div>' +
        '<p class="text-[11px] text-slate-500">The default branch runs once this question is answered and no option above matched. To end someone’s participation, set an option to Terminate in the options list.</p>' + saveBtn;
      document.getElementById('lSave').onclick = function () {
        body.querySelectorAll('.l-jump').forEach(function (el) { if (el.value) st.jumps[el.dataset.option] = el.value; else delete st.jumps[el.dataset.option]; });
        st.default_jump = body.querySelector('.l-default').value;
        saveOptionLogic(q, st, 'Skip logic saved');
      };
      return;
    }

    if (logicTab === 'scoring') {
      if (!isChoice(q) || !opts.length) { body.innerHTML = choiceOnly; return; }
      var sc = optionLogic(q);
      body.innerHTML = '<p class="text-slate-500">Give options a score. Each entry’s total score adds up the chosen options on every question it showed; branch on it with Compound Branching and show it with <code>${score}</code>.</p>' +
        opts.map(function (o) {
          return '<div class="grid grid-cols-[minmax(0,1fr)_110px] gap-2 items-center"><span class="truncate text-slate-700">' + esc(o) + '</span>' +
            '<input type="number" step="any" class="l-score border border-slate-300 rounded-lg px-2 py-1.5" data-option="' + esc(o) + '" value="' + esc(sc.scores[o] != null ? sc.scores[o] : '') + '" placeholder="0" /></div>';
        }).join('') + saveBtn;
      document.getElementById('lSave').onclick = function () {
        sc.scores = {};
        body.querySelectorAll('.l-score').forEach(function (el) { if (el.value.trim() !== '') sc.scores[el.dataset.option] = el.value; });
        saveOptionLogic(q, sc, 'Scores saved');
      };
      return;
    }

    if (logicTab === 'variables') {
      if (!isChoice(q) || !opts.length) { body.innerHTML = choiceOnly; return; }
      var vs = optionLogic(q);
      body.innerHTML = '<p class="text-slate-500">When an option is selected, set a variable. Leave the value blank to store the option’s own text. Use it later in conditions, or pipe it with <code>${name}</code>. The latest value set wins.</p>' +
        '<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)] gap-2 font-mono text-[10px] uppercase text-slate-400"><span>Option</span><span>Variable</span><span>Value</span></div>' +
        opts.map(function (o) {
          var v = vs.variables[o] || {};
          return '<div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)] gap-2 items-center"><span class="truncate text-slate-700">' + esc(o) + '</span>' +
            '<input class="l-var-name border border-slate-300 rounded-lg px-2 py-1.5 font-mono" data-option="' + esc(o) + '" value="' + esc(v.name || '') + '" placeholder="e.g. segment" />' +
            '<input class="l-var-value border border-slate-300 rounded-lg px-2 py-1.5" data-option="' + esc(o) + '" value="' + esc(v.value || '') + '" placeholder="' + esc(o) + '" /></div>';
        }).join('') + saveBtn;
      document.getElementById('lSave').onclick = function () {
        vs.variables = {};
        body.querySelectorAll('.l-var-name').forEach(function (el) {
          var value = body.querySelector('.l-var-value[data-option="' + CSS.escape(el.dataset.option) + '"]').value;
          if (el.value.trim()) vs.variables[el.dataset.option] = { name: el.value.trim(), value: value };
        });
        saveOptionLogic(q, vs, 'Variables saved');
      };
      return;
    }

    if (logicTab === 'custom') {
      var codes = questions.filter(function (x) { return x.code; }).map(function (x) { return '<code>' + esc(x.code) + '</code>'; }).join(', ');
      body.innerHTML = '<p class="text-slate-500">Write a condition as an expression; when it is true, the action below runs. It is checked by our own logic engine, never run as code.</p>' +
        '<textarea id="xExpr" rows="3" class="w-full font-mono border border-slate-300 rounded-lg px-2 py-1.5" placeholder="selectedCount(\'Q3\') >= 2 and score > 5"></textarea>' +
        '<div id="xStatus" class="text-[11px] text-slate-500">&nbsp;</div>' +
        '<select id="xAction" class="w-full border border-slate-300 rounded-lg px-2 py-1.5 bg-white"><option value="show">Show this question</option><option value="hide">Hide this question</option><option value="skip_to">Jump after this question…</option><option value="set_variable">Set a variable…</option></select>' +
        '<div id="xJump" class="hidden">' + jumpSelect('', q, '', 'Choose where to jump…', 'id="xJumpTo"') + '</div>' +
        '<div id="xVar" class="hidden grid grid-cols-2 gap-2"><input id="xVarName" class="border border-slate-300 rounded-lg px-2 py-1.5 font-mono" placeholder="variable name" /><input id="xVarValue" class="border border-slate-300 rounded-lg px-2 py-1.5" placeholder="value" /></div>' +
        '<details class="text-[11px] text-slate-600 bg-slate-50 rounded-lg px-3 py-2"><summary class="cursor-pointer font-medium">Functions and operators</summary>' +
        '<div class="mt-1.5 space-y-0.5 font-mono">' +
        '<div>answer(\'Q1\') · number(\'Q4\') · selectedCount(\'Q3\')</div><div>selectedIndex(\'Q1\') · isSelected(\'Q3\', \'A\') · isAnswered(\'Q2\')</div>' +
        '<div>score · any variable name</div><div>== != &gt; &gt;= &lt; &lt;= and or not ( ) + - * /</div></div>' +
        '<div class="mt-1.5">QuestionPro names like <code>$survey.getSelectedOption(\'Q1\')</code> also work. Question codes: ' + (codes || 'none yet — set a Code on each question you want to reference') + '.</div></details>' +
        '<button type="button" id="xSave" class="w-full bg-signal text-white rounded-lg py-2 font-semibold">Add rule</button>';
      var expr = document.getElementById('xExpr'), status = document.getElementById('xStatus'), act = document.getElementById('xAction');
      expr.oninput = function () {
        var problem = expr.value.trim() ? SkipLogic.validateExpression(expr.value) : null;
        status.textContent = problem || (expr.value.trim() ? '✓ Valid expression' : ' ');
        status.className = 'text-[11px] ' + (problem ? 'text-red-600' : 'text-verified');
      };
      act.onchange = function () {
        document.getElementById('xJump').classList.toggle('hidden', act.value !== 'skip_to');
        document.getElementById('xVar').classList.toggle('hidden', act.value !== 'set_variable');
      };
      document.getElementById('xSave').onclick = async function () {
        var payload = { action: act.value, conditions: [{ expression: expr.value }] };
        if (act.value === 'show' || act.value === 'hide') { payload.target_type = 'question'; payload.target_question_id = q.id; }
        else { payload.source_question_id = q.id; }
        if (act.value === 'skip_to') payload.skip_to = document.getElementById('xJumpTo').value;
        if (act.value === 'set_variable') { payload.variable_name = document.getElementById('xVarName').value; payload.variable_value = document.getElementById('xVarValue').value; }
        try { var created = await api('POST', '/admin/studies/' + STUDY_ID + '/skip-logic', payload); rules.push(created.rule || created); renderEditor(); saved('Rule added'); } catch (e) { fail(e); }
      };
      return;
    }

    // Compound Branching and Show/Hide share the condition builder.
    var branching = logicTab === 'compound';
    var sources = questions.filter(function (item) { return branching || item.id !== q.id; });
    var sourceOpts = '<optgroup label="Questions">' + sources.map(function (item) { return '<option value="q:' + item.id + '">' + esc(questionLabel(item.id)) + '</option>'; }).join('') + '</optgroup>' +
      '<optgroup label="Derived values"><option value="v:score">Total score</option>' + variableNames().map(function (n) { return '<option value="v:' + esc(n) + '">Variable “' + esc(n) + '”</option>'; }).join('') + '</optgroup>';
    var opOpts = Object.keys(OPS).map(function (k) { return '<option value="' + k + '">' + OPS[k] + '</option>'; }).join('');
    function conditionRow() {
      return '<div class="r-cond rounded-lg border border-slate-200 bg-white p-2 space-y-1.5">' +
        '<div class="flex gap-1.5"><select class="r-q flex-1 min-w-0 border border-slate-300 rounded-lg px-2 py-1.5 bg-white">' + sourceOpts + '</select>' +
        '<button type="button" class="r-remove text-slate-400 hover:text-red-600 px-1" title="Remove condition">&times;</button></div>' +
        '<div class="grid grid-cols-[130px_1fr] gap-1.5"><select class="r-op border border-slate-300 rounded-lg px-2 py-1.5 bg-white">' + opOpts + '</select>' +
        '<input class="r-val border border-slate-300 rounded-lg px-2 py-1.5" placeholder="Value" /></div>' +
        '<datalist class="r-suggest"></datalist></div>';
    }
    body.innerHTML = (branching
        ? '<p class="text-slate-500">After this question, jump when the conditions below match. Conditions can read any question, the total score or a variable.</p>' + jumpSelect('', q, '', 'Choose where to jump…', 'id="rJump"')
        : '<select id="rAction" class="w-full border border-slate-300 rounded-lg px-2 py-1.5 bg-white"><option value="show">Show this question</option><option value="hide">Hide this question</option></select>') +
      '<div class="flex items-center gap-2 text-slate-600"><span>when</span><select id="rMatch" class="border border-slate-300 rounded-lg px-2 py-1 bg-white"><option value="all">all conditions match (AND)</option><option value="any">any condition matches (OR)</option></select></div>' +
      '<div id="rConds" class="space-y-1.5"></div>' +
      '<button type="button" id="rAddCond" class="text-signal font-medium hover:underline">+ Add condition</button>' +
      '<p class="text-[11px] text-slate-500">For “is one of”, “is none of” and “includes”, separate values with commas.</p>' +
      '<button type="button" id="rSave" class="w-full bg-signal text-white rounded-lg py-2 font-semibold">Add rule</button>';
    var condHost = document.getElementById('rConds'), uid = 0;
    var byId = {}; questions.forEach(function (item) { byId[item.id] = item; });
    function addCondition() {
      condHost.insertAdjacentHTML('beforeend', conditionRow());
      var row = condHost.lastElementChild, listId = 'rSuggest' + (++uid);
      row.querySelector('.r-suggest').id = listId; row.querySelector('.r-val').setAttribute('list', listId);
      if (branching) row.querySelector('.r-q').value = 'q:' + q.id;
      function suggest() {
        var key = row.querySelector('.r-q').value, src = key.indexOf('q:') === 0 ? byId[key.slice(2)] : null;
        row.querySelector('.r-suggest').innerHTML = (src ? optionsOf(src) : []).map(function (o) { return '<option value="' + esc(o) + '"></option>'; }).join('');
        if (key === 'v:score') row.querySelector('.r-op').value = 'gte';
      }
      row.querySelector('.r-q').addEventListener('change', suggest); suggest();
      row.querySelector('.r-remove').addEventListener('click', function () { if (condHost.children.length > 1) row.remove(); });
    }
    addCondition();
    document.getElementById('rAddCond').onclick = addCondition;
    document.getElementById('rSave').onclick = async function () {
      var conditions = Array.from(condHost.querySelectorAll('.r-cond')).map(function (row) {
        var op = row.querySelector('.r-op').value, raw = row.querySelector('.r-val').value, key = row.querySelector('.r-q').value;
        var value = ['in', 'not_in', 'includes'].indexOf(op) > -1 ? raw.split(',').map(function (v) { return v.trim(); }).filter(Boolean).join('|') : raw.trim();
        return key.indexOf('v:') === 0 ? { variable: key.slice(2), operator: op, value: value } : { question_id: Number(key.slice(2)), operator: op, value: value };
      });
      var payload = branching
        ? { action: 'skip_to', source_question_id: q.id, skip_to: document.getElementById('rJump').value, match: document.getElementById('rMatch').value, conditions: conditions }
        : { action: document.getElementById('rAction').value, target_type: 'question', target_question_id: q.id, match: document.getElementById('rMatch').value, conditions: conditions };
      try { var created = await api('POST', '/admin/studies/' + STUDY_ID + '/skip-logic', payload); rules.push(created.rule || created); renderEditor(); saved('Rule added'); } catch (e) { fail(e); }
    };
  }

  // ---------- events ----------
  document.getElementById('qList').addEventListener('click', function (e) {
    var b = e.target.closest('.q-item');
    if (!b) return;
    selectedId = Number(b.dataset.id);
    renderList(); renderEditor();
  });

  document.getElementById('addQuestion').addEventListener('click', async function () {
    var cur = questions.filter(function (x) { return x.id === selectedId; })[0];
    try {
      var created = await api('POST', '/admin/studies/' + STUDY_ID + '/questions', cur && cur.section ? { section: cur.section } : {});
      questions.push(created.question || created);
      selectedId = (created.question || created).id;
      renderList(); renderEditor(); saved('Question added');
      var t = document.getElementById('fText'); if (t) t.focus();
    } catch (e) { fail(e); }
  });

  document.getElementById('addSection').addEventListener('click', async function () {
    var name = prompt('Name this section (e.g. Screening)');
    if (!name) return;
    try {
      var created = await api('POST', '/admin/studies/' + STUDY_ID + '/questions', { section: name });
      questions.push(created.question || created);
      selectedId = (created.question || created).id;
      renderList(); renderEditor(); saved('Section added');
    } catch (e) { fail(e); }
  });

  // Drag to reorder. The list is the only place order is expressed, so this is
  // where it belongs — the old page mixed reordering into the same cards you
  // edited in, which made both harder.
  var dragId = null;
  document.getElementById('qList').addEventListener('dragstart', function (e) {
    var b = e.target.closest('.q-item'); if (!b) return;
    dragId = Number(b.dataset.id); e.dataTransfer.effectAllowed = 'move';
  });
  document.getElementById('qList').addEventListener('dragover', function (e) { e.preventDefault(); });
  document.getElementById('qList').addEventListener('drop', async function (e) {
    e.preventDefault();
    var b = e.target.closest('.q-item'); if (!b || dragId == null) return;
    var overId = Number(b.dataset.id);
    if (overId === dragId) return;
    var from = questions.findIndex(function (q) { return q.id === dragId; });
    var to = questions.findIndex(function (q) { return q.id === overId; });
    questions.splice(to, 0, questions.splice(from, 1)[0]);
    renderList();
    try {
      await api('POST', '/admin/studies/' + STUDY_ID + '/questions/reorder', { ids: questions.map(function (q) { return q.id; }) });
      saved('Order saved');
    } catch (e2) { fail(e2); }
    dragId = null;
  });

  var preview=document.getElementById('respondentPreview'), frame=document.getElementById('previewFrame'); document.getElementById('openPreview').onclick=function(){frame.src=frame.dataset.src+'&refresh='+Date.now();preview.showModal();}; document.getElementById('closePreview').onclick=function(){preview.close();}; document.querySelectorAll('[data-preview-width]').forEach(function(button){button.onclick=function(){frame.style.width=button.dataset.previewWidth==='desktop'?'100%':button.dataset.previewWidth+'px';};});
  renderList(); renderEditor();
})();
</script>

