<% if (user.role === 'superadmin') { %>
<%- include('../partials/header', { title: 'Studies — Inicio Console', user, currentPath: '/admin/studies' }) %>
<%- include('../partials/page_header', { eyebrow: 'Research workspace', title: 'Studies', subtitle: 'Plan, configure, and follow every research study in one place.', actions: '<button type="button" data-open-dialog="create-study" class="console-button is-primary">' + icon('plus', 'w-4 h-4') + 'Create study</button>' }) %>
<div class="console-metrics">
  <% [['All studies',studies.length,'clipboard','Your complete research portfolio'],['Live',studies.filter(s=>s.status==='live').length,'chart','Currently in fieldwork'],['Draft',studies.filter(s=>s.status==='draft').length,'pencil','Being prepared for launch'],['Closed',studies.filter(s=>s.status==='closed').length,'check-circle','Completed fieldwork']].forEach(([label,value,glyph,note])=>{ %><div class="console-metric"><div class="console-metric-label"><%= label %><span class="console-metric-icon"><%- icon(glyph,'w-4 h-4') %></span></div><div class="console-metric-value"><%= value %></div><div class="console-metric-foot"><%= note %></div></div><% }) %>
</div>
<section class="console-panel" data-table-tools="studies" data-page-size="10">
  <div class="console-toolbar"><div class="console-segments"><% [['all','All studies'],['live','Live'],['draft','Draft'],['closed','Closed']].forEach(([value,label])=>{ %><button type="button" class="console-segment" data-table-filter="<%= value %>" aria-pressed="<%= value === 'all' %>"><%= label %></button><% }) %></div><label class="console-search"><%- icon('search','w-4 h-4') %><input type="search" data-table-search placeholder="Search studies, markets, categories…" aria-label="Search studies" /></label></div>
  <div class="overflow-x-auto"><table><thead><tr><th>Study name</th><th>Market</th><th>Diary cadence</th><th>Recruitment</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>
    <% studies.forEach(s=>{ %><tr data-table-row data-status="<%= s.status %>"><td><a href="/admin?study=<%= s.id %>" class="console-study-cell"><span class="console-study-symbol"><%- icon('clipboard','w-[18px] h-[18px]') %></span><span><strong><%= s.name %></strong><small><%= formatCategories(s.category) || 'Categories not set' %></small></span></a></td><td><%= s.market || '—' %></td><td><%= ({realtime:'Real-time',daily:'Daily',weekly:'Weekly',monthly:'Monthly'})[s.diary_mode] || s.diary_mode %></td><td class="capitalize"><%= s.recruitment_mode === 'f2f' ? 'Face-to-face' : s.recruitment_mode %></td><td><span class="console-status <%= s.status === 'live' ? 'is-live' : '' %>"><%= s.status %></span></td><td><a class="console-button" href="/admin/studies/<%= s.id %>">Configure <%- icon('arrow-right','w-3 h-3') %></a></td></tr><% }) %>
  </tbody></table></div>
  <div class="console-empty" data-table-empty <%- studies.length ? 'hidden' : '' %>><%- icon('clipboard','w-7 h-7') %><strong>No studies found</strong><p>Create a study to begin, or adjust your search and filters.</p><button type="button" data-open-dialog="create-study" class="console-button is-primary">Create study</button></div>
  <div class="console-table-footer"><span data-table-count><%= studies.length %> studies</span><div class="console-actions"><button type="button" data-table-prev aria-label="Previous page">←</button><span data-table-page>1</span><button type="button" data-table-next aria-label="Next page">→</button></div></div>
</section>
<dialog id="create-study" class="console-dialog" aria-labelledby="create-study-title"><div class="console-panel-heading"><div><h2 id="create-study-title">Create a study</h2><p>Start with the basics. Configure your questionnaire and rules next.</p></div><button type="button" data-close-dialog class="console-icon-button" aria-label="Close create study">✕</button></div><div class="console-panel-body">
    <form method="POST" action="/admin/studies" class="space-y-3.5 text-sm">
      <div>
        <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Study name</label>
        <input name="name" required class="w-full border border-slate-300 rounded-[11px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition" placeholder="e.g. Household Beverage Consumption Pilot" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Market</label>
          <input name="market" class="w-full border border-slate-300 rounded-[11px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition" placeholder="e.g. Nigeria" />
        </div>
        <div>
          <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Categories</label>
          <div class="grid grid-cols-2 gap-x-3 gap-y-1.5 border border-slate-200 rounded-[11px] p-3 bg-slate-50/60 max-h-48 overflow-auto">
            <% CATEGORIES.forEach(function (c) { %>
              <label class="flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
                <input type="checkbox" name="category" value="<%= c %>" class="h-3.5 w-3.5 rounded border-slate-300 accent-signal" />
                <%= c %>
              </label>
            <% }) %>
          </div>
        </div>
      </div>
      <div>
        <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Diary mode</label>
        <select name="diary_mode" class="w-full border border-slate-300 rounded-[11px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition">
          <option value="realtime">Occasion (real-time)</option>
          <option value="daily" selected>Daily</option>
          <option value="weekly">Weekly</option>
          <option value="monthly">Monthly</option>
        </select>
      </div>
      <div>
        <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Recruitment mode</label>
        <select name="recruitment_mode" class="w-full border border-slate-300 rounded-[11px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition">
          <option value="f2f">F2F</option>
          <option value="remote">Remote</option>
          <option value="hybrid" selected>Hybrid</option>
        </select>
      </div>
      <button class="w-full inline-flex items-center justify-center gap-1.5 bg-signal text-white rounded-[11px] py-2.5 text-sm font-semibold hover:bg-signal-bright transition shadow-[0_1px_2px_rgba(29,78,216,.2),0_4px_10px_-2px_rgba(29,78,216,.35)]">
        <%- icon('plus', 'w-4 h-4') %> Create Study
      </button>
    </form></div></dialog>
<%- include('../partials/footer') %>

<% } else { %>
<%- include('../partials/header', { title: 'Studies — INICIO', user, currentPath: '/admin/studies' }) %>

<%- include('../partials/page_header', {
  eyebrow: 'Admin',
  title: 'Studies',
  subtitle: 'All research studies configured on this platform.',
}) %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 flex-1 min-h-0">
  <div class="lg:col-span-2 flex flex-col gap-2.5 overflow-y-auto">
    <% studies.forEach(function (s) { %>
      <a href="/admin/studies/<%= s.id %>" class="flex items-center justify-between gap-3 bg-white rounded-[16px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow px-4 py-3.5">
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-10 h-10 rounded-[12px] bg-brand-50 text-brand-600 flex items-center justify-center shrink-0"><%- icon('building', 'w-[18px] h-[18px]') %></span>
          <div class="min-w-0">
            <div class="font-semibold text-slate-900 truncate"><%= s.name %></div>
            <div class="text-[12px] text-slate-500 truncate"><%= [s.market, formatCategories(s.category)].filter(Boolean).join(' · ') %> &middot; diary: <%= s.diary_mode %> &middot; recruitment: <%= s.recruitment_mode %></div>
          </div>
        </div>
        <span class="text-[10.5px] uppercase tracking-wide px-2.5 py-1 rounded-full font-bold shrink-0 <%= s.status === 'live' ? 'badge-green' : 'bg-slate-100 text-slate-500' %>"><%= s.status %></span>
      </a>
    <% }) %>
    <% if (!studies.length) { %>
      <div class="bg-white rounded-[16px] border-2 border-dashed border-slate-200 p-10 text-center text-slate-400 text-sm">
        No studies yet — create the pilot study on the right.
      </div>
    <% } %>
  </div>

  <div class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card p-5 h-fit">
    <div class="font-display font-bold text-slate-900 mb-4 flex items-center gap-2 text-[15px]">
      <span class="w-7 h-7 rounded-[9px] bg-brand-50 text-brand-600 flex items-center justify-center"><%- icon('plus', 'w-3.5 h-3.5') %></span>
      Create Pilot Study
    </div>
    <form method="POST" action="/admin/studies" class="space-y-3.5 text-sm">
      <div>
        <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Study name</label>
        <input name="name" required class="w-full border border-slate-300 rounded-[11px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition" placeholder="e.g. Household Beverage Consumption Pilot" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Market</label>
          <input name="market" class="w-full border border-slate-300 rounded-[11px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition" placeholder="e.g. Nigeria" />
        </div>
        <div>
          <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Categories</label>
          <div class="grid grid-cols-2 gap-x-3 gap-y-1.5 border border-slate-200 rounded-[11px] p-3 bg-slate-50/60 max-h-48 overflow-auto">
            <% CATEGORIES.forEach(function (c) { %>
              <label class="flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
                <input type="checkbox" name="category" value="<%= c %>" class="h-3.5 w-3.5 rounded border-slate-300 accent-signal" />
                <%= c %>
              </label>
            <% }) %>
          </div>
        </div>
      </div>
      <div>
        <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Diary mode</label>
        <select name="diary_mode" class="w-full border border-slate-300 rounded-[11px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition">
          <option value="realtime">Occasion (real-time)</option>
          <option value="daily" selected>Daily</option>
          <option value="weekly">Weekly</option>
          <option value="monthly">Monthly</option>
        </select>
      </div>
      <div>
        <label class="block text-[12.5px] font-semibold text-slate-600 mb-1.5">Recruitment mode</label>
        <select name="recruitment_mode" class="w-full border border-slate-300 rounded-[11px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition">
          <option value="f2f">F2F</option>
          <option value="remote">Remote</option>
          <option value="hybrid" selected>Hybrid</option>
        </select>
      </div>
      <button class="w-full inline-flex items-center justify-center gap-1.5 bg-signal text-white rounded-[11px] py-2.5 text-sm font-semibold hover:bg-signal-bright transition shadow-[0_1px_2px_rgba(29,78,216,.2),0_4px_10px_-2px_rgba(29,78,216,.35)]">
        <%- icon('plus', 'w-4 h-4') %> Create Study
      </button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>

<% } %>
