<%- include('../partials/header', { title: 'Studies — INICIO', user }) %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <div class="text-xs font-semibold text-brand-500 uppercase tracking-wide mb-0.5">Admin</div>
    <h1 class="text-2xl font-bold text-slate-900">Studies</h1>
    <p class="text-slate-500 text-sm mt-1">All research studies configured on this platform.</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/70 shadow-card divide-y divide-slate-100">
    <% studies.forEach(s => { %>
      <a href="/admin/studies/<%= s.id %>" class="flex items-center justify-between gap-3 px-5 py-4 hover:bg-slate-50/70 transition first:rounded-t-2xl last:rounded-b-2xl">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center shrink-0"><%- icon('building', 'w-4 h-4') %></span>
          <div>
            <div class="font-semibold text-slate-800"><%= s.name %></div>
            <div class="text-xs text-slate-500"><%= [s.market, formatCategories(s.category)].filter(Boolean).join(' · ') %> · diary: <%= s.diary_mode %> · recruitment: <%= s.recruitment_mode %></div>
          </div>
        </div>
        <span class="text-xs uppercase tracking-wide px-2.5 py-1 rounded-full font-semibold <%= s.status === 'live' ? 'badge-green' : 'bg-slate-100 text-slate-600' %>"><%= s.status %></span>
      </a>
    <% }) %>
    <% if (!studies.length) { %>
      <div class="p-8 text-center text-slate-400">
        <div class="border-2 border-dashed border-slate-200 rounded-2xl p-8">No studies yet — create the pilot study on the right.</div>
      </div>
    <% } %>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200/70 shadow-card p-5 h-fit">
    <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2"><%- icon('plus', 'w-4 h-4 text-brand-500') %> Create Pilot Study</div>
    <form method="POST" action="/admin/studies" class="space-y-3 text-sm">
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Study name</label>
        <input name="name" required class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition" placeholder="e.g. Household Beverage Consumption Pilot" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-slate-600 mb-1.5">Market</label>
          <input name="market" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition" placeholder="e.g. Nigeria" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-600 mb-1.5">Categories</label>
          <div class="grid grid-cols-2 gap-x-3 gap-y-1.5 border border-slate-200 rounded-xl p-3 bg-slate-50/60 max-h-48 overflow-auto">
            <% CATEGORIES.forEach(c => { %>
              <label class="flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
                <input type="checkbox" name="category" value="<%= c %>" class="h-3.5 w-3.5 rounded border-slate-300 accent-brand-700" />
                <%= c %>
              </label>
            <% }) %>
          </div>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Diary mode</label>
        <select name="diary_mode" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition">
          <option value="realtime">Occasion (real-time)</option>
          <option value="daily" selected>Daily</option>
          <option value="weekly">Weekly</option>
          <option value="monthly">Monthly</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Recruitment mode</label>
        <select name="recruitment_mode" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition">
          <option value="f2f">F2F</option>
          <option value="remote">Remote</option>
          <option value="hybrid" selected>Hybrid</option>
        </select>
      </div>
      <button class="w-full inline-flex items-center justify-center gap-1.5 bg-brand-700 text-white rounded-xl py-2.5 text-sm font-semibold hover:bg-brand-600 transition shadow-card">
        <%- icon('plus', 'w-4 h-4') %> Create Study
      </button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
