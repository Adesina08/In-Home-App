<%- include('../partials/header', { title: 'Users — INICIO', user, currentPath: '/admin/users' }) %>

<%- include('../partials/page_header', {
  eyebrow: 'Admin',
  title: 'Users & Access',
  subtitle: 'Manage staff accounts and study-level permissions.',
  actions: user.role === 'superadmin' ? '<button type="button" data-open-dialog="create-user" class="console-button is-primary">' + icon('plus', 'w-4 h-4') + 'Create user</button>' : '',
}) %>

<% if (delivery) { %>
  <div class="bg-white border-2 <%= delivery === 'sent' ? 'border-verified/40' : 'border-red-200' %> rounded-2xl p-5 mb-6">
    <div class="flex items-start gap-2.5">
      <span class="<%= delivery === 'sent' ? 'text-verified' : 'text-red-600' %> mt-0.5"><%- icon(delivery === 'sent' ? 'check-circle' : 'warning', 'w-5 h-5') %></span>
      <div class="min-w-0">
        <div class="font-semibold text-slate-900"><%= delivery === 'sent' ? 'Credential email sent' : 'Credential email could not be sent' %></div>
        <p class="text-sm text-slate-600 mt-0.5"><%= deliveryEmail %><%= delivery === 'sent' ? ' received a 24-hour temporary password, username, role and sign-in link.' : ' remains pending. Check the Resend configuration, then use the resend action below.' %></p>
      </div>
    </div>
  </div>
<% } %>

<div class="console-user-layout grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-white rounded-[18px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow">
    <div class="overflow-x-auto">
    <table data-console-table="users" data-console-search-label="Search team members…" class="w-full text-sm">
      <thead><tr class="text-left text-slate-400 text-xs uppercase tracking-wide"><th class="px-5 py-2.5">Name</th><th class="py-2.5">Username</th><th class="py-2.5">Role</th><th class="py-2.5">Study Scope</th><th class="py-2.5">Delivery</th><th class="py-2.5 pr-5 text-right">Access</th></tr></thead>
      <tbody>
      <% users.forEach(u => { %>
        <tr class="border-t border-slate-100 hover:bg-slate-50/70">
          <td class="px-5 py-2.5 font-medium text-slate-800"><%= u.name %></td>
          <td class="py-2.5 text-slate-500"><%= u.email %></td>
          <td class="py-2.5"><span class="text-xs px-2.5 py-1 rounded-full font-medium bg-slate-100 text-slate-600 uppercase tracking-wide"><%= u.role %></span></td>
          <td class="py-2.5 text-slate-500 text-xs"><%= u.study_name || 'All studies' %></td>
          <td class="py-2.5"><span class="text-[11px] font-semibold px-2 py-0.5 rounded-full <%= u.invite_delivery_status === 'failed' ? 'bg-red-50 text-red-700' : u.invite_delivery_status === 'sent' ? 'bg-blue-50 text-blue-700' : 'bg-verified-soft text-verified' %>"><%= u.invite_delivery_status || 'activated' %></span></td>
          <td class="py-2.5 pr-5 text-right">
            <% if (user.role === 'superadmin') { %><form method="POST" action="/admin/users/<%= u.id %>/resend-credentials" onsubmit="return confirm('Email a new 24-hour temporary password to <%= u.email %>? Their current password stops working immediately.')"><button class="text-xs font-medium text-signal hover:underline"><%= u.must_change_password ? 'Resend' : 'Reset & email' %></button></form><% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!users.length) { %><tr><td colspan="6" class="px-5 py-8 text-center text-slate-400">No users yet.</td></tr><% } %>
      </tbody>
    </table>
    </div>
  </div>
  <% if (user.role === 'superadmin') { %><dialog id="create-user" class="console-dialog" aria-label="Create user"><div class="console-panel-heading"><h2>Create user</h2><button type="button" data-close-dialog class="console-icon-button" aria-label="Close create user">✕</button></div>
  <div class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow p-5 h-fit">
    <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2"><%- icon('plus', 'w-4 h-4 text-signal') %> Create User</div>
    <form method="POST" action="/admin/users" class="space-y-3 text-sm">
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Name</label>
        <input name="name" required class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition" />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Email / username</label>
        <input name="email" type="email" required class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition" />
      </div>
      <p class="rounded-xl bg-blue-50 border border-blue-100 p-3 text-xs text-blue-800">INICIO generates a secure temporary password and Resend emails it with the username, role and sign-in link. It expires after 24 hours.</p>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Role</label>
        <select name="role" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition">
          <option value="admin">Admin</option>
          <option value="interviewer">Interviewer</option>
          <option value="client">Client</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Study scope (client/interviewer)</label>
        <select name="study_id" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition">
          <option value="">All studies</option>
          <% studies.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
        </select>
      </div>
      <button class="w-full inline-flex items-center justify-center gap-1.5 bg-signal text-white rounded-xl py-2.5 text-sm font-semibold hover:bg-signal-bright transition shadow-card">
        <%- icon('plus', 'w-4 h-4') %> Create User
      </button>
    </form>
  </div>
  </dialog><% } %>
</div>
<%- include('../partials/footer') %>
