<%- include('../partials/header', { title: 'QC Worklist — INICIO', user }) %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <div class="text-xs font-semibold text-brand-500 uppercase tracking-wide mb-0.5">Quality Control</div>
    <h1 class="text-2xl font-bold text-slate-900">QC Worklist</h1>
    <p class="text-slate-500 text-sm mt-1">Review and resolve automated data-quality flags.</p>
  </div>
  <div class="flex gap-2 text-sm items-center">
    <a href="/admin/qc/follow-up?study=<%= study.id %>" class="inline-flex items-center gap-1.5 border border-slate-300 rounded-xl px-3 py-2 bg-white text-slate-700 font-medium hover:bg-slate-50 transition">
      <%- icon('warning', 'w-4 h-4 text-red-500') %> Exception follow-up
    </a>
    <select onchange="window.location='/admin/qc?study='+this.value+'&status=<%= statusFilter %>'" class="border border-slate-300 rounded-xl px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-400">
      <% studies.forEach(s => { %><option value="<%= s.id %>" <%= s.id===study.id?'selected':'' %>><%= s.name %></option><% }) %>
    </select>
    <select onchange="window.location='/admin/qc?study=<%= study.id %>&status='+this.value" class="border border-slate-300 rounded-xl px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-brand-400">
      <% ['open','reviewed','resolved','all'].forEach(s => { %><option value="<%= s %>" <%= statusFilter===s?'selected':'' %>><%= s %></option><% }) %>
    </select>
  </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200/70 shadow-card">
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="text-left text-slate-400 text-xs uppercase tracking-wide">
      <th class="px-5 py-2.5">Respondent</th><th class="py-2.5">Flag</th><th class="py-2.5">Severity</th><th class="py-2.5">Reason</th><th class="py-2.5">Status</th><th class="py-2.5">Action</th>
    </tr></thead>
    <tbody>
    <% flags.forEach(f => { %>
      <tr class="border-t border-slate-100 hover:bg-slate-50/70 align-top">
        <td class="px-5 py-3 font-medium">
          <a href="/admin/studies/<%= study.id %>/respondents/<%= f.rid %>" class="text-brand-600 hover:underline font-semibold"><%= f.respondent_code %></a>
          <div class="text-xs text-slate-400 font-normal"><%= f.respondent_name %></div>
          <% if (f.record_id) { %>
            <a href="/admin/studies/<%= study.id %>/records/<%= f.record_id %>" class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-500 hover:text-brand-700 transition mt-1">
              <%- icon('eye', 'w-3 h-3') %> See what they answered
            </a>
          <% } %>
        </td>
        <td class="py-3 text-slate-600"><%= f.flag_type.replace(/_/g,' ') %></td>
        <td class="py-3"><span class="text-xs px-2.5 py-1 rounded-full font-medium <%= f.severity==='critical'||f.severity==='high' ? 'badge-red' : f.severity==='medium' ? 'badge-amber' : 'badge-green' %>"><%= f.severity %></span></td>
        <td class="py-3 text-slate-500 max-w-sm"><%= f.reason %></td>
        <td class="py-3 text-xs capitalize text-slate-600"><%= f.status %><% if(f.reviewer){ %><div class="text-slate-400"><%= f.reviewer %></div><% } %></td>
        <td class="py-3 pr-4">
          <% if (f.status !== 'resolved') { %>
          <form method="POST" action="/admin/qc/<%= f.id %>/action" class="flex gap-1.5">
            <input type="hidden" name="status" value="reviewed" />
            <input name="action_note" placeholder="note" class="border border-slate-300 rounded-lg px-2 py-1.5 text-xs w-28 focus:outline-none focus:ring-2 focus:ring-brand-400" />
            <button formaction="/admin/qc/<%= f.id %>/action" onclick="this.form.status.value='reviewed'" class="inline-flex items-center gap-1 text-xs px-2.5 py-1.5 border border-slate-300 rounded-lg hover:bg-slate-100 transition"><%- icon('eye', 'w-3.5 h-3.5') %> Review</button>
            <button onclick="this.form.status.value='resolved'" class="inline-flex items-center gap-1 text-xs px-2.5 py-1.5 border border-emerald-200 text-emerald-700 rounded-lg bg-emerald-50 hover:bg-emerald-100 transition"><%- icon('check', 'w-3.5 h-3.5') %> Resolve</button>
          </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (!flags.length) { %><tr><td colspan="6" class="px-5 py-8 text-center text-slate-400">No flags in this view.</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/footer') %>
