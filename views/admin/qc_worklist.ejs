<% if (user.role === 'superadmin') { %>
<%- include('../partials/header', { title: 'Quality Control — INICIO Console', user, currentPath: '/admin/qc', studyPicker: { studies, current: study.id, action: '/admin/qc?study=' } }) %>
<%- include('../partials/page_header', { eyebrow: 'Evidence & review', title: 'Quality Control', subtitle: 'Review the evidence, understand the flag, and record your decision.', actions: '<a href="/admin/qc/follow-up?study=' + study.id + '" class="console-button">' + icon('chat','w-4 h-4') + 'Exception follow-up</a>' }) %>
<div class="console-actions" style="justify-content:space-between"><nav class="console-segments" aria-label="Flag status"><% ['open','reviewed','resolved','all'].forEach(status=>{ %><a class="console-segment <%= statusFilter===status ? 'is-active' : '' %>" href="/admin/qc?study=<%= study.id %>&status=<%= status %>" <%- statusFilter===status ? 'aria-current="page"' : '' %>><%= status[0].toUpperCase()+status.slice(1) %></a><% }) %></nav><span style="font-size:12px;color:#5f7189"><%= flags.length %> <%= flags.length===1?'flag':'flags' %> in this view</span></div>
<% if (!selectedFlag) { %><section class="console-panel console-empty"><%- icon('shield-check','w-7 h-7') %><strong>No <%= statusFilter === 'all' ? '' : statusFilter %> flags in this study</strong><p>Choose another status or study to continue reviewing.</p></section><% } else { const f = selectedFlag; %>
<div class="console-qc-layout">
  <section class="console-panel"><div class="console-panel-heading"><h2>Review queue</h2><span class="console-status"><%= flags.length %></span></div><nav class="console-qc-queue" aria-label="Quality flags">
    <% flags.forEach(flag=>{ %><a class="console-qc-item <%= flag.id===f.id?'is-active':'' %>" href="/admin/qc?study=<%= study.id %>&status=<%= statusFilter %>&flag=<%= flag.id %>" <%- flag.id===f.id?'aria-current="true"':'' %>><span class="console-status <%= ['critical','high'].includes(flag.severity)?'is-danger':'is-alert' %>"><%= flag.severity %></span><strong><%= String(flag.flag_type || '').replace(/_/g,' ') %></strong><p><%= flag.respondent_code %> · <%= flag.respondent_name || 'Unnamed respondent' %></p><small><%= flag.created_time || 'Time unavailable' %></small></a><% }) %>
  </nav></section>
  <div class="console-stack">
    <section class="console-panel"><div class="console-panel-heading"><div><h2><%= String(f.flag_type || '').replace(/_/g,' ') %></h2><p><a href="/admin/studies/<%= study.id %>/respondents/<%= f.rid %>" style="color:#35549c"><%= f.respondent_code %> · <%= f.respondent_name %> ↗</a></p></div><span class="console-status <%= ['critical','high'].includes(f.severity)?'is-danger':'is-alert' %>"><%= f.severity %></span></div><div class="console-panel-body"><p style="font-size:13px;margin:0"><%= f.reason %></p><p style="font-size:11px;color:#5f7189;margin-top:12px">Raised <%= f.created_time || 'at an unknown time' %> · UTC</p></div></section>
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Evidence</h2><p><%= reviewRecord ? 'Entry ' + reviewRecord.id + ' · ' + reviewRecord.status : 'Respondent-level review' %></p></div><% if(reviewRecord) { %><a href="/admin/studies/<%= study.id %>/records/<%= reviewRecord.id %>">Full entry ↗</a><% } %></div>
      <% if (reviewMedia.length) { %><div class="console-evidence"><% reviewMedia.forEach(m=>{ const url=mediaUrl(m.file_path); %><figure><% if(!url) { %><div class="console-empty">File link unavailable.</div><% } else if(m.media_type==='photo') { %><a href="<%= url %>" target="_blank" rel="noopener"><img src="<%= url %>" alt="Photo evidence for entry <%= reviewRecord.id %>" loading="lazy" /></a><% } else if(m.media_type==='audio') { %><audio controls preload="none" src="<%= url %>"></audio><% } else if(m.media_type==='video') { %><video controls preload="metadata" src="<%= url %>"></video><% } else { %><a href="<%= url %>" target="_blank" rel="noopener">Open evidence</a><% } %><figcaption style="font-size:11px;color:#5f7189;margin-top:8px"><%= m.media_type %> · <%= m.upload_time || 'Upload time unavailable' %></figcaption></figure><% }) %></div><% } else { %><div class="console-empty"><%- icon('photo','w-7 h-7') %><strong>No attached evidence</strong><p><%= reviewRecord ? 'No media files are attached to this entry.' : 'Open the respondent profile to review their diary history.' %></p></div><% } %>
    </section>
    <% if(reviewRecord) { %><section class="console-panel"><div class="console-panel-heading"><div><h2>Recorded answers</h2><p>Current question labels · open the full entry for version details.</p></div></div><dl><% reviewAnswers.forEach(a=>{ %><div class="console-answer"><dt><%= a.code %> · <%= a.text %></dt><dd><%= a.value === null || a.value === '' ? 'No answer recorded' : a.value %></dd><% if(a.source==='ai_video') { %><span class="console-status <%= a.verified?'is-live':'is-alert' %>" style="margin-top:8px">AI extracted · <%= a.verified?'verified':'needs verification' %></span><% } %></div><% }) %></dl><% if(!reviewAnswers.length){ %><div class="console-empty">No questions or answers available for this entry.</div><% } %></section><% } %>
  </div>
  <aside class="console-panel console-qc-decision"><div class="console-panel-heading"><h2>Review decision</h2></div><div class="console-panel-body"><span class="console-status <%= f.status==='resolved'?'is-live':'' %>"><%= f.status %></span><% if(f.reviewer) { %><p style="font-size:12px;color:#5f7189;margin:14px 0">Reviewed by <strong><%= f.reviewer %></strong></p><% } %><% if(f.action_note) { %><p style="font-size:12px;margin:14px 0"><%= f.action_note %></p><% } %>
    <% if(f.status!=='resolved') { %><form method="POST" action="/admin/qc/<%= f.id %>/action" style="margin-top:22px"><label for="review-note">Decision note</label><textarea id="review-note" name="action_note" placeholder="Record what you checked and the reason for your decision."></textarea><button name="status" value="reviewed" class="console-button"><%- icon('eye','w-4 h-4') %>Mark reviewed</button><button name="status" value="resolved" class="console-button is-primary"><%- icon('check','w-4 h-4') %>Resolve flag</button></form><p style="font-size:11px;color:#5f7189;margin-top:16px">Your name and decision are recorded in the audit trail.</p><% } else { %><p style="font-size:12px;color:#667e6f;margin-top:18px">This flag has been resolved.</p><% } %>
  </div></aside>
</div>
<% } %>
<%- include('../partials/footer') %>

<% } else { %>
<%- include('../partials/header', { title: 'QC Worklist — INICIO', user, currentPath: '/admin/qc' }) %>

<%
  const qcActions = `
    <a href="/admin/qc/follow-up?study=${study.id}" class="inline-flex items-center gap-1.5 border border-slate-200 rounded-[10px] px-3.5 py-2 bg-white text-slate-600 text-[12.5px] font-semibold hover:bg-slate-50 hover:border-slate-300 transition">${icon('warning','w-[14px] h-[14px] text-[#C0392B]')}Exception follow-up</a>
  `;
%>
<%- include('../partials/page_header', {
  eyebrow: 'Quality Control',
  title: 'QC Worklist',
  subtitle: 'Review and resolve automated data-quality flags.',
  actions: qcActions,
}) %>

<div class="flex gap-2.5 shrink-0">
  <div class="relative">
    <select onchange="window.location='/admin/qc?study='+this.value+'&status=<%= statusFilter %>'" class="appearance-none border border-slate-200 rounded-[10px] pl-3.5 pr-8 py-2 bg-white text-[12.5px] font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-signal/30 cursor-pointer">
      <% studies.forEach(function (s) { %><option value="<%= s.id %>" <%= s.id === study.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
    </select>
    <span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400"><%- icon('chevron-down', 'w-3.5 h-3.5') %></span>
  </div>
  <div class="relative">
    <select onchange="window.location='/admin/qc?study=<%= study.id %>&status='+this.value" class="appearance-none border border-slate-200 rounded-[10px] pl-3.5 pr-8 py-2 bg-white text-[12.5px] font-semibold text-slate-700 capitalize focus:outline-none focus:ring-2 focus:ring-signal/30 cursor-pointer">
      <% ['open','reviewed','resolved','all'].forEach(function (s) { %><option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
    <span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400"><%- icon('chevron-down', 'w-3.5 h-3.5') %></span>
  </div>
</div>

<div class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card flex-1 min-h-0 flex flex-col overflow-hidden">
  <div class="overflow-auto">
    <table class="w-full text-sm border-collapse">
      <thead><tr class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold">
        <th class="px-5 py-3 border-b border-slate-200">Respondent</th>
        <th class="py-3 border-b border-slate-200 pr-4">Flag</th>
        <th class="py-3 border-b border-slate-200 pr-4">Severity</th>
        <th class="py-3 border-b border-slate-200 pr-4">Reason</th>
        <th class="py-3 border-b border-slate-200 pr-4">Status</th>
        <th class="py-3 border-b border-slate-200 pr-4">Action</th>
      </tr></thead>
      <tbody>
      <% flags.forEach(function (f) { %>
        <tr class="border-t border-slate-100 hover:bg-slate-50/60 transition-colors align-top">
          <td class="px-5 py-3.5 font-medium">
            <a href="/admin/studies/<%= study.id %>/respondents/<%= f.rid %>" class="text-signal hover:underline font-semibold"><%= f.respondent_code %></a>
            <div class="text-[11px] text-slate-400 font-normal"><%= f.respondent_name %></div>
            <% if (f.record_id) { %>
              <a href="/admin/studies/<%= study.id %>/records/<%= f.record_id %>" class="inline-flex items-center gap-1 text-[10.5px] font-semibold text-slate-500 hover:text-signal transition mt-1">
                <%- icon('eye', 'w-3 h-3') %> See what they answered
              </a>
            <% } %>
          </td>
          <td class="py-3.5 pr-4 text-slate-600 text-[12.5px]"><%= f.flag_type.replace(/_/g,' ') %></td>
          <td class="py-3.5 pr-4"><span class="text-[10.5px] px-2.5 py-1 rounded-full font-bold uppercase <%= f.severity === 'critical' || f.severity === 'high' ? 'badge-red' : f.severity === 'medium' ? 'badge-amber' : 'badge-green' %>"><%= f.severity %></span></td>
          <td class="py-3.5 pr-4 text-slate-500 text-[12.5px] max-w-sm"><%= f.reason %></td>
          <td class="py-3.5 pr-4 text-[11.5px] capitalize text-slate-600"><%= f.status %><% if (f.reviewer) { %><div class="text-slate-400"><%= f.reviewer %></div><% } %></td>
          <td class="py-3.5 pr-5">
            <% if (f.status !== 'resolved') { %>
            <form method="POST" action="/admin/qc/<%= f.id %>/action" class="flex gap-1.5">
              <input type="hidden" name="status" value="reviewed" />
              <input name="action_note" placeholder="note" class="border border-slate-200 rounded-[8px] px-2 py-1.5 text-xs w-28 focus:outline-none focus:ring-2 focus:ring-signal/30" />
              <button formaction="/admin/qc/<%= f.id %>/action" onclick="this.form.status.value='reviewed'" class="inline-flex items-center gap-1 text-[11.5px] font-semibold px-2.5 py-1.5 border border-slate-200 rounded-[8px] hover:bg-slate-100 transition"><%- icon('eye', 'w-3.5 h-3.5') %> Review</button>
              <button onclick="this.form.status.value='resolved'" class="inline-flex items-center gap-1 text-[11.5px] font-semibold px-2.5 py-1.5 border border-emerald-200 text-emerald-700 rounded-[8px] bg-emerald-50 hover:bg-emerald-100 transition"><%- icon('check', 'w-3.5 h-3.5') %> Resolve</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!flags.length) { %><tr><td colspan="6" class="px-5 py-10 text-center text-slate-400 text-sm">No flags in this view.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>

<% } %>
