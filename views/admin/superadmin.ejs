<%- include('../partials/header', { title: 'Overview — Inicio Console', user, currentPath: '/admin/superadmin' }) %>
<%- include('../partials/page_header', {
  eyebrow: 'Platform overview', title: 'Your research, in focus.',
  subtitle: 'A clear view of every study and the work that needs your attention.',
  actions: '<a href="/admin/studies#create-study" class="console-button is-primary">' + icon('plus', 'w-4 h-4') + 'Create study</a>'
}) %>
<%
const liveStudies = studies.filter(s => s.status === 'live');
const attentionStudies = studies.filter(s => s.open_flag_count > 0).sort((a,b) => b.open_flag_count - a.open_flag_count);
%>
<section class="console-hero" aria-label="Workspace summary">
  <div><div class="console-hero-label">INICIO · IN-HOME CONSUMPTION</div><h2>From everyday moments to meaningful insight.</h2><p><%= liveStudies.length %> live <%= liveStudies.length === 1 ? 'study' : 'studies' %> across your workspace. Follow participation, review data quality, and keep your research moving.</p></div>
  <a href="/admin/studies" class="console-button">Explore studies <%- icon('arrow-right', 'w-4 h-4') %></a>
</section>
<div class="console-metrics">
  <% [['Studies',platform.studies,'clipboard',liveStudies.length + ' currently live'],['Respondents',platform.respondents,'users','Enrolments across all studies'],['Submitted entries',platform.records,'chart','All time · includes practice entries'],['Open QC flags',platform.openFlags,'shield-check','Awaiting review or resolution']].forEach(([label,value,glyph,note]) => { %>
    <div class="console-metric"><div class="console-metric-label"><%= label %><span class="console-metric-icon"><%- icon(glyph,'w-4 h-4') %></span></div><div class="console-metric-value"><%= Number(value).toLocaleString() %></div><div class="console-metric-foot"><%= note %></div></div>
  <% }) %>
</div>
<div class="console-columns">
  <section class="console-panel" data-table-tools="portfolio" data-page-size="8">
    <div class="console-panel-heading"><div><h2>Study portfolio</h2><p>All-time activity across your studies, including practice data.</p></div><a href="/admin/studies">View all <span aria-hidden="true">↗</span></a></div>
    <div class="console-toolbar"><label class="console-search"><%- icon('search','w-4 h-4') %><input data-table-search type="search" placeholder="Find a study…" aria-label="Search study portfolio" /></label><span class="console-status"><%= studies.length %> studies</span></div>
    <div class="overflow-x-auto"><table><thead><tr><th>Study</th><th>Status</th><th>Respondents</th><th>Submitted</th><th>Open flags</th></tr></thead><tbody>
      <% studies.forEach(s => { %><tr data-table-row><td><a class="console-study-cell" href="/admin?study=<%= s.id %>"><span class="console-study-symbol"><%- icon('clipboard','w-[18px] h-[18px]') %></span><span><strong><%= s.name %></strong><small><%= s.market || 'Market not set' %> · <%= formatCategories(s.category) || 'No category' %></small></span></a></td><td><span class="console-status <%= s.status === 'live' ? 'is-live' : '' %>"><%= s.status %></span></td><td><%= s.respondent_count.toLocaleString() %></td><td><%= s.submitted_count.toLocaleString() %></td><td><% if(s.open_flag_count) { %><a class="console-status is-alert" href="/admin/qc?study=<%= s.id %>"><%= s.open_flag_count %> to review</a><% } else { %><span class="text-slate-400">0</span><% } %></td></tr><% }) %>
    </tbody></table></div>
    <div class="console-empty" data-table-empty <%- studies.length ? 'hidden' : '' %>><%- icon('clipboard','w-7 h-7') %><strong>No studies to show</strong><p>Create your first study or adjust your search.</p><a href="/admin/studies#create-study" class="console-button">Create study</a></div>
    <div class="console-table-footer"><span data-table-count><%= studies.length %> studies</span><div class="console-actions"><button type="button" data-table-prev aria-label="Previous page">←</button><span data-table-page>1</span><button type="button" data-table-next aria-label="Next page">→</button></div></div>
  </section>
  <div class="console-stack">
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Needs attention</h2><p>Open quality flags by study</p></div><%- icon('warning','w-4 h-4 text-amber-600') %></div>
      <% attentionStudies.slice(0,5).forEach(s => { %><a class="console-attention-item" href="/admin/qc?study=<%= s.id %>"><%- icon('shield-check','w-4 h-4') %><div><strong><%= s.open_flag_count %> open <%= s.open_flag_count === 1 ? 'flag' : 'flags' %></strong><p><%= s.name %></p></div><span>→</span></a><% }) %>
      <% if(!attentionStudies.length) { %><div class="console-empty"><%- icon('check-circle','w-7 h-7') %><strong>No open study flags</strong><p>Quality issues will appear here when they are recorded.</p></div><% } %>
    </section>
    <section class="console-panel"><div class="console-panel-heading"><h2>Workspace shortcuts</h2></div>
      <% [['/admin/panel','Respondent Panel','Find people across studies','users'],['/admin/users','Users & Access','Manage your research team','user'],['/admin/system-settings','System Settings','Manage background checks','settings']].forEach(([href,label,note,glyph]) => { %><a href="<%= href %>" class="console-attention-item"><%- icon(glyph,'w-4 h-4') %><div><strong><%= label %></strong><p><%= note %></p></div><span>↗</span></a><% }) %>
    </section>
  </div>
</div>
<details id="data-management" class="console-panel console-data-management" <%- deleted ? 'open' : '' %>><summary>Advanced data management · studies & respondent deletion</summary><div class="console-panel-body">
<% if (deleted) { %>
  <div class="mb-5 flex items-start gap-2 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-xl p-3">
    <%- icon('check-circle', 'w-4 h-4 mt-0.5') %>
    <span><%= deleted === 'study' ? 'Study and its study data were permanently deleted.' : 'Respondent and their linked study data were permanently deleted.' %></span>
  </div>
<% } %>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6 console-management-grid">
  <section class="xl:col-span-1 space-y-4">
    <div class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow p-5">
      <div class="font-semibold text-slate-800 mb-1">Studies</div>
      <p class="text-xs text-slate-500 mb-4">Select a study to manage its respondents.</p>
      <div class="space-y-2">
        <% studies.forEach(s => { %>
          <a href="/admin/superadmin?study=<%= s.id %>#data-management" class="block rounded-xl border px-3.5 py-3 transition <%= selectedStudy && selectedStudy.id === s.id ? 'border-signal bg-signal-soft' : 'border-slate-200 hover:bg-slate-50' %>">
            <div class="font-semibold text-sm text-slate-800"><%= s.name %></div>
            <div class="text-xs text-slate-500 mt-1"><%= s.respondent_count %> respondents · <%= s.record_count %> diary records</div>
          </a>
        <% }) %>
        <% if (!studies.length) { %><div class="text-sm text-slate-400">No studies found.</div><% } %>
      </div>
    </div>
  </section>

  <section class="xl:col-span-2 space-y-5">
    <% if (selectedStudy) { %>
      <div class="bg-white rounded-2xl border border-red-200 shadow-card p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div class="text-xs font-semibold uppercase tracking-wide text-red-600 mb-1">Danger zone</div>
            <div class="font-semibold text-slate-900">Delete study permanently</div>
            <p class="text-xs text-slate-500 mt-1 max-w-2xl">Deletes <strong><%= selectedStudy.name %></strong>, all its respondents, diary records, answers, media metadata, QC flags, reminders, questionnaire, brands/SKUs, consent versions, and KPI configuration. This cannot be undone.</p>
          </div>
        </div>
        <form method="POST" action="/admin/superadmin/studies/<%= selectedStudy.id %>/delete" class="flex flex-col sm:flex-row gap-2 mt-4" onsubmit="return confirm('Permanently delete this entire study and all of its study data?');">
          <input name="confirm" required autocomplete="off" placeholder="Type DELETE" class="border border-red-300 rounded-xl px-3.5 py-2.5 text-sm flex-1 focus:outline-none focus:ring-2 focus:ring-red-300" />
          <button class="bg-red-600 text-white rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-red-700 transition">Delete entire study</button>
        </form>
      </div>

      <div class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100">
          <div class="font-semibold text-slate-800">Respondents — <%= selectedStudy.name %></div>
          <p class="text-xs text-slate-500 mt-1"><%= respondents.length %> respondent enrolments in this study.</p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left text-xs uppercase tracking-wide text-slate-400 border-b border-slate-100">
                <th class="px-5 py-3">Respondent</th>
                <th class="py-3">Contact</th>
                <th class="py-3">Status</th>
                <th class="px-5 py-3 text-right">Permanent action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% respondents.forEach(r => { %>
                <tr>
                  <td class="px-5 py-3">
                    <a href="/admin/studies/<%= selectedStudy.id %>/respondents/<%= r.id %>" class="font-semibold text-signal hover:underline"><%= r.name || '(no name)' %></a>
                    <div class="font-mono text-[11px] text-slate-400 mt-0.5"><%= r.respondent_code %></div>
                  </td>
                  <td class="py-3 text-slate-600"><%= r.contact || '—' %></td>
                  <td class="py-3 text-slate-600"><%= r.activation_status || '—' %></td>
                  <td class="px-5 py-3">
                    <form method="POST" action="/admin/superadmin/respondents/<%= r.id %>/delete" class="flex justify-end gap-2" onsubmit="return confirm('Permanently delete this respondent and their diary data?');">
                      <input name="confirm" required autocomplete="off" placeholder="Type DELETE" class="w-28 border border-red-200 rounded-lg px-2.5 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-red-200" />
                      <button class="border border-red-300 text-red-700 bg-red-50 rounded-lg px-3 py-1.5 text-xs font-semibold hover:bg-red-100 transition">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
              <% if (!respondents.length) { %>
                <tr><td colspan="4" class="px-5 py-8 text-center text-slate-400">No respondents in this study.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow p-8 text-center text-slate-400">Create a study before using Superadmin data controls.</div>
    <% } %>
  </section>
</div>


</div></details>
<%- include('../partials/footer') %>
