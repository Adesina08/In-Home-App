<%- include('../partials/header', { title: 'Analysis — INICIO Diary', user, currentPath: '/admin/analysis' }) %>
<link rel="stylesheet" href="/public/reports.css" />
<link rel="stylesheet" href="/public/analysis.css" />
<div class="report-page analysis-page">
  <div class="report-heading"><div><div class="report-kicker">Research workspace / Analysis</div><h1>Turn occasions into understanding.</h1><p class="report-lead">Explore response patterns and compare the people behind them.</p></div><span class="report-badge">Staff analysis</span></div>
  <% if (!study) { %><div class="report-empty"><h2>No studies yet</h2><p>Create a study to start exploring responses.</p><a class="report-button" href="/admin/studies">Open studies</a></div><% } else {
    const query = new URLSearchParams({study:study.id,from,to,question,segment}).toString();
    const chartData = { distribution:distribution.slice(0,12),trend,modes };
  %>
  <form class="report-toolbar analysis-filters" action="/admin/analysis" method="get">
    <label class="analysis-study">Study<select name="study"><% studies.forEach(s=>{ %><option value="<%= s.id %>" <%= s.id===study.id?'selected':'' %>><%= s.name %></option><% }) %></select></label>
    <label>From<input type="date" name="from" value="<%= from %>" /></label><label>To<input type="date" name="to" value="<%= to %>" /></label>
    <label class="analysis-question">Question<select name="question"><option value="">Automatic question</option><% questions.forEach(q=>{ %><option value="<%= q.code %>" <%= q.code===question?'selected':'' %>><%= q.text %></option><% }) %></select></label>
    <label>Compare by<select name="segment"><% Object.entries(segments).forEach(([key,label])=>{ %><option value="<%= key %>" <%= segment===key?'selected':'' %>><%= label %></option><% }) %></select></label>
    <button class="report-button">Apply selection</button><a href="/admin/analysis?study=<%= study.id %>" class="analysis-reset">Reset</a>
  </form>
  <dl class="report-stats"><% [['Eligible occasions',report.eligible,'After consent and quality checks'],['Enrolled respondents',report.respondents.length,'Eligible study cohort'],['Answered occasions',answered,'For the selected question'],['Answering respondents',answerContributors,'Distinct people answering this question']].forEach(([label,value,note])=>{ %><div class="report-stat"><dt><%= label %></dt><dd><%= value %></dd><small><%= note %></small></div><% }) %></dl>
  <div class="report-notice"><strong><%= study.name %></strong> · <%= from||'Study beginning' %> to <%= to||'Latest available date' %>. Practice entries, withdrawn respondents, open entry QC flags, excluded records and unconfirmed AI answers are excluded from the relevant results.</div>
  <div class="report-two analysis-charts">
    <section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Response distribution</div><h2><%= questionLabel %></h2><p><%= answered %> answered occasions · <%= distribution.length>12?'Top 12 answers shown; every answer is in the table below.':'Each bar counts eligible occasions mentioning the answer.' %></p></div></div>
    <% if(distribution.length){ %><div class="analysis-canvas"><canvas id="response-chart" role="img" aria-label="Answer distribution. Exact counts and percentages are in the table below."></canvas></div><details><summary>View distribution data</summary><div class="analysis-scroll" tabindex="0"><table class="report-table"><thead><tr><th scope="col">Answer</th><th scope="col">Occasions</th><th scope="col">Percent</th></tr></thead><tbody><% distribution.forEach(d=>{ %><tr><th scope="row"><%= d.label %></th><td><%= d.n %></td><td><%= d.pct %>%</td></tr><% }) %></tbody></table></div></details><% }else{ %><div class="report-empty">No eligible answers for this question and date selection. Try another question or a wider period.</div><% } %>
    </section>
    <section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Diary rhythm</div><h2>Occasions over time</h2><p>Eligible occasions by occurrence date (UTC), across all questions.</p></div></div>
    <% if(trend.length){ %><div class="analysis-canvas"><canvas id="trend-chart" role="img" aria-label="Daily eligible occasions. Exact values are in the daily counts table."></canvas></div><details><summary>View daily counts</summary><div class="analysis-scroll" tabindex="0"><table class="report-table"><thead><tr><th scope="col">Date</th><th scope="col">Occasions</th></tr></thead><tbody><% trend.forEach(d=>{ %><tr><th scope="row"><%= d.label %></th><td><%= d.n %></td></tr><% }) %></tbody></table></div></details><% }else{ %><div class="report-empty">The trend appears when this period contains eligible diary occasions.</div><% } %>
    </section>
  </div>
  <section class="report-panel"><div class="report-panel-head"><div><div class="report-kicker">Compare consumer groups</div><h2>Crosstab · <%= segments[segment] %></h2><p><%= questionLabel %></p></div><a class="report-button secondary" href="/admin/analysis/export?<%= query %>">Download CSV</a></div>
    <div class="analysis-table-controls"><div role="group" aria-label="Crosstab values"><button type="button" data-cell-mode="percent" aria-pressed="true">Row %</button><button type="button" data-cell-mode="count" aria-pressed="false">Counts</button></div><span>More blue means a higher share within the group.</span></div>
    <% if(distribution.length){ %><div class="analysis-scroll" tabindex="0" role="region" aria-label="Scrollable crosstab"><table class="report-table analysis-matrix"><caption class="sr-only"><%= questionLabel %> by <%= segments[segment] %></caption><thead><tr><th scope="col"><%= segments[segment] %></th><th scope="col">Answering people</th><th scope="col">Answered occasions</th><% distribution.forEach(d=>{ %><th scope="col"><%= d.label %></th><% }) %></tr></thead><tbody><% crosstab.forEach(g=>{ %><tr><th scope="row"><%= g.label %><% if(g.lowBase){ %><small class="analysis-low-base">Low base</small><% } %></th><td><%= g.respondents %></td><td><%= g.answered %></td><% g.cells.forEach(c=>{ %><td style="background:rgba(75,144,204,<%= c.pct===null?0:0.04+c.pct/100*.25 %>)"><span data-cell-value="percent"><%= c.pct===null?'—':c.pct+'%' %></span><span data-cell-value="count" hidden><%= c.n %></span></td><% }) %></tr><% }) %></tbody></table></div><% }else{ %><div class="report-empty">A crosstab needs eligible answers to the selected question. No values have been estimated.</div><% } %>
    <p class="report-muted analysis-footnote">Row percentages use answered occasions within each group. Multiple selections can total more than 100%. Demographics use the latest study profile snapshot, with enrolment details as a fallback when no snapshot exists. Groups with fewer than <%= minimum %> answering respondents are marked “Low base”; staff can inspect them, but comparisons are descriptive.</p>
  </section>
  <div class="report-two">
    <section class="report-panel"><div class="report-kicker">Ways of recording</div><h2>Entry methods</h2><% if(modes.length){ %><div class="analysis-canvas analysis-donut"><canvas id="mode-chart" role="img" aria-label="Entry methods; counts are listed below."></canvas></div><ul class="analysis-legend"><% modes.forEach(m=>{ %><li><span><%= m.label %></span><strong><%= m.n %></strong></li><% }) %></ul><% }else{ %><div class="report-empty">No eligible entry methods to show.</div><% } %></section>
    <section class="report-panel"><div class="report-kicker">Keep exploring</div><h2>Go deeper into the study</h2><p class="report-lead">Use the evidence and research definitions alongside these comparisons.</p><div class="analysis-links"><a href="/admin/ai-summary?study=<%= study.id %>&from=<%= from %>&to=<%= to %>"><strong>AI Summary & respondent media →</strong><span>Read the story, explore word clouds and play recordings.</span></a><a href="/admin/studies/<%= study.id %>/research"><strong>Research workspace →</strong><span>Review themes, participation and reporting settings.</span></a><a href="/admin/qc?study=<%= study.id %>"><strong>Quality control →</strong><span>Review the evidence behind excluded or flagged entries.</span></a></div></section>
  </div>
  <%- include('../partials/research_analytics',{report}) %>
  <script id="analysis-data" type="application/json"><%- JSON.stringify(chartData).replace(/</g,'\\u003c') %></script>
  <script src="/public/vendor/chart.umd.js" defer></script><script src="/public/js/analysis.js" defer></script>
  <% } %>
</div>
<%- include('../partials/footer') %>
