
<%
// "Real" means any provider other than the mock default -- azure_vision or
// gemini_vision for brand detection, azure_speech or gemini_speech for
// transcription -- not a literal match against one Azure provider name,
// which previously showed "unavailable"/mock-mode warnings even while a
// different real provider (e.g. Gemini) was actually running.
const visionOn = !!process.env.BRAND_DETECTION_PROVIDER && process.env.BRAND_DETECTION_PROVIDER !== 'mock';
const speechOn = !!process.env.AUDIO_TRANSCRIPTION_PROVIDER && process.env.AUDIO_TRANSCRIPTION_PROVIDER !== 'mock';
%>
<%- include('../partials/header', { title: study.name + ' — Media Review', user }) %>
<%- include('../partials/study_tabs', { study, tab }) %>
<%- include('../partials/page_header', { eyebrow: 'Diary evidence', title: 'Media Review', subtitle: 'Explore the photos, videos, and voice notes behind each occasion.' }) %>
<div class="console-actions"><span class="console-status <%= visionOn?'is-live':'' %>">Brand detection <%= visionOn?'configured':'unavailable' %></span><span class="console-status <%= speechOn?'is-live':'' %>">Transcription <%= speechOn?'configured':'unavailable' %></span><span style="font-size:11px;color:#5f7189">Provider results appear only after processing.</span></div>
<section class="console-panel" data-table-tools="media" data-page-size="9">
  <div class="console-toolbar"><div class="console-segments"><% [['all','All files'],['photo','Photos'],['video','Videos'],['audio','Audio']].forEach(([value,label])=>{ %><button class="console-segment" type="button" data-table-filter="<%= value %>" aria-pressed="<%= value==='all' %>"><%= label %></button><% }) %></div><label class="console-search"><%- icon('search','w-4 h-4') %><input type="search" data-table-search aria-label="Search evidence" placeholder="Find respondent, period, or result…" /></label></div>
  <div class="console-media-grid"><% items.forEach(m=>{const url=mediaUrl(m.file_path);const isAudio=m.media_type==='audio';
    // Every media type can now carry a brand result: photo and video from a
    // visual read, audio from its transcript (there's no frame to look at in
    // a voice note, so that one comes from what was said, not what was
    // shown). Transcript itself still only applies to audio and video.
    const hasBrand=true, hasTranscript=m.media_type!=='photo';
    const transcriptStatus=m.transcript_status||'unavailable', detectionStatus=m.detection_status||'unavailable'; %>
    <article class="console-media-card" data-table-row data-status="<%= m.media_type %>"><div class="console-media-preview"><% if(!url){ %><div class="console-empty"><%- icon(isAudio?'mic':'photo','w-7 h-7') %><strong>File unavailable</strong><p>The media link is not available.</p></div><% } else if(m.media_type==='photo'){ %><a href="<%= url %>" target="_blank" rel="noopener"><img src="<%= url %>" loading="lazy" alt="Photo evidence from <%= m.respondent_code %>" /></a><% } else if(m.media_type==='video'){ %><video controls preload="metadata" src="<%= url %>"></video><% } else if(isAudio){ %><div class="console-audio-preview"><%- icon('mic','w-7 h-7') %><audio controls preload="none" src="<%= url %>"></audio></div><% } else { %><a href="<%= url %>" target="_blank" rel="noopener">Open file</a><% } %></div>
    <div class="console-media-info"><div class="console-actions" style="justify-content:space-between"><strong><%= m.respondent_code || 'Respondent' %></strong><span class="console-status"><%= m.media_type %></span></div><p><%= m.period_label || 'Period not recorded' %> · <%= m.upload_time || 'Time unavailable' %></p>
    <% if (hasTranscript) { %><div class="console-media-result"><span class="console-status <%= transcriptStatus==='done'?'is-live':transcriptStatus==='error'?'is-danger':'' %>">transcript: <%= transcriptStatus %></span><p><%= m.transcript_text || 'No transcript available.' %></p></div><% } %>
    <% if (hasBrand) { %><div class="console-media-result"><span class="console-status <%= detectionStatus==='done'?'is-live':detectionStatus==='error'?'is-danger':'' %>">brand: <%= detectionStatus %></span><p><%= m.detected_brand || 'No detected brand available.' %><% if (m.detection_category) { %> · <%= m.detection_category %><% } %><% if (m.detection_confidence != null) { %> · <%= Math.round(Number(m.detection_confidence) * 100) %>% confidence<% } %></p></div><% } %>
    <% if (hasBrand && detectionStatus === 'needs_review' && m.detected_brand) { %><div class="console-actions"><form method="POST" action="/admin/media/<%= m.id %>/brand-review"><input type="hidden" name="action" value="confirm"><button class="console-button">Confirm <%= m.detected_brand %></button></form><form method="POST" action="/admin/media/<%= m.id %>/brand-review"><input type="hidden" name="action" value="reject"><button class="console-button">Reject</button></form></div><% } %>
    <div class="console-actions" style="justify-content:space-between;flex-wrap:wrap"><a class="console-button" href="/admin/studies/<%= study.id %>/records/<%= m.record_id %>">View entry ↗</a><% if (hasTranscript) { %><form method="POST" action="/admin/media/<%= m.id %>/transcribe"><button class="console-button"><%- icon('refresh','w-3 h-3') %>Transcribe</button></form><% } %><% if (hasBrand) { %><form method="POST" action="/admin/media/<%= m.id %>/detect"><button class="console-button"><%- icon('refresh','w-3 h-3') %>Detect brand</button></form><% } %></div></div>
    </article><% }) %></div>
  <div class="console-empty" data-table-empty <%- items.length?'hidden':'' %>><%- icon('photo','w-7 h-7') %><strong>No media to show</strong><p>Evidence will appear as respondents upload it. Adjust your filters if you are looking for a particular file.</p></div>
  <div class="console-table-footer"><span data-table-count><%= items.length %> files</span><div class="console-actions"><button type="button" data-table-prev aria-label="Previous page">←</button><span data-table-page>1</span><button type="button" data-table-next aria-label="Next page">→</button></div></div>
</section>
<%- include('../partials/study_nav', { study, tab }) %>
<%- include('../partials/footer') %>
