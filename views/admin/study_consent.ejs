<%- include('../partials/header', { title: study.name + ' — Consent', user, currentPath: '/admin/studies' }) %>
<%- include('../partials/study_tabs', { study, tab, stepper: true }) %>
<% const approved=versions.find(v=>v.status==='approved'); const drafts=versions.filter(v=>v.status!=='approved'); %>
<%- include('../partials/page_header', { eyebrow:'Consent & permissions', title:'Consent', subtitle:'Write, preview and approve the exact wording respondents see.' }) %>
<div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.25fr)_minmax(340px,.75fr)] gap-6">
  <main class="space-y-6">
    <section class="rounded-[22px] bg-brand text-white p-6 shadow-card"><div class="flex justify-between gap-4"><div><div class="font-mono text-[10px] uppercase tracking-widest text-blue-200">Currently shown to respondents</div><h2 class="font-display text-2xl font-bold mt-2"><%= approved ? 'Approved consent · Version '+approved.version : 'No approved consent yet' %></h2><p class="text-sm text-blue-100 mt-2"><%= approved ? 'Approved by '+approved.approved_by+' · '+approved.approved_at : 'Recruitment remains blocked until one version is approved.' %></p></div><span class="h-fit rounded-full px-3 py-1 text-xs font-semibold <%= approved?'bg-emerald-400/20 text-emerald-100':'bg-amber-300/20 text-amber-100' %>"><%= approved?'LIVE':'ACTION NEEDED' %></span></div></section>
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Respondent preview</h2><p>This is how the approved wording reads before the respondent agrees.</p></div></div><div class="p-6"><% if(approved){ %><div class="max-w-xl mx-auto rounded-[28px] border-[8px] border-slate-900 bg-white p-6 shadow-xl"><div class="text-xs font-bold text-signal uppercase">INICIO · <%= study.name %></div><h3 class="font-display text-xl font-bold mt-3">Before you take part</h3><div class="whitespace-pre-wrap text-sm text-slate-600 leading-7 mt-4"><%= approved.body %></div><button type="button" class="mt-5 w-full rounded-xl bg-signal text-white py-3 font-semibold">I agree to take part</button></div><% }else{ %><div class="console-empty">Approve a version to display the respondent preview.</div><% } %></div></section>
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Version history</h2><p>Every draft and approval remains auditable.</p></div></div><div class="divide-y"><% versions.forEach(v=>{ %><details class="p-5" <%= v===approved?'open':'' %>><summary class="cursor-pointer flex items-center justify-between"><span class="font-semibold">Version <%= v.version %></span><span class="console-status <%= v.status==='approved'?'is-live':'' %>"><%= v.status %></span></summary><div class="whitespace-pre-wrap text-sm text-slate-600 mt-4"><%= v.body %></div><% if(v.status!=='approved'){ %><form method="post" action="/admin/studies/<%= study.id %>/consent/<%= v.id %>/approve" class="mt-4"><button class="console-button is-primary">Approve this version</button></form><% } %></details><% }) %><% if(!versions.length){ %><div class="console-empty">No consent wording has been drafted.</div><% } %></div></section>
  </main>
  <aside class="console-panel h-fit sticky top-6"><div class="console-panel-heading"><div><h2>Draft new wording</h2><p>Saving creates a new version. It does not replace the approved version.</p></div></div><form method="post" action="/admin/studies/<%= study.id %>/consent" class="p-5 space-y-4"><label class="block text-sm font-medium">Consent wording<textarea name="body" required rows="18" class="mt-2 w-full border border-slate-300 rounded-xl p-3 text-sm leading-6" placeholder="Enter the approved legal and ethics wording…"></textarea></label><button class="w-full console-button is-primary justify-center">Save as draft</button></form></aside>
</div>
<%- include('../partials/study_nav', { study, tab }) %>
<%- include('../partials/footer') %>
