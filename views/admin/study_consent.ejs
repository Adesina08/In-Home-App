<%- include('../partials/header', { title: study.name + ' — Consent Wording', user, currentPath: '/admin/studies' }) %>
<%- include('../partials/study_tabs', { study, tab, stepper: true }) %>
<% if(user.role === 'superadmin') { %><%- include('../partials/page_header', { eyebrow: 'Consent & permissions', title: 'Consent Wording', subtitle: 'Manage versioned wording and approve the consent respondents will see.' }) %><% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
  <div class="lg:col-span-2 space-y-4">
    <% versions.forEach(v => { %>
      <div class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow p-5">
        <div class="flex items-center justify-between mb-2.5">
          <div class="font-semibold text-slate-800 flex items-center gap-2"><%- icon('shield', 'w-4 h-4 text-signal') %> Version <%= v.version %></div>
          <% if (v.status === 'approved') { %>
            <span class="text-xs px-2.5 py-1 rounded-full font-medium badge-green flex items-center gap-1"><%- icon('check', 'w-3 h-3') %> Approved by <%= v.approved_by %> · <%= v.approved_at %></span>
          <% } else { %>
            <form method="POST" action="/admin/studies/<%= study.id %>/consent/<%= v.id %>/approve">
              <button class="text-xs px-3 py-1.5 rounded-full font-medium badge-amber hover:opacity-80">Draft — Approve now</button>
            </form>
          <% } %>
        </div>
        <div class="text-sm text-slate-600 whitespace-pre-wrap leading-relaxed"><%= v.body %></div>
      </div>
    <% }) %>
    <% if (!versions.length) { %><div class="bg-white rounded-2xl border-2 border-dashed border-slate-200 p-8 text-center text-slate-400">No consent wording drafted yet.</div><% } %>
  </div>

  <div class="bg-white rounded-[18px] border border-[#EDF0F4] shadow-card hover:shadow-card-hover transition-shadow p-5 h-fit">
    <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2"><%- icon('plus', 'w-4 h-4 text-signal') %> Draft New Consent Wording</div>
    <form method="POST" action="/admin/studies/<%= study.id %>/consent" class="space-y-3.5 text-sm">
      <textarea name="body" required rows="8" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-signal/30 focus:border-signal transition" placeholder="Enter the approved legal/ethics consent wording for this study..."></textarea>
      <button class="w-full inline-flex items-center justify-center gap-1.5 bg-signal text-white rounded-xl py-2.5 font-semibold text-sm hover:bg-signal-bright transition shadow-card"><%- icon('check', 'w-4 h-4') %> Save Draft</button>
    </form>
    <p class="text-xs text-slate-400 mt-3 leading-relaxed">Consent must be marked <strong class="text-slate-500">Approved</strong> here before it is shown to respondents. Respondent-facing pages always pull the latest approved version.</p>
  </div>
</div>

<%- include('../partials/study_nav', { study, tab }) %>

<%- include('../partials/footer') %>
