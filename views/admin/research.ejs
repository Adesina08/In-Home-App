<%- include('../partials/header',{title:study.name+' · Research workspace'}) %>
<link rel="stylesheet" href="/public/reports.css" />
<div class="report-page"><a class="report-button secondary" href="/admin/studies/<%= study.id %>">← Study settings</a><div class="report-heading"><div><div class="report-kicker"><%= study.name %></div><h1>Research workspace</h1><p class="report-lead">From fieldwork readiness to reviewed, reproducible findings.</p></div></div>
<% const action=name=>'/admin/studies/'+study.id+'/research/'+name; const input=(name,label,value='',type='text')=>''; %>
<% if(error){ %><div role="alert" class="report-notice"><%= error %></div><% } %><% if(saved){ %><div role="status" class="report-notice">Changes saved.</div><% } %>
<nav class="report-toolbar" aria-label="Research sections"><% [['analysis','Analysis'],['fieldwork','Fieldwork'],['incentives','Incentives'],['reports','Reports'],['governance','Access & governance']].forEach(([id,label])=>{ %><a href="#<%= id %>" class="report-button secondary"><%= label %></a><% }) %></nav>
<section id="analysis"><form class="report-toolbar" method="get"><label>From<input name="from" type="date" value="<%= period.from %>" /></label><label>To<input name="to" type="date" value="<%= period.to %>" /></label><label>Segment<select name="segment"><% SEGMENTS.forEach(s=>{ %><option <%= data.segment===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Question code<input name="question" value="<%= data.question %>" /></label><label><input name="compare" value="1" type="checkbox" /> Compare previous period</label><label>Ask about this study<input name="ask" value="<%= ask %>" placeholder="Compare brands by age" /></label><button class="report-button">Analyse</button></form>
<% if(ask){ %><p class="report-notice"><%= query.label %>. Questions select supported calculations; no model estimates are used.</p><% } %>
<%- include('../partials/research_analytics',{report:data.report}) %>
<section class="report-panel"><h2><%= data.questionLabel %> by <%= data.segment %></h2><p>Percentages use answered occasions within each group. Small groups are marked for suppression in client reporting.</p><div style="overflow-x:auto" tabindex="0" role="region" aria-label="Scrollable research results"><div tabindex="0" role="region" aria-label="Research table" style="max-width:100%;overflow-x:auto"><table class="report-table"><thead><tr><th>Group</th><th>Respondents</th><th>Answered occasions</th><th>Answer distribution</th></tr></thead><tbody><% data.crossTabs.forEach(c=>{ %><tr><td><%= c.group %></td><td><%= c.base %><%= c.suppressed?' · small base':'' %></td><td><%= c.answered %></td><td><%= c.values.map(v=>v.label+': '+v.n+' ('+v.pct+'%)').join('; ')||'No eligible answers' %></td></tr><% }) %></tbody></table></div></div></section>
<% if(data.comparison){ %><section class="report-panel"><h2>Previous period: <%= data.comparison.from %> – <%= data.comparison.to %></h2><div tabindex="0" role="region" aria-label="Research table" style="max-width:100%;overflow-x:auto"><table class="report-table"><thead><tr><th>Brand</th><th>Current incidence</th><th>Previous incidence</th><th>Change (percentage points)</th></tr></thead><tbody><% data.comparison.brands.forEach(b=>{ %><tr><td><%= b.brand %></td><td><%= b.current??'—' %></td><td><%= b.previous??'—' %></td><td><%= b.change??'—' %></td></tr><% }) %></tbody></table></div><p>Descriptive comparison; no statistical significance is implied.</p></section><% } %>
<section class="report-panel"><h2>Observed brand transitions</h2><p>Consecutive single-brand occasions from the same respondent, within the selected dates.</p><div tabindex="0" role="region" aria-label="Research table" style="max-width:100%;overflow-x:auto"><table class="report-table"><thead><tr><th>From</th><th>To</th><th>Transitions</th></tr></thead><tbody><% data.report.analytics.transitions.forEach(t=>{ %><tr><td><%= t.from %></td><td><%= t.to %></td><td><%= t.n %></td></tr><% }) %></tbody></table></div></section>
<section class="report-panel"><h2>Reviewed themes</h2><p><%= data.themes.map(t=>t.name+': '+t.n).join(' · ')||'No approved coding in this selection.' %></p><form class="report-toolbar" method="post" action="<%= action('theme') %>"><label>Theme name<input name="name" required /></label><button class="report-button">Create theme</button></form><form class="report-toolbar" method="post" action="<%= action('code-theme') %>"><label>Record ID<input name="record_id" type="number" required /></label><label>Theme<select name="theme_id"><% themes.forEach(t=>{ %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></label><button class="report-button">Approve coding</button></form></section></section>
<section id="fieldwork" class="report-panel"><h2>Fieldwork assignments</h2><form method="post" action="<%= action('assignment') %>" class="report-toolbar"><label>Interviewer<select name="user_id"><% users.filter(u=>u.role==='interviewer').forEach(u=>{ %><option value="<%= u.id %>"><%= u.name||u.email %></option><% }) %></select></label><label>Area / cluster<input name="area" /></label><label>Household target<input type="number" min="1" name="household_target" /></label><label><input type="checkbox" name="enabled" value="1" checked /> Assignment active</label><button class="report-button">Save assignment</button></form><% lists.interviewer_assignments.forEach(a=>{ %><p>Interviewer <%= a.user_id %> · <%= a.area||'Area not set' %> · target <%= a.household_target||'not set' %> · <%= a.enabled?'Active':'Disabled' %></p><% }) %>
<h3 style="margin-top:24px">Household visits</h3><form class="report-toolbar" method="post" action="<%= action('visit') %>"><label>Interviewer<select name="user_id"><% users.filter(u=>u.role==='interviewer').forEach(u=>{ %><option value="<%= u.id %>"><%= u.name||u.email %></option><% }) %></select></label><label>Household reference<input name="household_code" required /></label><label>Visit location<input name="address" required /></label><label>Planned date<input name="visit_date" type="date" required /></label><button class="report-button">Assign visit</button></form><% lists.fieldwork_visits.forEach(v=>{ %><p><%= v.household_code %> · <%= v.visit_date %> · Interviewer <%= v.user_id %> · <%= v.status %> · <%= v.notes||'' %></p><% }) %>
<h3 style="margin-top:24px">Supervisor backcheck</h3><form method="post" action="<%= action('backcheck') %>" class="report-toolbar"><label>Respondent<select name="respondent_id"><% respondents.forEach(r=>{ %><option value="<%= r.id %>"><%= r.respondent_code %> · <%= r.name %></option><% }) %></select></label><label>Result<select name="result"><option>pending</option><option>passed</option><option>failed</option></select></label><label>Notes<input name="notes" required /></label><button class="report-button">Record backcheck</button></form><% lists.backchecks.forEach(b=>{ %><p><%= b.created_at %> · Respondent <%= b.respondent_id %> · <%= b.result %> · <%= b.notes %></p><% }) %>
<h3 style="margin-top:24px">Question timing, rotation and loops</h3><p>Question types, options and scale limits are edited in the questionnaire builder. Timing uses UTC hours; nth-occasion rules count accepted submission order.</p><form class="report-toolbar" method="post" action="<%= action('advanced-question') %>"><label>Question<select name="question_id"><% data.report.questions.filter(q=>q.active).forEach(q=>{ %><option value="<%= q.id %>"><%= q.code %> · <%= q.text %></option><% }) %></select></label><label>Every nth occasion<input name="every_nth_occasion" type="number" min="1" /></label><label>From UTC hour<input name="from_hour_utc" type="number" min="0" max="23" /></label><label>Until UTC hour<input name="to_hour_utc" type="number" min="0" max="23" /></label><label><input name="rotate_options" type="checkbox" value="1" /> Rotate options per respondent</label><button class="report-button">Save question behaviour</button></form><form class="report-toolbar" method="post" action="<%= action('loop') %>"><label>Repeat question<select name="question_id"><% data.report.questions.filter(q=>q.active&&!q.loop_source_id).forEach(q=>{ %><option value="<%= q.id %>"><%= q.code %> · <%= q.text %></option><% }) %></select></label><label>Loop type<select name="kind"><option value="product">Products</option><option value="member">Household members</option></select></label><label>Items / member labels, one per line<textarea name="items" required rows="4"></textarea></label><button class="report-button">Create repeated questions</button></form>
<details style="margin-top:24px"><summary>Configure the screener and close-out questions</summary><p>Each screener question needs code, text, options and allowed answers. The system evaluates eligibility from the answers. Close-out supports single-choice and text questions.</p><form method="post" action="<%= action('instrument') %>"><label style="display:block">Screener JSON<textarea name="screener_questions" rows="10" style="width:100%;border:1px solid #cbd5e1;padding:12px" placeholder='[{"code":"category_user","text":"Do you use this category?","options":["Yes","No"],"allowed":["Yes"]}]'><%= JSON.stringify(study.screener_questions||[],null,2) %></textarea></label><label style="display:block">Close-out JSON (empty array uses the standard questions)<textarea name="close_out_questions" rows="8" style="width:100%;border:1px solid #cbd5e1;padding:12px"><%= JSON.stringify(study.close_out_questions||[],null,2) %></textarea></label><button class="report-button">Save instruments</button></form></details></section>
<section id="incentives" class="report-panel"><h2>Milestone incentives</h2><p>Configure agreed rewards. Eligibility never depends on a brand choice or extra consumption.</p><form class="report-toolbar" method="post" action="<%= action('incentive-rule') %>"><label>Milestone<select name="milestone"><option value="onboarding">Onboarding handover</option><option value="participation">Completed participation periods</option><option value="closeout">Final validation</option></select></label><label>Required periods<input name="required_periods" type="number" min="1" /></label><label>Amount<input name="amount" type="number" step="0.01" min="0.01" required /></label><label>Currency<input name="currency" maxlength="3" pattern="[A-Z]{3}" required placeholder="NGN" /></label><button class="report-button">Add reward rule</button></form><% lists.incentive_rules.forEach(r=>{ %><p>Rule <%= r.id %>: <%= r.milestone %> · <%= r.currency %> <%= r.amount %><%= r.required_periods?' · '+r.required_periods+' periods':'' %> · <%= r.enabled?'Active':'Disabled' %></p><% if(r.enabled){ %><form method="post" action="<%= action('disable-rule') %>"><input type="hidden" name="id" value="<%= r.id %>" /><button class="report-button secondary">Disable rule</button></form><% } %><% }) %><form method="post" action="<%= action('incentive-evaluate') %>"><button class="report-button secondary">Refresh eligibility</button></form><div tabindex="0" role="region" aria-label="Research table" style="max-width:100%;overflow-x:auto"><table class="report-table"><thead><tr><th>Respondent</th><th>Milestone</th><th>Reward</th><th>Status</th><th>Payment record</th></tr></thead><tbody><% lists.incentive_ledger.forEach(l=>{ %><tr><td><%= l.respondent_id %></td><td><%= l.milestone %></td><td><%= l.currency %> <%= l.amount %></td><td><%= l.status %></td><td><% if(l.status==='eligible'){ %><form method="post" action="<%= action('incentive-pay') %>"><input name="ledger_id" type="hidden" value="<%= l.id %>" /><input name="reference" aria-label="Payment reference" placeholder="Completed payment reference" required /><button class="report-button secondary">Record paid</button></form><% }else{ %><%= l.payment_reference||'—' %><% } %></td></tr><% }) %></tbody></table></div></section>
<section id="reports" class="report-panel"><h2>Report snapshots & approval</h2><form class="report-toolbar" method="post" action="<%= action('snapshot') %>"><label>From<input name="from" type="date" /></label><label>To<input name="to" type="date" /></label><button class="report-button">Save report snapshot</button></form><% lists.report_snapshots.forEach(s=>{ %><details><summary><%= s.created_at %> · <%= s.status %> · <%= s.period_start||'All dates' %> – <%= s.period_end||'Today' %></summary><pre style="overflow:auto;max-height:320px"><%= JSON.stringify(s.payload,null,2) %></pre><form method="post" action="<%= action('approve-report') %>"><input type="hidden" name="id" value="<%= s.id %>" /><button class="report-button secondary">Approve reviewed snapshot</button></form></details><% }) %>
<h3 style="margin-top:24px">Narrative review</h3><% summaries.forEach(s=>{ %><details><summary><%= s.generated_at %> · <%= s.review_status||'Needs review' %></summary><form method="post" action="<%= action('approve-summary') %>"><input type="hidden" name="id" value="<%= s.id %>" /><label>Client narrative<textarea name="narrative" rows="8" style="width:100%;border:1px solid #cbd5e1;padding:12px"><%= s.client_narrative||s.narrative %></textarea></label><button class="report-button">Approve for clients</button></form></details><% }) %>
<h3 style="margin-top:24px">Scheduled reports & internal alerts</h3><p>Creates a draft aggregate snapshot and an internal alert when compliance falls below your threshold.</p><form class="report-toolbar" method="post" action="<%= action('schedule') %>"><label>First run<input name="next_run" type="date" required /></label><label>Every (days)<input name="interval_days" type="number" min="1" required /></label><label>Look back (days)<input name="lookback_days" type="number" min="1" required /></label><label>Alert below compliance %<input name="compliance_below" type="number" min="0" max="100" required /></label><button class="report-button">Create schedule</button></form><% lists.report_schedules.forEach(s=>{ %><p>Schedule <%= s.id %> · next run <%= s.next_run %> · last success <%= s.last_success_at||'Not run' %> · <%= s.last_error||'No recorded error' %> · <%= s.enabled?'Active':'Disabled' %></p><% if(s.enabled){ %><form method="post" action="<%= action('disable-schedule') %>"><input type="hidden" name="id" value="<%= s.id %>" /><button class="report-button secondary">Disable schedule</button></form><% } %><% }) %><form method="post" action="<%= action('run-jobs') %>"><button class="report-button secondary">Run due reports</button></form><% lists.research_alerts.forEach(a=>{ %><p role="status"><%= a.created_at %> · <%= a.message %></p><% }) %></section>
<section id="governance" class="report-panel"><h2>Methodology & access</h2><form class="report-toolbar" method="post" action="<%= action('settings') %>"><label>Entries per participation period<input name="required_entries_per_period" type="number" min="1" value="<%= study.required_entries_per_period||1 %>" required /></label><label>Hybrid summary cadence<select name="hybrid_summary_cadence"><option value="weekly">Weekly</option><option value="daily" <%= study.hybrid_summary_cadence==='daily'?'selected':'' %>>Daily</option></select></label><label>Minimum client base<input name="minimum_base_size" type="number" min="2" value="<%= study.minimum_base_size||5 %>" required /></label><label>Brand question code<input name="brand_question_code" value="<%= study.brand_question_code||'brand' %>" /></label><label>Quantity question code<input name="quantity_question_code" value="<%= study.quantity_question_code||'quantity' %>" /></label><label>Comparable volume unit<input name="volume_unit" value="<%= study.volume_unit||'' %>" /></label><label>Quantity × conversion factor<input name="volume_unit_factor" type="number" step="any" value="<%= study.volume_unit_factor||'' %>" /></label><label>Retention days after withdrawal/end<input name="retention_days" type="number" min="1" value="<%= study.retention_days||'' %>" /></label><label><input type="checkbox" name="require_record_approval" value="1" <%= study.require_record_approval?'checked':'' %> /> Only include accepted records</label><button class="report-button">Save methodology</button></form>
<form class="report-toolbar" method="post" action="<%= action('grant') %>"><label>Client account<select name="user_id"><% users.filter(u=>u.role==='client').forEach(u=>{ %><option value="<%= u.id %>"><%= u.name||u.email %></option><% }) %></select></label><% [['enabled','Study access'],['media','Consented media'],['text','Verbatim text'],['exports','CSV exports']].forEach(([key,label])=>{ %><label><input name="<%= key %>" value="1" type="checkbox" /> <%= label %></label><% }) %><button class="report-button">Save client permissions</button></form><% lists.client_grants.forEach(g=>{ %><p>Client <%= g.user_id %> · access <%= !!g.enabled %> · media <%= !!g.media %> · text <%= !!g.text %> · exports <%= !!g.exports %></p><% }) %>
<h3>Record release decisions</h3><form class="report-toolbar" method="post" action="<%= action('record-review') %>"><label>Record ID<input name="record_id" type="number" required /></label><label>Decision<select name="status"><option>accepted</option><option>excluded</option><option>pending</option></select></label><label>Reason<input name="reason" required /></label><button class="report-button">Record decision</button></form><h3>Submission recovery</h3><% if(!syncIssues.length){ %><p>No interrupted server submissions are recorded.</p><% } %><% syncIssues.forEach(s=>{ %><p>Respondent <%= s.respondent_id %> · <%= s.state %> · <%= s.last_error||'Upload in progress' %> · <%= s.last_attempt_at||s.created_at %></p><% }) %><p>Respondents retry from Saved on this device. Interrupted uploads retain the same submission identifier.</p><h3>Withdrawal & retention</h3><form class="report-toolbar" method="post" action="<%= action('withdraw') %>"><label>Respondent requesting withdrawal<select name="respondent_id"><% respondents.filter(r=>!r.withdrawn_at).forEach(r=>{ %><option value="<%= r.id %>"><%= r.respondent_code %> · <%= r.name %></option><% }) %></select></label><button class="report-button secondary">Record withdrawal</button></form><p>Withdrawal immediately blocks participation and media access and sends previously released reports for review.</p><h4>Due for retention deletion</h4><% if(!retention.length){ %><p>No participation records are due under the configured retention policy.</p><% } %><% retention.forEach(r=>{ %><form class="report-toolbar" method="post" action="<%= action('erase') %>"><input name="respondent_id" type="hidden" value="<%= r.id %>" /><label>Type <%= r.respondent_code %> to erase this study participation<input name="confirm" required /></label><button class="report-button secondary">Erase due participation</button></form><% }) %>
<details><summary>Recent audit events</summary><% lists.research_audit.forEach(a=>{ %><p><%= a.created_at %> · <%= a.actor %> · <%= a.action %></p><% }) %></details></section>
</div><%- include('../partials/footer') %>
