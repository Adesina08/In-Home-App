<%- include('../partials/header', { title: 'Admin Dashboard — INICIO', user }) %>

<%
  const compliancePct = expected > 0 ? Math.round((completed / expected) * 100) : 0;
  const draftPct = expected > 0 ? Math.round((missed / expected) * 100) : 0;
  const riskTotal = riskCounts.green + riskCounts.amber + riskCounts.red;
  const greenPct = riskTotal > 0 ? Math.round((riskCounts.green / riskTotal) * 100) : 0;
  const amberPct = riskTotal > 0 ? Math.round((riskCounts.amber / riskTotal) * 100) : 0;
  const redPct = riskTotal > 0 ? Math.round((riskCounts.red / riskTotal) * 100) : 0;
  const criticalShown = openFlags.filter(f => f.severity === 'critical' || f.severity === 'high').length;
  const funnelStages = [
    ['invited', 'Invited'],
    ['screened', 'Screened'],
    ['registered', 'Registered'],
    ['activated', 'Activated'],
    ['active', 'Active']
  ];
  const funnelMax = Math.max(...funnelStages.map(([key]) => funnelMap[key] || 0), 1);
  const overallRisk = riskCounts.red > 0 ? 'Red' : (riskCounts.amber > 0 ? 'Amber' : 'Green');
%>

<style>
  .ops-card { background:#fff; border:1px solid #e2e8f0; border-radius:18px; box-shadow:0 1px 2px rgba(15,23,42,.03); }
  .ops-kpi { min-height:132px; }
  .ops-label { color:#64748b; font-size:12px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; }
  .ops-number { color:#0f172a; font-size:34px; line-height:1; font-weight:750; letter-spacing:-.035em; }
  .ops-muted { color:#64748b; font-size:12px; }
  .ops-icon { width:42px; height:42px; border-radius:14px; display:flex; align-items:center; justify-content:center; }
  .ops-progress { height:7px; background:#eef2f7; border-radius:999px; overflow:hidden; }
  .ops-progress > span { display:block; height:100%; border-radius:999px; }
  .ops-section-title { color:#0f172a; font-size:15px; font-weight:700; }
  .ops-table th { color:#94a3b8; font-size:11px; text-transform:uppercase; letter-spacing:.045em; font-weight:700; }
  .ops-table td { border-top:1px solid #f1f5f9; }
  .risk-ring { width:138px; height:138px; border-radius:50%; position:relative; background:conic-gradient(#22c55e 0 calc(var(--green)*1%), #f59e0b calc(var(--green)*1%) calc((var(--green) + var(--amber))*1%), #ef4444 calc((var(--green) + var(--amber))*1%) 100%); }
  .risk-ring:after { content:''; position:absolute; inset:23px; background:white; border-radius:50%; }
  .risk-ring-center { position:absolute; inset:0; z-index:1; display:flex; align-items:center; justify-content:center; flex-direction:column; }
  .funnel-step { position:relative; background:#eff6ff; border:1px solid #dbeafe; border-radius:14px; }
  .attention-row + .attention-row { border-top:1px solid #f1f5f9; }
  @media (max-width: 640px) {
    .ops-number { font-size:29px; }
    .risk-ring { width:118px; height:118px; }
  }
</style>

<div class="flex flex-wrap items-start justify-between gap-4 mb-6">
  <div class="min-w-0">
    <div class="text-xs font-semibold text-brand-500 uppercase tracking-wide mb-1">Fieldwork control</div>
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Admin Dashboard</h1>
    <p class="text-slate-500 text-sm mt-1">A live view of recruitment, diary progress and data-quality risks.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/admin/qc?study=<%= study.id %>" class="inline-flex items-center gap-1.5 bg-white border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">
      <%- icon('shield', 'w-4 h-4 text-brand-600') %> QC Worklist
    </a>
    <a href="/admin/studies/<%= study.id %>" class="inline-flex items-center gap-1.5 bg-brand-700 text-white rounded-xl px-3.5 py-2.5 text-sm font-semibold hover:bg-brand-600 transition">
      <%- icon('cog', 'w-4 h-4') %> Study Config
    </a>
  </div>
</div>

<div class="ops-card p-4 sm:p-5 mb-5">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full <%= study.status === 'live' ? 'badge-green' : 'bg-slate-100 text-slate-600' %>">
          <span class="w-1.5 h-1.5 rounded-full <%= study.status === 'live' ? 'bg-emerald-500' : 'bg-slate-400' %>"></span>
          <%= study.status === 'live' ? 'Live fieldwork' : study.status %>
        </span>
        <% if (study.market) { %><span class="text-xs text-slate-400"><%= study.market %></span><% } %>
        <% if (study.diary_mode) { %><span class="text-xs text-slate-400">• <%= study.diary_mode %> diary</span><% } %>
      </div>
      <div class="font-bold text-slate-900 text-lg mt-2 truncate"><%= study.name %></div>
    </div>
    <div class="flex items-center gap-2 min-w-0">
      <label for="study-select" class="text-xs font-semibold text-slate-500 whitespace-nowrap">Study</label>
      <select id="study-select" onchange="window.location='/admin?study='+this.value" class="min-w-0 border border-slate-300 rounded-xl px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-400">
        <% studies.forEach(s => { %>
          <option value="<%= s.id %>" <%= s.id === study.id ? 'selected' : '' %>><%= s.name %></option>
        <% }) %>
      </select>
    </div>
  </div>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-5">
  <div class="ops-card ops-kpi p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="ops-icon bg-blue-50 text-blue-600"><%- icon('users', 'w-5 h-5') %></div>
      <span class="ops-muted">Current study</span>
    </div>
    <div class="ops-label mt-4">Respondents</div>
    <div class="ops-number mt-2"><%= totalRespondents %></div>
  </div>

  <div class="ops-card ops-kpi p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="ops-icon bg-emerald-50 text-emerald-600"><%- icon('check-circle', 'w-5 h-5') %></div>
      <span class="text-xs font-semibold <%= compliancePct >= 80 ? 'text-emerald-600' : compliancePct >= 60 ? 'text-amber-600' : 'text-rose-600' %>"><%= compliancePct %>%</span>
    </div>
    <div class="ops-label mt-4">Diary completion</div>
    <div class="ops-number mt-2"><%= completed %><span class="text-lg text-slate-400 font-semibold"> / <%= expected %></span></div>
  </div>

  <div class="ops-card ops-kpi p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="ops-icon bg-amber-50 text-amber-600"><%- icon('warning', 'w-5 h-5') %></div>
      <span class="ops-muted"><%= draftPct %>% of records</span>
    </div>
    <div class="ops-label mt-4">Draft / incomplete</div>
    <div class="ops-number mt-2"><%= missed %></div>
  </div>

  <div class="ops-card ops-kpi p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="ops-icon bg-rose-50 text-rose-600"><%- icon('shield', 'w-5 h-5') %></div>
      <span class="ops-muted">Latest queue</span>
    </div>
    <div class="ops-label mt-4">Priority QC shown</div>
    <div class="ops-number mt-2"><%= criticalShown %></div>
  </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-12 gap-5 mb-5">
  <section class="ops-card p-5 xl:col-span-5">
    <div class="flex items-center justify-between gap-3 mb-5">
      <div>
        <div class="ops-section-title">Fieldwork Health</div>
        <div class="ops-muted mt-1">Current study progress at a glance</div>
      </div>
      <span class="text-xs font-bold px-2.5 py-1 rounded-full <%= overallRisk === 'Red' ? 'badge-red' : overallRisk === 'Amber' ? 'badge-amber' : 'badge-green' %>"><%= overallRisk %></span>
    </div>

    <div class="space-y-5">
      <div>
        <div class="flex items-center justify-between text-sm mb-2"><span class="text-slate-600">Diary completion</span><span class="font-semibold text-slate-800"><%= compliancePct %>%</span></div>
        <div class="ops-progress"><span class="<%= compliancePct >= 80 ? 'bg-emerald-500' : compliancePct >= 60 ? 'bg-amber-500' : 'bg-rose-500' %>" style="width:<%= Math.min(compliancePct, 100) %>%"></span></div>
      </div>
      <div>
        <div class="flex items-center justify-between text-sm mb-2"><span class="text-slate-600">Respondent risk — green</span><span class="font-semibold text-slate-800"><%= greenPct %>%</span></div>
        <div class="ops-progress"><span class="bg-emerald-500" style="width:<%= greenPct %>%"></span></div>
      </div>
      <div>
        <div class="flex items-center justify-between text-sm mb-2"><span class="text-slate-600">Records still incomplete</span><span class="font-semibold text-slate-800"><%= draftPct %>%</span></div>
        <div class="ops-progress"><span class="bg-amber-500" style="width:<%= Math.min(draftPct, 100) %>%"></span></div>
      </div>
    </div>

    <div class="mt-5 bg-slate-50 rounded-xl p-4 border border-slate-100">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Main operational signal</div>
      <div class="font-semibold text-slate-800 mt-1"><%= riskCounts.red > 0 ? riskCounts.red + ' respondent(s) are currently Red risk' : missed > 0 ? missed + ' diary record(s) remain incomplete' : 'No major fieldwork exception is visible' %></div>
    </div>
  </section>

  <section class="ops-card p-5 xl:col-span-4">
    <div class="flex items-center justify-between gap-3 mb-3">
      <div>
        <div class="ops-section-title">Needs Attention</div>
        <div class="ops-muted mt-1">Turn exceptions into actions</div>
      </div>
    </div>

    <div>
      <div class="attention-row py-4 flex items-start gap-3">
        <div class="ops-icon bg-rose-50 text-rose-600 shrink-0"><%- icon('warning', 'w-5 h-5') %></div>
        <div class="min-w-0 flex-1">
          <div class="font-semibold text-slate-800"><%= criticalShown %> high-priority QC flag<%= criticalShown === 1 ? '' : 's' %> shown</div>
          <div class="ops-muted mt-1">Review recent critical and high severity cases.</div>
        </div>
        <a href="/admin/qc?study=<%= study.id %>" class="text-brand-600 text-xs font-semibold whitespace-nowrap mt-1">Review →</a>
      </div>
      <div class="attention-row py-4 flex items-start gap-3">
        <div class="ops-icon bg-amber-50 text-amber-600 shrink-0"><%- icon('clipboard', 'w-5 h-5') %></div>
        <div class="min-w-0 flex-1">
          <div class="font-semibold text-slate-800"><%= missed %> incomplete diary record<%= missed === 1 ? '' : 's' %></div>
          <div class="ops-muted mt-1">Follow up before the recall window closes.</div>
        </div>
      </div>
      <div class="attention-row py-4 flex items-start gap-3">
        <div class="ops-icon bg-slate-100 text-slate-600 shrink-0"><%- icon('stop', 'w-5 h-5') %></div>
        <div class="min-w-0 flex-1">
          <div class="font-semibold text-slate-800"><%= screenedOut %> screened-out record<%= screenedOut === 1 ? '' : 's' %></div>
          <div class="ops-muted mt-1">Keep an eye on recruitment losses and eligibility.</div>
        </div>
      </div>
    </div>
  </section>

  <section class="ops-card p-5 xl:col-span-3">
    <div class="ops-section-title">Respondent Risk</div>
    <div class="ops-muted mt-1">Green / Amber / Red classification</div>
    <div class="flex items-center justify-center py-5">
      <div class="risk-ring" style="--green:<%= greenPct %>; --amber:<%= amberPct %>">
        <div class="risk-ring-center">
          <div class="text-2xl font-bold text-slate-900"><%= riskTotal %></div>
          <div class="text-[11px] text-slate-500">Total</div>
        </div>
      </div>
    </div>
    <div class="space-y-2.5 text-sm">
      <div class="flex items-center justify-between"><span class="flex items-center gap-2 text-slate-600"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Green</span><span class="font-semibold"><%= riskCounts.green %> <span class="text-slate-400 font-normal">(<%= greenPct %>%)</span></span></div>
      <div class="flex items-center justify-between"><span class="flex items-center gap-2 text-slate-600"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Amber</span><span class="font-semibold"><%= riskCounts.amber %> <span class="text-slate-400 font-normal">(<%= amberPct %>%)</span></span></div>
      <div class="flex items-center justify-between"><span class="flex items-center gap-2 text-slate-600"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Red</span><span class="font-semibold"><%= riskCounts.red %> <span class="text-slate-400 font-normal">(<%= redPct %>%)</span></span></div>
    </div>
  </section>
</div>

<section class="ops-card p-5 mb-5">
  <div class="flex items-center justify-between gap-3 mb-5">
    <div>
      <div class="ops-section-title">Recruitment Funnel</div>
      <div class="ops-muted mt-1">Movement from invitation into active participation</div>
    </div>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
    <% funnelStages.forEach(([key, label], idx) => { const value = funnelMap[key] || 0; const pct = Math.round((value/funnelMax)*100); %>
      <div class="funnel-step p-4">
        <div class="text-xs font-semibold text-slate-500"><%= label %></div>
        <div class="text-2xl font-bold text-slate-900 mt-2"><%= value %></div>
        <div class="ops-progress mt-3"><span class="bg-brand-500" style="width:<%= pct %>%"></span></div>
        <div class="text-[11px] text-slate-400 mt-2"><%= pct %>% of top stage</div>
      </div>
    <% }) %>
  </div>
</section>

<div class="grid grid-cols-1 xl:grid-cols-12 gap-5 mb-5">
  <section class="ops-card p-5 xl:col-span-5">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div>
        <div class="ops-section-title">Interviewer Performance</div>
        <div class="ops-muted mt-1">F2F recruitment and activation</div>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="ops-table w-full text-sm">
        <thead><tr class="text-left"><th class="pb-2">Interviewer</th><th class="pb-2 text-right">Recruited</th><th class="pb-2 text-right">Activated</th><th class="pb-2 text-right">Rate</th></tr></thead>
        <tbody>
          <% interviewers.slice(0,6).forEach(i => { const rate = i.recruited > 0 ? Math.round((i.activated/i.recruited)*100) : 0; %>
            <tr>
              <td class="py-3 pr-3 font-medium text-slate-700"><%= i.name %></td>
              <td class="py-3 text-right text-slate-600"><%= i.recruited %></td>
              <td class="py-3 text-right text-slate-600"><%= i.activated %></td>
              <td class="py-3 text-right font-semibold <%= rate >= 80 ? 'text-emerald-600' : rate >= 60 ? 'text-amber-600' : 'text-rose-600' %>"><%= rate %>%</td>
            </tr>
          <% }) %>
          <% if (!interviewers.length) { %><tr><td colspan="4" class="py-5 text-slate-400">No interviewer users yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="ops-card p-5 xl:col-span-7">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div>
        <div class="ops-section-title">Latest QC Flags</div>
        <div class="ops-muted mt-1">Newest unresolved data-quality exceptions</div>
      </div>
      <a href="/admin/qc?study=<%= study.id %>" class="text-brand-600 text-sm font-semibold whitespace-nowrap">View all →</a>
    </div>
    <div class="overflow-x-auto">
      <table class="ops-table w-full text-sm min-w-[680px]">
        <thead><tr class="text-left"><th class="pb-2">Severity</th><th class="pb-2">Respondent</th><th class="pb-2">Issue</th><th class="pb-2">Reason</th><th class="pb-2 text-right">Action</th></tr></thead>
        <tbody>
          <% openFlags.slice(0,5).forEach(f => { %>
            <tr>
              <td class="py-3 pr-3"><span class="text-xs px-2 py-1 rounded-full font-semibold <%= f.severity==='critical'||f.severity==='high' ? 'badge-red' : f.severity==='medium' ? 'badge-amber' : 'badge-green' %>"><%= f.severity %></span></td>
              <td class="py-3 pr-3 font-semibold text-slate-700"><%= f.respondent_code %></td>
              <td class="py-3 pr-3 text-slate-600 capitalize"><%= f.flag_type.replace(/_/g,' ') %></td>
              <td class="py-3 pr-3 text-slate-500 max-w-xs truncate" title="<%= f.reason %>"><%= f.reason %></td>
              <td class="py-3 text-right"><a href="/admin/qc?study=<%= study.id %>" class="inline-flex items-center border border-brand-200 text-brand-700 rounded-lg px-2.5 py-1.5 text-xs font-semibold hover:bg-brand-50">Review</a></td>
            </tr>
          <% }) %>
          <% if (!openFlags.length) { %><tr><td colspan="5" class="py-5 text-slate-400">No open QC flags.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<section class="ops-card p-5">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
    <div>
      <div class="ops-section-title">Fieldwork Snapshot</div>
      <div class="ops-muted mt-1">Useful totals for the current study</div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-5 sm:gap-8 flex-1 lg:max-w-3xl">
      <div><div class="text-2xl font-bold text-slate-900"><%= expected %></div><div class="ops-muted mt-1">Diary records</div></div>
      <div><div class="text-2xl font-bold text-emerald-600"><%= completed %></div><div class="ops-muted mt-1">Submitted</div></div>
      <div><div class="text-2xl font-bold text-amber-600"><%= missed %></div><div class="ops-muted mt-1">Incomplete</div></div>
      <div><div class="text-2xl font-bold text-rose-600"><%= screenedOut %></div><div class="ops-muted mt-1">Screened out</div></div>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/admin/export/respondents.csv?study=<%= study.id %>" class="inline-flex items-center gap-1.5 border border-slate-300 bg-white rounded-xl px-3 py-2 text-xs font-semibold hover:bg-slate-50"><%- icon('upload', 'w-3.5 h-3.5') %> Respondents CSV</a>
      <a href="/admin/export/diary.csv?study=<%= study.id %>" class="inline-flex items-center gap-1.5 border border-slate-300 bg-white rounded-xl px-3 py-2 text-xs font-semibold hover:bg-slate-50"><%- icon('upload', 'w-3.5 h-3.5') %> Diary CSV</a>
      <a href="/admin/export/qc.csv?study=<%= study.id %>" class="inline-flex items-center gap-1.5 border border-slate-300 bg-white rounded-xl px-3 py-2 text-xs font-semibold hover:bg-slate-50"><%- icon('upload', 'w-3.5 h-3.5') %> QC CSV</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
