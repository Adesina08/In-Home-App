<%- include('../partials/header', { title: 'Fieldwork & Analysis — INICIO Console', user, currentPath: '/admin', studyPicker: { studies, current: study.id, action: '/admin?study=' } }) %>
<%- include('../partials/page_header', { eyebrow: 'Study overview', title: 'Fieldwork & Analysis', subtitle: study.name, actions: '<a href="/admin?study=' + study.id + '" class="console-button">' + icon('refresh','w-4 h-4') + 'Refresh</a><a href="/admin/studies/' + study.id + '" class="console-button is-primary">' + icon('settings','w-4 h-4') + 'Study settings</a>' }) %>
<% const submissionShare = expected ? Math.round(completed / expected * 100) : null; const stages = [['invited','Invited'],['screened','Screened'],['registered','Registered'],['activated','Activated'],['active','Active']]; const funnelMax = Math.max(1,...stages.map(([key])=>funnelMap[key] || 0)); %>
<div class="console-metrics">
  <% [['Respondents',totalRespondents,'users','Current study · excludes practice'],['Submitted entries',completed,'check-circle','All time · excludes practice'],['Draft entries',missed,'pencil','Started but not submitted'],['Open QC flags',totalOpenFlags,'shield-check','All open flags in this study']].forEach(([label,value,glyph,note])=>{ %><div class="console-metric"><div class="console-metric-label"><%= label %><span class="console-metric-icon"><%- icon(glyph,'w-4 h-4') %></span></div><div class="console-metric-value"><%= Number(value).toLocaleString() %></div><div class="console-metric-foot"><%= note %></div></div><% }) %>
</div>
<div class="console-columns">
  <div class="console-stack">
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Participation at a glance</h2><p>All-time diary records · practice entries excluded</p></div><span class="console-status <%= study.status === 'live' ? 'is-live' : '' %>"><%= study.status %></span></div>
      <div class="console-panel-body"><div class="console-progress-caption"><span>Participation compliance</span><strong><%= participationSummary.rate === null ? 'Schedule not configured' : participationSummary.rate + '%' %></strong></div><div class="console-progress-track"><span style="width:<%= participationSummary.rate || 0 %>%"></span></div><div class="console-actions" style="margin-top:22px;font-size:12px;color:#5f7189"><span><strong style="color:#35549c"><%= completed %></strong> submitted</span><span>·</span><span><%= missed %> drafts</span><span>·</span><span><%= screenedOut %> screened out</span><span>·</span><span><%= participationSummary.completed??'—' %> / <%= participationSummary.expected??'—' %> participation periods</span></div></div>
    </section>
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Latest quality flags</h2><p>Up to 8 recent open flags in this study</p></div><a href="/admin/qc?study=<%= study.id %>">Open worklist ↗</a></div><div class="overflow-x-auto" role="region" aria-label="Latest quality flags" tabindex="0"><table><thead><tr><th>Respondent</th><th>Issue</th><th>Severity</th><th>Action</th></tr></thead><tbody>
      <% openFlags.forEach(f=>{ %><tr><td><strong><%= f.respondent_code %></strong><div style="font-size:11px;color:#5f7189;margin-top:4px"><%= f.respondent_name %></div></td><td><%= String(f.flag_type || '').replace(/_/g,' ') %></td><td><span class="console-status <%= ['critical','high'].includes(f.severity) ? 'is-danger' : 'is-alert' %>"><%= f.severity %></span></td><td><a class="console-button" href="/admin/qc?study=<%= study.id %>&flag=<%= f.id %>">Review →</a></td></tr><% }) %>
    </tbody></table></div><% if(!openFlags.length){ %><div class="console-empty"><%- icon('shield-check','w-7 h-7') %><strong>No open QC flags</strong><p>New quality flags will appear here for review.</p></div><% } %></section>
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Interviewer performance</h2><p>Recruitment and activation in this study</p></div></div><div class="overflow-x-auto" role="region" aria-label="Interviewer performance" tabindex="0"><table><thead><tr><th>Interviewer</th><th>Recruited</th><th>Activated</th><th>Activation rate</th></tr></thead><tbody><% interviewers.forEach(i=>{ %><tr><td><%= i.name %></td><td><%= i.recruited %></td><td><%= i.activated %></td><td><%= i.recruited ? Math.round(i.activated/i.recruited*100)+'%' : '—' %></td></tr><% }) %></tbody></table></div><% if(!interviewers.length){ %><div class="console-empty">No interviewers to show.</div><% } %></section>
  </div>
  <div class="console-stack">
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Recruitment status</h2><p>Respondents currently at each stage</p></div></div><% stages.forEach(([key,label])=>{const value=funnelMap[key] || 0; %><div class="console-progress-row"><div class="console-progress-caption"><span><%= label %></span><strong><%= value %></strong></div><div class="console-progress-track"><span style="width:<%= Math.round(value/funnelMax*100) %>%"></span></div></div><% }) %></section>
    <section class="console-panel"><div class="console-panel-heading"><h2>Respondent risk</h2><a href="/admin/studies/<%= study.id %>/respondents">View ↗</a></div><% [['green','Green'],['amber','Amber'],['red','Red']].forEach(([key,label])=>{ %><div class="console-progress-row"><div class="console-progress-caption" style="margin:0"><span><%= label %></span><span class="console-status <%= key==='green'?'is-live':key==='red'?'is-danger':'is-alert' %>"><%= riskCounts[key] %></span></div></div><% }) %></section>
    <section class="console-panel"><div class="console-panel-heading"><div><h2>Recent activity</h2><p>Current study · timestamps in UTC</p></div></div><% recentActivity.forEach(item=>{ %><div class="console-activity-row"><span class="console-activity-dot"></span><div><strong><%= item.text %></strong><small><%= item.at %></small></div></div><% }) %><% if(!recentActivity.length){ %><div class="console-empty">No activity recorded yet.</div><% } %></section>
  </div>
</div>
<section class="console-panel"><div class="console-panel-heading"><div><h2>Study exports</h2><p>Download the data behind this study.</p></div><div class="console-actions"><% [['respondents','Respondents'],['diary','Diary entries'],['qc','QC flags']].forEach(([key,label])=>{ %><a class="console-button" href="/admin/export/<%= key %>.csv?study=<%= study.id %>"><%- icon('download','w-4 h-4') %><%= label %></a><% }) %></div></div></section>
<%- include('../partials/admin_fieldwork_operations', { operations, operationSaved, operationError, study }) %>
<%- include('../partials/admin_analysis_section', { analysis, study, studies }) %>
<%- include('../partials/footer') %>
