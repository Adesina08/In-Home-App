<%
  const compliancePct = expected > 0 ? Math.round((completed / expected) * 100) : 0;
  const incompletePct = expected > 0 ? Math.round((missed / expected) * 100) : 0;
  const riskTotal = riskCounts.green + riskCounts.amber + riskCounts.red;
  const greenPct = riskTotal ? Math.round((riskCounts.green / riskTotal) * 100) : 0;
  const amberPct = riskTotal ? Math.round((riskCounts.amber / riskTotal) * 100) : 0;
  const redPct = riskTotal ? Math.round((riskCounts.red / riskTotal) * 100) : 0;
  const criticalShown = openFlags.filter(f => f.severity === 'critical' || f.severity === 'high').length;
  const stages = [['invited','Invited'],['screened','Screened'],['registered','Registered'],['activated','Activated'],['active','Active']];
  const funnelMax = Math.max(...stages.map(([k]) => funnelMap[k] || 0), 1);
  const recruitmentActivePct = Math.round(((funnelMap.active || 0) / funnelMax) * 100);
  const overallStatus = riskCounts.red > 0 ? 'RED' : riskCounts.amber > 0 ? 'AMBER' : 'GREEN';
  const statusTone = { RED: ['#FCE8E6', '#C0392B', '#F5C6C0'], AMBER: ['#FFF8ED', '#B8860B', '#FDE8C2'], GREEN: ['#E6F4EA', '#1E7E34', '#BEE8CE'] }[overallStatus];
  const mainRisk = missed > 0 ? 'Diary completion' : criticalShown > 0 ? 'QC review' : 'No major issue';
  const donutStops = `#1E7E34 0 ${greenPct}%, #B8860B ${greenPct}% ${greenPct + amberPct}%, #C0392B ${greenPct + amberPct}% 100%`;
  const severityPill = (s) => (s === 'critical' || s === 'high') ? ['#FCE8E6', '#C0392B'] : s === 'medium' ? ['#FFF4E5', '#B8860B'] : ['#E6F4EA', '#1E7E34'];
  const ratePill = (r) => r >= 80 ? ['#E6F4EA', '#1E7E34'] : r >= 60 ? ['#FFF4E5', '#B8860B'] : ['#FCE8E6', '#C0392B'];
%>
<%- include('../partials/header', {
  title: 'Admin Dashboard — INICIO',
  user,
  currentPath: '/admin',
  studyPicker: { studies, current: study.id, action: '/admin?study=' },
}) %>

<div class="flex items-start justify-between gap-4 shrink-0">
  <div>
    <div class="text-[11px] font-bold text-[#3B82F6] uppercase tracking-wide mb-0.5">Admin</div>
    <h1 class="font-display text-[22px] font-extrabold text-slate-900 m-0">Admin Dashboard</h1>
    <p class="text-slate-500 text-[12.5px] mt-[3px]">Real-time overview of fieldwork performance and study health</p>
  </div>
  <div class="flex gap-[9px] shrink-0">
    <a href="/admin/qc?study=<%= study.id %>" class="bg-white border border-slate-200 rounded-[10px] px-[15px] py-2 text-[12.5px] font-semibold text-slate-600 flex items-center gap-1.5 hover:bg-slate-50">
      <%- icon('refresh', 'w-[13px] h-[13px]') %>Refresh
    </a>
    <a href="/admin/studies/<%= study.id %>" class="bg-signal text-white rounded-[10px] px-4 py-2 text-[12.5px] font-semibold flex items-center gap-1.5 hover:bg-signal-bright">
      <%- icon('settings', 'w-[13px] h-[13px]') %>Study Config
    </a>
  </div>
</div>

<div class="grid grid-cols-5 gap-3 shrink-0">
  <% const kpis = [
    ['users', 'rgba(29,78,216,.10)', '#1D4ED8', 'Respondents', totalRespondents, 'Current study sample'],
    ['check-circle', 'rgba(30,126,52,.12)', '#1E7E34', 'Diary Compliance', compliancePct + '%', completed + ' of ' + expected + ' submitted'],
    ['clipboard', 'rgba(184,134,11,.12)', '#B8860B', 'Completed Diaries', completed, 'Submitted records'],
    ['warning', 'rgba(192,57,43,.12)', '#C0392B', 'Incomplete Diaries', missed, incompletePct + '% of diary records'],
    ['stop', 'rgba(124,58,237,.12)', '#7C3AED', 'Screened Out', screenedOut, 'Recruitment exclusions'],
  ]; %>
  <% kpis.forEach(function ([ic, iconBg, iconColor, label, value, foot]) { %>
    <div class="bg-white rounded-2xl border border-[#EDF0F4] shadow-card px-[15px] py-[13px]">
      <div class="flex items-center gap-2">
        <div class="w-[26px] h-[26px] rounded-lg flex items-center justify-center shrink-0" style="background:<%= iconBg %>;color:<%= iconColor %>"><%- icon(ic, 'w-[14px] h-[14px]') %></div>
        <div class="text-[9.5px] font-bold text-slate-400 uppercase tracking-wide"><%= label %></div>
      </div>
      <div class="font-mono text-[25px] font-bold text-slate-900 mt-[7px]"><%= value %></div>
      <div class="text-[10.5px] text-slate-400 mt-0.5"><%= foot %></div>
    </div>
  <% }) %>
</div>

<div class="grid gap-3.5 shrink-0" style="grid-template-columns:1.15fr 1fr 1fr">
  <div class="bg-white rounded-2xl border border-[#EDF0F4] shadow-card p-4">
    <div class="text-[13px] font-bold text-slate-900 mb-2.5">Fieldwork Health</div>
    <div class="flex gap-3.5 items-stretch">
      <div class="flex-1 flex flex-col gap-2">
        <div>
          <div class="flex justify-between text-[10.5px] text-slate-500 mb-[3px]"><span>Diary completion</span><span class="font-mono"><%= compliancePct %>%</span></div>
          <div class="h-[7px] rounded bg-slate-100 overflow-hidden"><div class="h-full rounded bg-signal" style="width:<%= Math.min(compliancePct, 100) %>%"></div></div>
        </div>
        <div>
          <div class="flex justify-between text-[10.5px] text-slate-500 mb-[3px]"><span>Respondent risk — green</span><span class="font-mono"><%= greenPct %>%</span></div>
          <div class="h-[7px] rounded bg-slate-100 overflow-hidden"><div class="h-full rounded" style="width:<%= greenPct %>%;background:#1E7E34"></div></div>
        </div>
        <div>
          <div class="flex justify-between text-[10.5px] text-slate-500 mb-[3px]"><span>Recruitment active</span><span class="font-mono"><%= recruitmentActivePct %>%</span></div>
          <div class="h-[7px] rounded bg-slate-100 overflow-hidden"><div class="h-full rounded" style="width:<%= recruitmentActivePct %>%;background:#B8860B"></div></div>
        </div>
      </div>
      <div class="w-[110px] shrink-0 rounded-2xl flex flex-col items-center justify-center text-center gap-[3px] p-2.5" style="background:<%= statusTone[0] %>;border:1px solid <%= statusTone[2] %>">
        <div class="text-[9px] font-bold uppercase tracking-wide" style="color:<%= statusTone[1] %>">Overall Status</div>
        <div class="font-display text-[19px] font-extrabold" style="color:<%= statusTone[1] %>"><%= overallStatus %></div>
        <div class="text-[9.5px]" style="color:<%= statusTone[1] %>">Main risk: <%= mainRisk %></div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-[#EDF0F4] shadow-card p-4">
    <div class="text-[13px] font-bold text-slate-900 mb-2.5">Needs Attention</div>
    <div class="flex flex-col gap-[9px]">
      <div class="flex items-center gap-2">
        <div class="w-[22px] h-[22px] rounded-lg flex items-center justify-center shrink-0" style="background:rgba(192,57,43,.12);color:#C0392B"><%- icon('shield', 'w-3 h-3') %></div>
        <div class="flex-1 text-[11.5px] text-slate-700"><strong><%= criticalShown %></strong> high-priority QC flags to review</div>
        <a href="/admin/qc?study=<%= study.id %>" class="text-[11px] font-bold text-signal">Review now</a>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-[22px] h-[22px] rounded-lg flex items-center justify-center shrink-0" style="background:rgba(184,134,11,.12);color:#B8860B"><%- icon('warning', 'w-3 h-3') %></div>
        <div class="flex-1 text-[11.5px] text-slate-700"><strong><%= missed %></strong> incomplete diary records</div>
        <a href="/admin/qc?study=<%= study.id %>" class="text-[11px] font-bold text-signal">View</a>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-[22px] h-[22px] rounded-lg flex items-center justify-center shrink-0" style="background:rgba(124,58,237,.12);color:#7C3AED"><%- icon('stop', 'w-3 h-3') %></div>
        <div class="flex-1 text-[11.5px] text-slate-700"><strong><%= screenedOut %></strong> respondents screened out</div>
        <a href="/admin/studies/<%= study.id %>" class="text-[11px] font-bold text-signal">Study</a>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-[#EDF0F4] shadow-card p-4">
    <div class="text-[13px] font-bold text-slate-900 mb-2.5">Recruitment Funnel</div>
    <div class="flex flex-col gap-1.5">
      <% stages.forEach(function ([k, l]) { const v = funnelMap[k] || 0; const pct = Math.round((v / funnelMax) * 100); %>
        <div>
          <div class="flex justify-between text-[10px] text-slate-500"><span><%= l %></span><span class="font-mono"><%= v %> &middot; <%= pct %>%</span></div>
          <div class="h-[7px] rounded mt-0.5 bg-brand-50 overflow-hidden"><div class="h-full rounded bg-signal" style="width:<%= pct %>%"></div></div>
        </div>
      <% }) %>
    </div>
    <div class="text-right mt-2.5"><a href="/admin/studies/<%= study.id %>" class="text-[11px] font-bold text-signal">View study</a></div>
  </div>
</div>

<div class="grid gap-3.5 flex-1 min-h-0" style="grid-template-columns:0.85fr 1.1fr 1.2fr">
  <div class="bg-white rounded-2xl border border-[#EDF0F4] shadow-card p-4">
    <div class="text-[13px] font-bold text-slate-900 mb-2.5">Respondent Risk</div>
    <div class="flex items-center gap-3.5">
      <div class="relative w-24 h-24 rounded-full shrink-0 flex items-center justify-center" style="background:conic-gradient(<%= donutStops %>)">
        <div class="w-[62px] h-[62px] rounded-full bg-white flex flex-col items-center justify-center">
          <div class="font-mono text-[17px] font-bold text-slate-900"><%= riskTotal %></div>
          <div class="text-[7.5px] text-slate-400">respondents</div>
        </div>
      </div>
      <div class="flex flex-col gap-[5px]">
        <div class="flex items-center gap-1.5 text-[11px] text-slate-700"><span class="w-2 h-2 rounded-sm inline-block" style="background:#1E7E34"></span>Green &middot; <%= riskCounts.green %> (<%= greenPct %>%)</div>
        <div class="flex items-center gap-1.5 text-[11px] text-slate-700"><span class="w-2 h-2 rounded-sm inline-block" style="background:#B8860B"></span>Amber &middot; <%= riskCounts.amber %> (<%= amberPct %>%)</div>
        <div class="flex items-center gap-1.5 text-[11px] text-slate-700"><span class="w-2 h-2 rounded-sm inline-block" style="background:#C0392B"></span>Red &middot; <%= riskCounts.red %> (<%= redPct %>%)</div>
      </div>
    </div>
    <a href="/admin/qc?study=<%= study.id %>" class="text-[11.5px] font-bold text-signal inline-block mt-2.5">Open QC Worklist &rarr;</a>
  </div>

  <div class="bg-white rounded-2xl border border-[#EDF0F4] shadow-card p-4 overflow-hidden flex flex-col">
    <div class="text-[13px] font-bold text-slate-900 mb-2.5">Interviewer Performance</div>
    <div class="overflow-auto">
      <table class="w-full border-collapse">
        <thead><tr>
          <th class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold border-b border-slate-200 pb-1.5 pr-4">Interviewer</th>
          <th class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold border-b border-slate-200 pb-1.5 pr-4">Recruited</th>
          <th class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold border-b border-slate-200 pb-1.5 pr-4">Activated</th>
          <th class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold border-b border-slate-200 pb-1.5 pr-4">Rate</th>
        </tr></thead>
        <tbody>
          <% interviewers.slice(0, 6).forEach(function (i) { const rate = i.recruited ? Math.round((i.activated / i.recruited) * 100) : 0; const p = ratePill(rate); %>
            <tr>
              <td class="border-t border-slate-100 py-[7px] pr-4 text-[11.5px] font-semibold text-slate-900"><%= i.name %></td>
              <td class="border-t border-slate-100 py-[7px] pr-4 text-[11.5px] font-mono"><%= i.recruited %></td>
              <td class="border-t border-slate-100 py-[7px] pr-4 text-[11.5px] font-mono"><%= i.activated %></td>
              <td class="border-t border-slate-100 py-[7px] pr-4 text-[11.5px]"><span class="px-[9px] py-[3px] rounded-full text-[10px] font-bold uppercase" style="background:<%= p[0] %>;color:<%= p[1] %>"><%= rate %>%</span></td>
            </tr>
          <% }) %>
          <% if (!interviewers.length) { %><tr><td colspan="4" class="text-slate-400 py-2 text-[11.5px]">No interviewer users yet</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-[#EDF0F4] shadow-card p-4 overflow-hidden flex flex-col">
    <div class="flex justify-between items-center mb-2.5">
      <div class="text-[13px] font-bold text-slate-900">Latest QC Flags</div>
      <a href="/admin/qc?study=<%= study.id %>" class="text-[11px] font-bold text-signal">View all</a>
    </div>
    <div class="overflow-auto">
      <table class="w-full border-collapse">
        <thead><tr>
          <th class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold border-b border-slate-200 pb-1.5 pr-4">Severity</th>
          <th class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold border-b border-slate-200 pb-1.5 pr-4">Respondent</th>
          <th class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold border-b border-slate-200 pb-1.5 pr-4">Issue</th>
          <th class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold border-b border-slate-200 pb-1.5 pr-4">Raised</th>
          <th class="text-left text-slate-400 text-[9.5px] uppercase tracking-wide font-bold border-b border-slate-200 pb-1.5 pr-4"></th>
        </tr></thead>
        <tbody>
          <% openFlags.slice(0, 5).forEach(function (f) { const p = severityPill(f.severity); %>
            <tr>
              <td class="border-t border-slate-100 py-[7px] pr-4 text-[11.5px]"><span class="px-[9px] py-[3px] rounded-full text-[10px] font-bold uppercase" style="background:<%= p[0] %>;color:<%= p[1] %>"><%= f.severity %></span></td>
              <td class="border-t border-slate-100 py-[7px] pr-4 text-[11.5px] font-mono"><%= f.respondent_code %></td>
              <td class="border-t border-slate-100 py-[7px] pr-4 text-[11.5px]"><%= f.flag_type.replace(/_/g, ' ') %></td>
              <td class="border-t border-slate-100 py-[7px] pr-4 text-[11.5px] text-slate-400"><%= f.created_time || '—' %></td>
              <td class="border-t border-slate-100 py-[7px] pr-4 text-[11.5px]"><a href="/admin/qc?study=<%= study.id %>" class="text-signal font-semibold">Review</a></td>
            </tr>
          <% }) %>
          <% if (!openFlags.length) { %><tr><td colspan="5" class="text-slate-400 py-2 text-[11.5px]">No open QC flags.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="bg-white rounded-2xl border border-[#EDF0F4] shadow-card px-4 py-3 flex items-center justify-between gap-4 shrink-0 flex-wrap">
  <div class="flex items-center gap-[22px] flex-wrap">
    <div class="text-[11.5px] font-bold text-slate-900">Fieldwork Snapshot</div>
    <% const snap = [
      ['clipboard', 'rgba(29,78,216,.10)', '#1D4ED8', expected, 'Diary records'],
      ['check-circle', 'rgba(30,126,52,.12)', '#1E7E34', completed, 'Submitted'],
      ['warning', 'rgba(184,134,11,.12)', '#B8860B', missed, 'Incomplete'],
      ['shield', 'rgba(192,57,43,.12)', '#C0392B', openFlags.length, 'QC flags shown'],
      ['users', 'rgba(124,58,237,.12)', '#7C3AED', totalRespondents, 'Respondents'],
    ]; %>
    <% snap.forEach(function ([ic, bg, color, val, label]) { %>
      <div class="flex items-center gap-1.5">
        <div class="w-5 h-5 rounded-lg flex items-center justify-center shrink-0" style="background:<%= bg %>;color:<%= color %>"><%- icon(ic, 'w-[11px] h-[11px]') %></div>
        <div><span class="font-mono text-[13px] font-bold"><%= val %></span> <span class="text-[10px] text-slate-400"><%= label %></span></div>
      </div>
    <% }) %>
  </div>
  <div class="flex gap-2">
    <a href="/admin/export/respondents.csv?study=<%= study.id %>" class="bg-white border border-slate-200 rounded-[9px] px-[11px] py-1.5 text-[11.5px] font-semibold text-slate-600 flex items-center gap-1.5 hover:bg-slate-50"><%- icon('download', 'w-3 h-3') %>Respondents CSV</a>
    <a href="/admin/export/diary.csv?study=<%= study.id %>" class="bg-white border border-slate-200 rounded-[9px] px-[11px] py-1.5 text-[11.5px] font-semibold text-slate-600 flex items-center gap-1.5 hover:bg-slate-50"><%- icon('download', 'w-3 h-3') %>Diary CSV</a>
    <a href="/admin/export/qc.csv?study=<%= study.id %>" class="bg-white border border-slate-200 rounded-[9px] px-[11px] py-1.5 text-[11.5px] font-semibold text-slate-600 flex items-center gap-1.5 hover:bg-slate-50"><%- icon('download', 'w-3 h-3') %>QC CSV</a>
  </div>
</div>

<%- include('../partials/footer') %>
