<%- include('../partials/header', { title: 'Admin Dashboard — INICIO', user }) %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <div class="text-xs font-semibold text-brand-500 uppercase tracking-wide mb-0.5">Overview</div>
    <h1 class="text-2xl font-bold text-slate-900">Operations Dashboard</h1>
    <div class="text-slate-500 text-sm mt-1.5 flex items-center gap-2">
      <span>Study:</span>
      <select onchange="window.location='/admin?study='+this.value" class="border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-400">
        <% studies.forEach(s => { %>
          <option value="<%= s.id %>" <%= s.id === study.id ? 'selected' : '' %>><%= s.name %> (<%= s.status %>)</option>
        <% }) %>
      </select>
    </div>
  </div>
  <div class="flex gap-2">
    <form method="POST" action="/admin/reminders/run">
      <button class="inline-flex items-center gap-1.5 bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-medium hover:bg-slate-50 hover:border-slate-400 transition shadow-card">
        <%- icon('refresh', 'w-4 h-4') %> Run Reminder Engine
      </button>
    </form>
    <a href="/admin/studies/<%= study.id %>" class="inline-flex items-center gap-1.5 bg-brand-700 text-white rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-brand-600 transition shadow-card">
      <%- icon('cog', 'w-4 h-4') %> Study Config
    </a>
  </div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
  <div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card hover:shadow-card-hover transition">
    <div class="flex items-center gap-2 text-slate-500 text-xs uppercase tracking-wide font-semibold">
      <span class="w-7 h-7 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center"><%- icon('users', 'w-4 h-4') %></span>
      Respondents
    </div>
    <div class="text-3xl font-bold text-slate-900 mt-3"><%= totalRespondents %></div>
  </div>
  <div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card hover:shadow-card-hover transition">
    <div class="flex items-center gap-2 text-slate-500 text-xs uppercase tracking-wide font-semibold">
      <span class="w-7 h-7 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center"><%- icon('clipboard', 'w-4 h-4') %></span>
      Diary Records
    </div>
    <div class="text-3xl font-bold text-slate-900 mt-3"><%= expected %></div>
  </div>
  <div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card hover:shadow-card-hover transition">
    <div class="flex items-center gap-2 text-slate-500 text-xs uppercase tracking-wide font-semibold">
      <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center"><%- icon('check-circle', 'w-4 h-4') %></span>
      Completed
    </div>
    <div class="text-3xl font-bold text-emerald-600 mt-3"><%= completed %></div>
  </div>
  <div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card hover:shadow-card-hover transition">
    <div class="flex items-center gap-2 text-slate-500 text-xs uppercase tracking-wide font-semibold">
      <span class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center"><%- icon('warning', 'w-4 h-4') %></span>
      Draft / Incomplete
    </div>
    <div class="text-3xl font-bold text-amber-600 mt-3"><%= missed %></div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-8">
  <div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card">
    <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2"><%- icon('trend', 'w-4 h-4 text-brand-500') %> Recruitment Funnel</div>
    <% const stages = ['invited','screened','registered','activated','active','completed']; %>
    <% stages.forEach(s => { %>
      <div class="flex items-center justify-between text-sm py-1.5 border-b border-slate-100 last:border-0">
        <span class="capitalize text-slate-600"><%= s %></span>
        <span class="font-semibold text-slate-800"><%= funnelMap[s] || 0 %></span>
      </div>
    <% }) %>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card">
    <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2"><%- icon('shield', 'w-4 h-4 text-brand-500') %> Respondent Risk Classification</div>
    <div class="flex items-end gap-4 h-32">
      <% const maxR = Math.max(riskCounts.green, riskCounts.amber, riskCounts.red, 1); %>
      <div class="flex-1 flex flex-col items-center justify-end h-full">
        <div class="text-sm font-semibold mb-1 text-slate-700"><%= riskCounts.green %></div>
        <div class="w-10 bg-emerald-400 rounded-t-lg" style="height: <%= (riskCounts.green/maxR)*100 %>%"></div>
        <div class="text-xs mt-1.5 text-slate-500">Green</div>
      </div>
      <div class="flex-1 flex flex-col items-center justify-end h-full">
        <div class="text-sm font-semibold mb-1 text-slate-700"><%= riskCounts.amber %></div>
        <div class="w-10 bg-amber-400 rounded-t-lg" style="height: <%= (riskCounts.amber/maxR)*100 %>%"></div>
        <div class="text-xs mt-1.5 text-slate-500">Amber</div>
      </div>
      <div class="flex-1 flex flex-col items-center justify-end h-full">
        <div class="text-sm font-semibold mb-1 text-slate-700"><%= riskCounts.red %></div>
        <div class="w-10 bg-red-400 rounded-t-lg" style="height: <%= (riskCounts.red/maxR)*100 %>%"></div>
        <div class="text-xs mt-1.5 text-slate-500">Red</div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card">
    <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2"><%- icon('users', 'w-4 h-4 text-brand-500') %> Interviewer Monitoring (F2F)</div>
    <table class="w-full text-sm">
      <thead><tr class="text-left text-slate-400 text-xs uppercase tracking-wide"><th class="pb-2">Interviewer</th><th class="pb-2">Recruited</th><th class="pb-2">Activated</th></tr></thead>
      <tbody>
      <% interviewers.forEach(i => { %>
        <tr class="border-t border-slate-100">
          <td class="py-2"><%= i.name %></td>
          <td class="py-2"><%= i.recruited %></td>
          <td class="py-2"><%= i.activated %></td>
        </tr>
      <% }) %>
      <% if (!interviewers.length) { %><tr><td colspan="3" class="py-3 text-slate-400">No interviewer users yet</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200/70 p-5 shadow-card mb-6">
  <div class="flex items-center justify-between mb-3">
    <div class="font-semibold text-slate-800 flex items-center gap-2"><%- icon('warning', 'w-4 h-4 text-amber-500') %> Recent QC Flags</div>
    <a href="/admin/qc?study=<%= study.id %>" class="text-brand-600 text-sm font-medium hover:underline flex items-center gap-1">Open full QC worklist <%- icon('arrow-right', 'w-3.5 h-3.5') %></a>
  </div>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="text-left text-slate-400 text-xs uppercase tracking-wide">
      <th class="pb-2">Respondent</th><th class="pb-2">Flag</th><th class="pb-2">Severity</th><th class="pb-2">Reason</th><th class="pb-2">Raised</th>
    </tr></thead>
    <tbody>
    <% openFlags.forEach(f => { %>
      <tr class="border-t border-slate-100 hover:bg-slate-50/70">
        <td class="py-2.5 font-medium text-slate-700"><%= f.respondent_code %></td>
        <td class="py-2.5 text-slate-600"><%= f.flag_type.replace(/_/g,' ') %></td>
        <td class="py-2.5">
          <span class="text-xs px-2 py-0.5 rounded-full font-medium <%= f.severity==='critical'||f.severity==='high' ? 'badge-red' : f.severity==='medium' ? 'badge-amber' : 'badge-green' %>"><%= f.severity %></span>
        </td>
        <td class="py-2.5 text-slate-500"><%= f.reason %></td>
        <td class="py-2.5 text-slate-400 text-xs"><%= f.created_time %></td>
      </tr>
    <% }) %>
    <% if (!openFlags.length) { %><tr><td colspan="5" class="py-3 text-slate-400">No open QC flags 🎉</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>

<div class="flex flex-wrap gap-3 text-sm">
  <a href="/admin/export/respondents.csv?study=<%= study.id %>" class="inline-flex items-center gap-1.5 border border-slate-300 bg-white rounded-xl px-3.5 py-2 hover:bg-slate-50 hover:border-slate-400 transition"><%- icon('upload', 'w-4 h-4 text-slate-400') %> Export Respondents CSV</a>
  <a href="/admin/export/diary.csv?study=<%= study.id %>" class="inline-flex items-center gap-1.5 border border-slate-300 bg-white rounded-xl px-3.5 py-2 hover:bg-slate-50 hover:border-slate-400 transition"><%- icon('upload', 'w-4 h-4 text-slate-400') %> Export Diary CSV</a>
  <a href="/admin/export/qc.csv?study=<%= study.id %>" class="inline-flex items-center gap-1.5 border border-slate-300 bg-white rounded-xl px-3.5 py-2 hover:bg-slate-50 hover:border-slate-400 transition"><%- icon('upload', 'w-4 h-4 text-slate-400') %> Export QC CSV</a>
</div>

<%- include('../partials/footer') %>
