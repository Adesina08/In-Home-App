<%- include('../partials/header', { title: study.name + ' — Skip Logic', user }) %>
<%- include('../partials/study_tabs', { study, tab }) %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
  <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/70 shadow-card overflow-hidden">
    <div class="px-5 py-3.5 border-b border-slate-100 font-semibold text-slate-800 flex items-center gap-2"><%- icon('arrow-right', 'w-4 h-4 text-brand-500') %> Skip Logic Rules</div>
    <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead><tr class="text-left text-slate-400 text-xs uppercase tracking-wide">
        <th class="px-5 py-2.5">Rule</th><th class="py-2.5"></th>
      </tr></thead>
      <tbody>
      <% rules.forEach(r => { %>
        <tr class="border-t border-slate-100 hover:bg-slate-50/70">
          <td class="px-5 py-3.5 text-slate-700">
            <span class="font-medium <%= r.action === 'show' ? 'text-emerald-600' : 'text-red-500' %>"><%= r.action === 'show' ? 'Show' : 'Hide' %></span>
            <% if (r.target_section) { %>
              the whole <strong>"<%= r.target_section %>"</strong> section
            <% } else { %>
              "<strong><%= r.target_text %></strong>"
            <% } %>
            <%
              const opText = { equals: '=', not_equals: '≠', in: 'is one of', not_in: 'is none of', includes: 'includes' }[r.operator] || r.operator;
              const valueDisplay = ['in', 'not_in', 'includes'].includes(r.operator) ? r.value.split('|').join(', ') : r.value;
            %>
            if "<%= r.condition_text %>" <%= opText %> <span class="font-mono bg-slate-100 px-1.5 py-0.5 rounded text-xs"><%= valueDisplay %></span>
          </td>
          <td class="py-3 pr-5 text-right">
            <form method="POST" action="/admin/studies/<%= study.id %>/skip-logic/<%= r.id %>/delete">
              <button class="text-red-500 text-xs font-medium hover:underline flex items-center gap-1 ml-auto"><%- icon('x', 'w-3.5 h-3.5') %> Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!rules.length) { %><tr><td colspan="2" class="px-5 py-8 text-slate-400 text-center">No skip logic yet — build the questionnaire first, then add rules here.</td></tr><% } %>
      </tbody>
    </table>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200/70 shadow-card p-5 h-fit">
    <div class="font-semibold text-slate-800 mb-3 flex items-center gap-2"><%- icon('plus', 'w-4 h-4 text-brand-500') %> Add Skip Rule</div>
    <form method="POST" action="/admin/studies/<%= study.id %>/skip-logic" class="space-y-3.5 text-sm">
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Action</label>
        <select name="action" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition">
          <option value="show">Show target question</option>
          <option value="hide">Hide target question</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Target</label>
        <div class="flex gap-4 mb-2 text-xs text-slate-600">
          <label class="flex items-center gap-1.5"><input type="radio" name="target_type" value="question" checked onchange="toggleTargetType()" /> One question</label>
          <label class="flex items-center gap-1.5"><input type="radio" name="target_type" value="section" onchange="toggleTargetType()" <%= sections.length ? '' : 'disabled' %> /> Whole section</label>
        </div>
        <select name="target_question_id" id="targetQuestionSelect" required class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition">
          <% questions.forEach(q => { %><option value="<%= q.id %>"><%= q.text %></option><% }) %>
        </select>
        <select name="target_section" id="targetSectionSelect" class="hidden w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition">
          <% sections.forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
        </select>
        <% if (!sections.length) { %><p class="text-xs text-slate-400 mt-1">No sections defined yet — add a "Section" to questions on the Questionnaire tab to skip a whole section at once.</p><% } %>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">When condition question</label>
        <select name="condition_question_id" required class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition">
          <% questions.forEach(q => { %><option value="<%= q.id %>"><%= q.text %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Operator</label>
        <select name="operator" class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition">
          <option value="equals">Equals</option>
          <option value="not_equals">Not equals</option>
          <option value="in">Is one of (multiple values)</option>
          <option value="not_in">Is none of (multiple values)</option>
          <option value="includes">Includes (for multi-select condition questions)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-600 mb-1.5">Value</label>
        <input name="value" required class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-brand-400 transition" placeholder="e.g. Yes / Brand A -- for 'is one of' or 'is none of', separate values with a comma" />
      </div>
      <button class="w-full inline-flex items-center justify-center gap-1.5 bg-brand-700 text-white rounded-xl py-2.5 font-semibold text-sm hover:bg-brand-600 transition shadow-card"><%- icon('plus', 'w-4 h-4') %> Add Rule</button>
    </form>
  </div>
</div>
<script>
  function toggleTargetType() {
    const isSection = document.querySelector('input[name="target_type"]:checked').value === 'section';
    document.getElementById('targetQuestionSelect').classList.toggle('hidden', isSection);
    document.getElementById('targetQuestionSelect').required = !isSection;
    document.getElementById('targetSectionSelect').classList.toggle('hidden', !isSection);
    document.getElementById('targetSectionSelect').required = isSection;
  }
</script>
<%- include('../partials/footer') %>
