{
  "expo": {
    "name": "INICIO Diary",
    "slug": "inicio-diary",
    "version": "2.0.1",
    "orientation": "portrait",
    "scheme": "inicio",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "com.inicio.inhome",
      "versionCode": 2000,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF2FA"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "INICIO uses your photo library when you choose a profile photo or diary evidence.",
          "cameraPermission": "INICIO uses your camera only when you choose to capture diary evidence."
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "INICIO uses your microphone only when you choose to record a voice note for a diary entry."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FAF9F7",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0A1628"
          },
          "imageWidth": 220
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "INICIO uses your camera to record diary evidence with on-screen prompts.",
          "microphonePermission": "INICIO records your spoken diary answers with your video.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "extra": {
      "apiUrl": "https://in-home-app-e8dkcnc7eefjgycv.francecentral-01.azurewebsites.net"
    }
  }
}
