# Copy to .env and fill in real values before any real pilot use.
# See PRODUCTION_READINESS.md and the Azure Deployment Runbook for what each
# of these means and exactly where to get it.

PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
# Local/dev: relative path is fine. On Azure App Service, point this at the
# persisted /home mount, e.g. DATABASE_PATH=/home/data/data.sqlite, so the
# database survives restarts/redeploys (see the Azure Deployment Runbook).
DATABASE_PATH=./data.sqlite

# --- Outbound SMS / WhatsApp (PRODUCTION_READINESS.md section B1) ---
# Carries diary links, diary reminders, and the one-time codes respondents use
# to sign in -- so until this is set, nobody can sign in to their account.
# Leave MESSAGING_PROVIDER unset to keep simulating into the Message Log screen.
MESSAGING_PROVIDER=mock
TWILIO_ACCOUNT_SID=
# An API key (SK...) is preferred over the account auth token: it can be revoked
# on its own without breaking other applications on the same Twilio account.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
# A Messaging Service (MG...) is preferred over a bare from-number -- the sender
# can then be changed in the Twilio console without redeploying.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Channel-specific senders allow SMS and WhatsApp to operate at the same time.
# They take precedence over the two legacy generic settings above.
TWILIO_SMS_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM_NUMBER=
# Meta-approved WhatsApp authentication template (Twilio Content Template
# Builder, content type "whatsapp/authentication") used for OTP codes sent
# cold, outside the 24h freeform window. Without this, WhatsApp OTP sends
# fail with Twilio error 63016 once there is no open conversation.
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# Meta-approved utility templates for business-initiated WhatsApp messages.
# Each template uses {{1}} respondent name, {{2}} study name and {{3}} the
# personal browser/WhatsApp handoff link. The app refuses a cold WhatsApp send
# when its matching SID is absent rather than recording a misleading success.
TWILIO_WHATSAPP_SURVEY_INVITE_CONTENT_SID=
TWILIO_WHATSAPP_DIARY_INVITE_CONTENT_SID=
TWILIO_WHATSAPP_DIARY_DUE_CONTENT_SID=
TWILIO_WHATSAPP_DIARY_MISSED_CONTENT_SID=
# List Picker Content SIDs for single-select diary questions, one per option
# count 2-10 (Meta's cap). Generate with:
#   node scripts/setupWhatsappListPickerTemplates.js
# These never need Meta approval -- they only work as a reply inside a
# conversation the respondent already opened.
TWILIO_WHATSAPP_LIST_PICKER_SIDS=
# Optional native WhatsApp Flow form for supported structured diary questions.
# Use one default Content SID or a JSON map keyed by "studyId:version",
# studyId, or "default". Publish a new immutable Flow asset for each published
# questionnaire version. Media and unsupported questions continue in chat.
TWILIO_WHATSAPP_FLOW_CONTENT_SID=
TWILIO_WHATSAPP_FLOW_CONTENT_SIDS=
# Dedicated signing key for short-lived Flow tokens. Falls back to
# SESSION_SECRET, but a separate long random value is preferred.
WHATSAPP_FLOW_TOKEN_SECRET=
WHATSAPP_FLOW_TOKEN_TTL_SECONDS=259200
# sms (works immediately) or whatsapp (needs an approved Meta sender + templates)
TWILIO_CHANNEL=sms
# Required for invitation links that open the WhatsApp bot and for verified
# inbound diary/media webhooks. Use the approved sender in E.164 format.
WHATSAPP_BOT_NUMBER=
VERIFY_TWILIO_WEBHOOKS=true
# Maximum bytes accepted for one inbound WhatsApp attachment (default 16 MB).
WHATSAPP_MEDIA_MAX_BYTES=16777216

# --- AI: OpenAI (PRODUCTION_READINESS.md sections B9/B10) ---
# One OpenAI API key powers every AI feature. Azure OpenAI, Azure AI Speech
# and Azure AI Vision were retired; old azure_* provider values below are
# read as openai.
OPENAI_API_KEY=
# Text and image work: summaries, themes, answer scoring, brand detection
# (photos and video frames) and video-mode pre-fill.
OPENAI_MODEL=gpt-5.4-mini
# Speech-to-text. gpt-5.4-mini takes text and images only (no audio), so
# transcription uses OpenAI's dedicated transcription model.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional ISO-639-1 language hint for transcription (e.g. en). Blank = auto-detect.
OPENAI_TRANSCRIBE_LANGUAGE=

# Each feature is switched on its own flag: openai, gemini(_vision/_speech)
# or mock. mock keeps results honestly "unavailable" (wiring only).
#
# Brand detection: the model reads the brand on the pack (or named in a voice
# note) -- open-vocabulary, so market-specific brands work; the study's own
# brand list is only a naming hint. Reads below this confidence go to review.
BRAND_DETECTION_PROVIDER=openai
BRAND_LOGO_MIN_CONFIDENCE=0.70
# Video mode: frames + transcript are matched to each multiple-choice
# question's own options; numbers and free text are never guessed.
VIDEO_FIELD_EXTRACTION_PROVIDER=openai
# Transcription everywhere: the end-of-diary Voice Note, standard-mode
# audio/video answers and WhatsApp voice notes.
AUDIO_TRANSCRIPTION_PROVIDER=openai

# Optional alternative: Gemini (BRAND_DETECTION_PROVIDER=gemini_vision,
# AUDIO_TRANSCRIPTION_PROVIDER=gemini_speech, AI_SUMMARY_PROVIDER=gemini,
# TRANSCRIPT_SCORING_PROVIDER=gemini). Video research summaries always use
# Gemini. Get a key at aistudio.google.com/apikey; GEMINI_MODEL defaults to
# gemini-3.5-flash-lite (lib/geminiClient.js).
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Media storage (PRODUCTION_READINESS.md section B4 / the Azure Deployment Runbook) ---
# local (default) keeps using the app's own disk -- fine for this sandbox,
# NOT durable on Azure App Service. Set STORAGE_PROVIDER=azure_blob for real
# hosting: media is pushed to a PRIVATE Blob container and only ever served
# via short-lived signed URLs (never a permanent public link).
STORAGE_PROVIDER=local
# UPLOAD_DIR only matters in local mode -- optionally point it at a durable
# path (e.g. Azure App Service's /home mount) instead of using Blob storage.
UPLOAD_DIR=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=media
# Needed (in addition to the connection string) to sign the short-lived read
# URLs used to actually display media -- the storage account's name + a key.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# --- Diary reminder push notifications (PRODUCTION_READINESS.md section B11) ---
# Unlike the AI integrations above, this needs NO external account -- it's
# a VAPID key pair the app generates itself (standard Web Push auth). Generate
# once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# and set the same three values in Azure App Service -> Configuration so the
# deployed app can send real notifications. Leave blank to keep the feature
# harmlessly disabled (no "Enable reminders" card is shown to respondents).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@inicio.app

# --- Reminder engine auto-run (PRODUCTION_READINESS.md section B8) ---
# The reminder engine now runs automatically on this interval, in addition to
# the manual "Run Reminder Engine" button. Set to "false" to disable auto-run.
REMINDER_ENGINE_INTERVAL_MINUTES=15
REMINDER_ENGINE_AUTORUN=true
# Staff and client credential email, plus respondent OTP/invite/reminder email (Resend)
RESEND_API_KEY=
# Preferred format: INICIO Diary <notifications@your-verified-domain.example>
RESEND_FROM=
# Backwards-compatible split sender variables; leave blank when RESEND_FROM is set.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=INICIO Diary
# Optional alias for RESEND_FROM_EMAIL.
SENDER_EMAIL=
APP_BASE_URL=http://localhost:3000

# Written study/video summaries: openai (default) or gemini. Uses
# OPENAI_API_KEY above; OPENAI_SUMMARY_MODEL overrides OPENAI_MODEL for
# summaries only.
AI_SUMMARY_PROVIDER=openai
OPENAI_SUMMARY_MODEL=
# Standard-mode audio/video transcripts are scored (relevance, completeness,
# specificity, clarity) against their question by lib/transcriptScoring.js:
# openai (default) or gemini. When unconfigured, the app shows an honest
# "AI score unavailable" state.
TRANSCRIPT_SCORING_PROVIDER=openai
