# Copy to .env and fill in real values before any real pilot use.
# See PRODUCTION_READINESS.md and the Azure Deployment Runbook for what each
# of these means and exactly where to get it.

PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
# Local/dev: relative path is fine. On Azure App Service, point this at the
# persisted /home mount, e.g. DATABASE_PATH=/home/data/data.sqlite, so the
# database survives restarts/redeploys (see the Azure Deployment Runbook).
DATABASE_PATH=./data.sqlite

# --- Outbound SMS / WhatsApp (PRODUCTION_READINESS.md section B1) ---
# Carries diary links, diary reminders, and the one-time codes respondents use
# to sign in -- so until this is set, nobody can sign in to their account.
# Leave MESSAGING_PROVIDER unset to keep simulating into the Message Log screen.
MESSAGING_PROVIDER=mock
TWILIO_ACCOUNT_SID=
# An API key (SK...) is preferred over the account auth token: it can be revoked
# on its own without breaking other applications on the same Twilio account.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
# A Messaging Service (MG...) is preferred over a bare from-number -- the sender
# can then be changed in the Twilio console without redeploying.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Channel-specific senders allow SMS and WhatsApp to operate at the same time.
# They take precedence over the two legacy generic settings above.
TWILIO_SMS_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM_NUMBER=
# sms (works immediately) or whatsapp (needs an approved Meta sender + templates)
TWILIO_CHANNEL=sms
# Required for invitation links that open the WhatsApp bot and for verified
# inbound diary/media webhooks. Use the approved sender in E.164 format.
WHATSAPP_BOT_NUMBER=
VERIFY_TWILIO_WEBHOOKS=true
# Maximum bytes accepted for one inbound WhatsApp attachment (default 16 MB).
WHATSAPP_MEDIA_MAX_BYTES=16777216

# --- Brand detection + video-mode field pre-fill (PRODUCTION_READINESS.md section B9) ---
# Leave both provider vars as mock to keep results "unavailable" (wiring only).
# Both features share the same Azure AI Vision resource.
BRAND_DETECTION_PROVIDER=mock
VIDEO_FIELD_EXTRACTION_PROVIDER=mock
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
# A dedicated Azure logo result is auto-accepted only above this confidence,
# and only when it leads a competing configured brand by this margin.
BRAND_LOGO_MIN_CONFIDENCE=0.70
BRAND_LOGO_MIN_MARGIN=0.10

# --- Voice-note transcription (PRODUCTION_READINESS.md section B10) ---
# Leave AUDIO_TRANSCRIPTION_PROVIDER=mock to keep transcripts "unavailable".
AUDIO_TRANSCRIPTION_PROVIDER=mock
AZURE_SPEECH_KEY=
# Prefer the exact endpoint shown on the resource's "Keys and Endpoint" page;
# AZURE_SPEECH_REGION is a fallback used only if AZURE_SPEECH_ENDPOINT is blank.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LOCALE=en-US

# --- Media storage (PRODUCTION_READINESS.md section B4 / the Azure Deployment Runbook) ---
# local (default) keeps using the app's own disk -- fine for this sandbox,
# NOT durable on Azure App Service. Set STORAGE_PROVIDER=azure_blob for real
# hosting: media is pushed to a PRIVATE Blob container and only ever served
# via short-lived signed URLs (never a permanent public link).
STORAGE_PROVIDER=local
# UPLOAD_DIR only matters in local mode -- optionally point it at a durable
# path (e.g. Azure App Service's /home mount) instead of using Blob storage.
UPLOAD_DIR=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=media
# Needed (in addition to the connection string) to sign the short-lived read
# URLs used to actually display media -- the storage account's name + a key.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# --- Diary reminder push notifications (PRODUCTION_READINESS.md section B11) ---
# Unlike the Azure integrations above, this needs NO external account -- it's
# a VAPID key pair the app generates itself (standard Web Push auth). Generate
# once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# and set the same three values in Azure App Service -> Configuration so the
# deployed app can send real notifications. Leave blank to keep the feature
# harmlessly disabled (no "Enable reminders" card is shown to respondents).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@inicio.app

# --- Reminder engine auto-run (PRODUCTION_READINESS.md section B8) ---
# The reminder engine now runs automatically on this interval, in addition to
# the manual "Run Reminder Engine" button. Set to "false" to disable auto-run.
REMINDER_ENGINE_INTERVAL_MINUTES=15
REMINDER_ENGINE_AUTORUN=true
# Staff and client credential email, plus respondent OTP/invite/reminder email (Resend)
RESEND_API_KEY=
# Preferred format: INICIO Diary <notifications@your-verified-domain.example>
RESEND_FROM=
# Backwards-compatible split sender variables; leave blank when RESEND_FROM is set.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=INICIO Diary
# Optional alias for RESEND_FROM_EMAIL.
SENDER_EMAIL=
APP_BASE_URL=http://localhost:3000

# Azure OpenAI study summaries
AI_SUMMARY_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Standard-mode audio/video transcripts use the same Azure OpenAI deployment
# to score how completely and clearly the spoken response answers its question.
# When these values are blank, the app shows an honest "AI score unavailable" state.
